@rendermode InteractiveServer
@using WebBanHang.Services
@using Microsoft.JSInterop
@using Microsoft.AspNetCore.Components.Authorization
@inject LayoutStateService LayoutState
@inject IJSRuntime JS
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation

<header class="app-topbar px-3 d-flex align-items-center justify-content-between flex-shrink-0">
    <!-- LEFT: SIDEBAR TOGGLE + BRAND + REPORTING PERIOD -->
    <div class="d-flex align-items-center gap-2 flex-shrink-0">
        <!-- Sidebar Toggle Button (Desktop: Ghim/Bỏ ghim, Mobile: Bật drawer) -->
        <button class="app-waffle-btn" 
                id="appSidebarToggleBtn"
                title="Ghim / Mở rộng thanh điều hướng (Ctrl+B)" 
                @onclick="ToggleSidebar">
            <i class="bi bi-list fs-5"></i>
        </button>

        <!-- Brand Logo & Name -->
        <a href="@(IsPortalRoute ? "/portal/dashboard" : "/dashboard")" class="d-flex align-items-center gap-2 text-decoration-none flex-shrink-0 ms-1">
            <img src="/images/brand-logo.svg" alt="B2B Logo" class="brand-logo-img" />
            <span class="brand-text fw-bold">HUEGO B2B</span>
        </a>

        @if (!IsPortalRoute)
        {
            <span class="app-header-divider d-none d-xl-inline ms-1"></span>

            <!-- Functional Reporting Period Selector (Replaces static 2024 badge) -->
            <div class="d-none d-xl-flex align-items-center gap-1.5 bg-light rounded-pill px-2.5 py-1 border small text-nowrap flex-shrink-0">
                <i class="bi bi-calendar3 text-success"></i>
                <span class="text-muted fw-semibold" style="font-size: 14px;">Kỳ:</span>
                <select class="form-select form-select-sm border-0 bg-transparent py-0 ps-1 pe-3 text-slate-navy fw-bold" 
                        style="font-size: 14px; cursor: pointer; width: auto;"
                        value="@LayoutState.SelectedPeriod"
                        @onchange="OnPeriodChanged">
                    <option value="this_month">Tháng này (@DateTime.Now.ToString("MM/yyyy"))</option>
                    <option value="this_quarter">Quý này (Q@(((DateTime.Now.Month - 1) / 3) + 1)/@DateTime.Now.Year)</option>
                    <option value="this_year">Năm nay (@DateTime.Now.Year)</option>
                </select>
            </div>
        }
    </div>

    <!-- CENTER: GLOBAL REAL-TIME SEARCH BOX -->
    <div class="d-none d-lg-block mx-2">
        <GlobalSearchBox />
    </div>

    <!-- RIGHT: FUNCTIONAL TOOLBAR & USER PROFILE -->
    <div class="d-flex align-items-center gap-1.5 gap-md-2">
        <!-- 1. QUICK ADD (+) MENU -->
        <QuickAddMenu />

        <!-- 2. HỘP THƯ CÔNG NỢ & PHÊ DUYỆT (💬) -->
        <DebtInboxMenu OnOpenAva="ToggleAvaPanel" />

        <!-- 3. REAL-TIME SQL NOTIFICATION BELL -->
        <NotificationBell />

        <!-- 4. HELP (?) BUTTON -->
        <button class="app-tool-btn" 
                title="Cẩm nang quy tắc nghiệp vụ (❓)"
                @onclick="ToggleHelpModal">
            <i class="bi bi-question-circle fs-6"></i>
        </button>

        <!-- 5. SETTINGS & THEME TOGGLE -->
        <SettingsMenu />

        <span class="app-header-divider d-none d-sm-inline"></span>

        <!-- 6. USER PROFILE & LOGOUT -->
        <UserMenu />
    </div>
</header>

<!-- AVA AI CHAT & SMART REMINDERS SLIDE-OUT PANEL -->
<AvaChatPanel IsOpen="@isAvaOpen" 
              OnClose="() => isAvaOpen = false" 
              OnUnreadCountChanged="count => avaBadgeCount = count" />

<!-- HELP MODAL -->
@if (isHelpOpen)
{
    <HelpModal OnClose="() => isHelpOpen = false" />
}

@code {
    private bool isAvaOpen = false;
    private bool isHelpOpen = false;
    private int avaBadgeCount = 3;
    private bool isCustomer = false;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        isCustomer = authState.User.IsInRole("Customer");
        Navigation.LocationChanged += (_, __) => StateHasChanged();
    }

    private bool IsPortalRoute => isCustomer || (Navigation.Uri?.Contains("/portal") ?? false);

    private void OnPeriodChanged(ChangeEventArgs e)
    {
        var period = e.Value?.ToString() ?? "this_month";
        LayoutState.SetSelectedPeriod(period);
    }

    private async Task ToggleSidebar()
    {
        try
        {
            await JS.InvokeVoidAsync("window.appSidebar.toggleFromTopbar");
        }
        catch { }
    }

    private void ToggleAvaPanel() => isAvaOpen = !isAvaOpen;
    private void ToggleHelpModal() => isHelpOpen = !isHelpOpen;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                await JS.InvokeVoidAsync("window.appSidebar.syncState");
            }
            catch { }
        }
    }
}
