@inject LayoutStateService LayoutState
@inject NavigationManager Navigation
@implements IDisposable

<div class="misa-sidebar-wrapper d-flex flex-column h-100 @(LayoutState.IsSidebarCollapsed ? "is-collapsed" : "")">
    
    <!-- 1. TOP QUICK ACTION BUTTON ("+ THÊM NHANH") -->
    <div class="p-2 pt-2.5 pb-1 flex-shrink-0">
        @if (LayoutState.IsSidebarCollapsed)
        {
            <button class="btn btn-misa-quick-mini w-100 d-flex align-items-center justify-content-center" 
                    title="+ Thêm nhanh chứng từ / nghiệp vụ" 
                    @onclick="LayoutState.ToggleQuickAdd">
                <i class="bi bi-plus-lg text-success fs-5"></i>
            </button>
        }
        else
        {
            <button class="btn btn-misa-quick-full w-100 d-flex align-items-center justify-content-center gap-2" 
                    @onclick="LayoutState.ToggleQuickAdd">
                <i class="bi bi-plus-lg text-success fw-bold"></i>
                <span class="fw-semibold">Thêm nhanh</span>
            </button>
        }
    </div>

    <!-- 2. SECTION: HAY DÙNG (PINNED FAVORITES) - Only visible when expanded -->
    @if (!LayoutState.IsSidebarCollapsed)
    {
        <div class="px-2.5 py-1.5 flex-shrink-0">
            <div class="d-flex align-items-center justify-content-between text-uppercase small text-muted-misa fw-bold mb-1.5" style="font-size: 0.68rem; letter-spacing: 0.5px;">
                <span>HAY DÙNG</span>
                <i class="bi bi-chevron-up opacity-75" style="font-size: 0.75rem;"></i>
            </div>
            
            <div class="misa-pinned-box mb-1.5" @onclick="LayoutState.ToggleQuickAdd" title="Bấm để truy cập nhanh các tính năng">
                <span class="text-info-blue">Ghim các tính năng hay dùng tại đây</span>
            </div>

            <button class="btn btn-misa-favorite-page w-100 text-center py-1 small" @onclick="MarkCurrentPageFavorite">
                Hay dùng trang này
            </button>
        </div>
    }

    <!-- 3. SECTION: PHÂN HỆ (MODULES MENU) -->
    <div class="misa-nav-scrollable flex-grow-1 px-1.5 py-1">
        @if (!LayoutState.IsSidebarCollapsed)
        {
            <div class="text-uppercase small text-muted-misa fw-bold px-2 py-1" style="font-size: 0.68rem; letter-spacing: 0.5px;">
                PHÂN HỆ
            </div>
        }

        <nav class="d-flex flex-column gap-0.5">
            <!-- 3.1 AVA Kế toán AI -->
            <div class="nav-item">
                <a class="nav-link misa-link" href="javascript:void(0)" @onclick="LayoutState.ToggleQuickAdd" title="Trợ lý AVA Kế toán AI">
                    <div class="misa-avatar-wrapper flex-shrink-0">
                        <img src="/images/ava-avatar.svg" alt="AVA AI" class="misa-ava-icon" />
                    </div>
                    @if (!LayoutState.IsSidebarCollapsed)
                    {
                        <span class="misa-link-text d-flex align-items-center justify-content-between flex-grow-1">
                            <span>AVA Kế toán</span>
                            <span class="badge bg-purple-ai text-white rounded-pill px-1.5 py-0.5" style="font-size: 0.62rem;">AI</span>
                        </span>
                    }
                </a>
            </div>

            <!-- 3.2 Tổng quan (Dashboard) -->
            <div class="nav-item">
                <NavLink class="nav-link misa-link active-green" href="" Match="NavLinkMatch.All" title="Tổng quan">
                    <i class="bi bi-grid-fill misa-nav-icon"></i>
                    @if (!LayoutState.IsSidebarCollapsed)
                    {
                        <span class="misa-link-text">Tổng quan</span>
                    }
                </NavLink>
            </div>

            <!-- 3.3 Tiền mặt (Phiếu thu / Chi) -->
            <div class="nav-item">
                <NavLink class="nav-link misa-link" href="payments" title="Tiền mặt">
                    <i class="bi bi-cash-stack misa-nav-icon"></i>
                    @if (!LayoutState.IsSidebarCollapsed)
                    {
                        <span class="misa-link-text">Tiền mặt</span>
                    }
                </NavLink>
            </div>

            <!-- 3.4 Tiền gửi (Ngân hàng / VietQR) -->
            <div class="nav-item">
                <NavLink class="nav-link misa-link" href="portal/invoices" title="Tiền gửi & VietQR">
                    <i class="bi bi-bank misa-nav-icon"></i>
                    @if (!LayoutState.IsSidebarCollapsed)
                    {
                        <span class="misa-link-text">Tiền gửi</span>
                    }
                </NavLink>
            </div>

            <!-- 3.5 Mua hàng (Đặt hàng B2B) -->
            <div class="nav-item">
                <NavLink class="nav-link misa-link" href="portal/store" title="Mua hàng">
                    <i class="bi bi-bag-check misa-nav-icon"></i>
                    @if (!LayoutState.IsSidebarCollapsed)
                    {
                        <span class="misa-link-text">Mua hàng</span>
                    }
                </NavLink>
            </div>

            <!-- 3.6 Bán hàng (Lập hóa đơn bán buôn) -->
            <div class="nav-item">
                <NavLink class="nav-link misa-link" href="create-invoice" title="Bán hàng">
                    <i class="bi bi-cart3 misa-nav-icon"></i>
                    @if (!LayoutState.IsSidebarCollapsed)
                    {
                        <span class="misa-link-text">Bán hàng</span>
                    }
                </NavLink>
            </div>

            <!-- 3.7 Quản lý hóa đơn -->
            <div class="nav-item">
                <NavLink class="nav-link misa-link" href="invoices" title="Quản lý hóa đơn">
                    <i class="bi bi-receipt-cutoff misa-nav-icon"></i>
                    @if (!LayoutState.IsSidebarCollapsed)
                    {
                        <span class="misa-link-text">Quản lý hóa đơn</span>
                    }
                </NavLink>
            </div>

            <!-- 3.8 Kho (Sản phẩm & Tồn kho) -->
            <div class="nav-item">
                <NavLink class="nav-link misa-link" href="manage-products" title="Kho">
                    <i class="bi bi-box-seam misa-nav-icon"></i>
                    @if (!LayoutState.IsSidebarCollapsed)
                    {
                        <span class="misa-link-text">Kho</span>
                    }
                </NavLink>
            </div>

            <!-- 3.9 Công cụ dụng cụ & Hạn mức rủi ro -->
            <div class="nav-item">
                <NavLink class="nav-link misa-link" href="manage-customers" title="Công cụ dụng cụ / Khách hàng">
                    <i class="bi bi-tools misa-nav-icon"></i>
                    @if (!LayoutState.IsSidebarCollapsed)
                    {
                        <span class="misa-link-text">Công cụ dụng cụ</span>
                    }
                </NavLink>
            </div>

            <!-- 3.10 Thuế -->
            <div class="nav-item">
                <NavLink class="nav-link misa-link" href="aging-report" title="Thuế & Quyết toán">
                    <i class="bi bi-percent misa-nav-icon"></i>
                    @if (!LayoutState.IsSidebarCollapsed)
                    {
                        <span class="misa-link-text">Thuế</span>
                    }
                </NavLink>
            </div>

            <!-- 3.11 Cộng đồng MISA -->
            <div class="nav-item">
                <a class="nav-link misa-link" href="https://forum.misa.vn" target="_blank" title="Cộng đồng MISA">
                    <i class="bi bi-asterisk misa-nav-icon"></i>
                    @if (!LayoutState.IsSidebarCollapsed)
                    {
                        <span class="misa-link-text">Cộng đồng MISA</span>
                    }
                </a>
            </div>

            <!-- 3.12 Tổng hợp (Sổ cái / Sổ chi tiết) -->
            <div class="nav-item">
                <NavLink class="nav-link misa-link" href="customer-ledger" title="Tổng hợp">
                    <i class="bi bi-journal-bookmark-fill misa-nav-icon"></i>
                    @if (!LayoutState.IsSidebarCollapsed)
                    {
                        <span class="misa-link-text">Tổng hợp</span>
                    }
                </NavLink>
            </div>

            <!-- 3.13 Báo cáo (Báo cáo tuổi nợ 4 xô / Doanh số) -->
            <div class="nav-item">
                <NavLink class="nav-link misa-link" href="aging-report" title="Báo cáo">
                    <i class="bi bi-bar-chart-line-fill misa-nav-icon"></i>
                    @if (!LayoutState.IsSidebarCollapsed)
                    {
                        <span class="misa-link-text">Báo cáo</span>
                    }
                </NavLink>
            </div>

            <!-- 3.14 Phân tích tài chính -->
            <div class="nav-item">
                <NavLink class="nav-link misa-link" href="aging-report" title="Phân tích tài chính">
                    <i class="bi bi-diagram-3 misa-nav-icon"></i>
                    @if (!LayoutState.IsSidebarCollapsed)
                    {
                        <span class="misa-link-text">Phân tích tài chính</span>
                    }
                </NavLink>
            </div>

            <!-- 3.15 Danh mục -->
            <div class="nav-item">
                <NavLink class="nav-link misa-link" href="manage-products" title="Danh mục">
                    <i class="bi bi-list-ul misa-nav-icon"></i>
                    @if (!LayoutState.IsSidebarCollapsed)
                    {
                        <span class="misa-link-text">Danh mục</span>
                    }
                </NavLink>
            </div>
        </nav>
    </div>

    <!-- 4. BOTTOM FOOTER: TOGGLE COLLAPSE / EXPAND BUTTON -->
    <div class="misa-sidebar-footer p-2 border-top border-secondary border-opacity-20 d-flex align-items-center @(LayoutState.IsSidebarCollapsed ? "justify-content-center" : "justify-content-between") flex-shrink-0">
        @if (!LayoutState.IsSidebarCollapsed)
        {
            <div class="small text-muted-misa d-flex align-items-center gap-1.5" style="font-size: 0.7rem;">
                <span class="misa-version-badge">AMIS v2024.1</span>
            </div>
        }
        
        <button class="btn btn-misa-collapse-toggle d-flex align-items-center justify-content-center" 
                @onclick="LayoutState.ToggleSidebar" 
                title="@(LayoutState.IsSidebarCollapsed ? "Mở rộng thanh điều hướng" : "Thu gọn thanh điều hướng")">
            <i class="bi @(LayoutState.IsSidebarCollapsed ? "bi-chevron-bar-right" : "bi-chevron-bar-left") fs-6"></i>
        </button>
    </div>

</div>

@code {
    protected override void OnInitialized()
    {
        LayoutState.OnChange += StateHasChanged;
    }

    private void MarkCurrentPageFavorite()
    {
        // Feedback toast or action
    }

    public void Dispose()
    {
        LayoutState.OnChange -= StateHasChanged;
    }
}
