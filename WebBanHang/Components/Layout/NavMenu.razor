@using Microsoft.AspNetCore.Components.Authorization
@inject LayoutStateService LayoutState
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider
@implements IDisposable

<div class="misa-sidebar-wrapper d-flex flex-column h-100 @(LayoutState.IsSidebarCollapsed ? "is-collapsed" : "is-expanded")">
    
    <!-- 1. TOP QUICK ACTION BUTTON ("+ THÊM NHANH") -->
    <div class="p-2 pt-2.5 pb-1 flex-shrink-0 text-center">
        @if (LayoutState.IsSidebarCollapsed)
        {
            <button class="btn btn-misa-quick-mini" 
                    title="+ Thêm nhanh chứng từ" 
                    @onclick="LayoutState.ToggleQuickAdd">
                <i class="bi bi-plus-lg text-success"></i>
            </button>
        }
        else
        {
            <button class="btn btn-misa-quick-full d-flex align-items-center justify-content-center gap-2" 
                    @onclick="LayoutState.ToggleQuickAdd">
                <i class="bi bi-plus-lg text-success fw-bold"></i>
                <span class="fw-semibold">Thêm nhanh</span>
            </button>
        }
    </div>

    <!-- 2. SECTION: PHÂN HỆ NGHIỆP VỤ (LỌC CHÍNH XÁC THEO VAI TRÒ) -->
    <div class="misa-nav-scrollable flex-grow-1 px-1 py-1">
        @if (!LayoutState.IsSidebarCollapsed)
        {
            <div class="text-uppercase small text-muted-misa fw-bold px-2 py-1" style="font-size: 0.68rem; letter-spacing: 0.5px;">
                @(isCustomer ? "CỔNG ĐẠI LÝ B2B" : isAccountant ? "PHÂN HỆ KẾ TOÁN & CÔNG NỢ" : "PHÂN HỆ BÁN HÀNG")
            </div>
        }

        <nav class="d-flex flex-column gap-0.5">
            @if (isCustomer)
            {
                <!-- ================= 1. CỔNG ĐẠI LÝ B2B ================= -->
                <div class="nav-item">
                    <NavLink class="nav-link misa-link active-green" href="portal/dashboard" Match="NavLinkMatch.All" title="Tổng quan đại lý">
                        <i class="bi bi-grid-fill misa-nav-icon"></i>
                        @if (!LayoutState.IsSidebarCollapsed)
                        {
                            <span class="misa-link-text">Tổng quan đại lý</span>
                        }
                    </NavLink>
                </div>

                <div class="nav-item">
                    <NavLink class="nav-link misa-link" href="portal/store" title="Đặt hàng sỉ trực tuyến">
                        <i class="bi bi-cart3 misa-nav-icon"></i>
                        @if (!LayoutState.IsSidebarCollapsed)
                        {
                            <span class="misa-link-text">Mua hàng sỉ B2B</span>
                        }
                    </NavLink>
                </div>

                <div class="nav-item">
                    <NavLink class="nav-link misa-link" href="portal/invoices" title="Hóa đơn & VietQR">
                        <i class="bi bi-receipt misa-nav-icon"></i>
                        @if (!LayoutState.IsSidebarCollapsed)
                        {
                            <span class="misa-link-text">Hóa đơn & VietQR</span>
                        }
                    </NavLink>
                </div>

                <div class="nav-item">
                    <NavLink class="nav-link misa-link" href="portal/ledger" title="Sổ đối soát công nợ">
                        <i class="bi bi-journal-text misa-nav-icon"></i>
                        @if (!LayoutState.IsSidebarCollapsed)
                        {
                            <span class="misa-link-text">Sổ đối soát nợ</span>
                        }
                    </NavLink>
                </div>
            }
            else if (isAccountant)
            {
                <!-- ================= 2. QUẢN TRỊ VIÊN / KẾ TOÁN ================= -->
                <!-- Tổng quan -->
                <div class="nav-item">
                    <NavLink class="nav-link misa-link active-green" href="dashboard" Match="NavLinkMatch.All" title="Tổng quan tài chính">
                        <i class="bi bi-grid-fill misa-nav-icon"></i>
                        @if (!LayoutState.IsSidebarCollapsed)
                        {
                            <span class="misa-link-text">Tổng quan</span>
                        }
                    </NavLink>
                </div>

                <!-- Thu tiền cấn trừ FIFO (Luật 2) -->
                <div class="nav-item">
                    <NavLink class="nav-link misa-link" href="payments" title="Thu tiền cấn trừ (FIFO)">
                        <i class="bi bi-cash-stack misa-nav-icon text-success"></i>
                        @if (!LayoutState.IsSidebarCollapsed)
                        {
                            <span class="misa-link-text">Thu tiền (FIFO)</span>
                        }
                    </NavLink>
                </div>

                <!-- Báo cáo tuổi nợ 4 xô -->
                <div class="nav-item">
                    <NavLink class="nav-link misa-link" href="aging-report" title="Báo cáo tuổi nợ 4 xô">
                        <i class="bi bi-bar-chart-line-fill misa-nav-icon text-warning"></i>
                        @if (!LayoutState.IsSidebarCollapsed)
                        {
                            <span class="misa-link-text">Báo cáo tuổi nợ 4 xô</span>
                        }
                    </NavLink>
                </div>

                <!-- Sổ chi tiết công nợ -->
                <div class="nav-item">
                    <NavLink class="nav-link misa-link" href="customer-ledger" title="Sổ chi tiết công nợ khách hàng">
                        <i class="bi bi-journal-bookmark-fill misa-nav-icon text-info"></i>
                        @if (!LayoutState.IsSidebarCollapsed)
                        {
                            <span class="misa-link-text">Sổ đối soát công nợ</span>
                        }
                    </NavLink>
                </div>

                <!-- Khách hàng & Hạn mức tín dụng AI -->
                <div class="nav-item">
                    <NavLink class="nav-link misa-link" href="manage-customers" title="Khách hàng & Hạn mức tín dụng">
                        <i class="bi bi-shield-check misa-nav-icon"></i>
                        @if (!LayoutState.IsSidebarCollapsed)
                        {
                            <span class="misa-link-text">Khách hàng & Hạn mức</span>
                        }
                    </NavLink>
                </div>

                <!-- Lập hóa đơn bán buôn (Luật 1) -->
                <div class="nav-item">
                    <NavLink class="nav-link misa-link" href="create-invoice" title="Lập hóa đơn bán buôn">
                        <i class="bi bi-cart-plus-fill misa-nav-icon"></i>
                        @if (!LayoutState.IsSidebarCollapsed)
                        {
                            <span class="misa-link-text">Lập hóa đơn sỉ</span>
                        }
                    </NavLink>
                </div>

                <!-- Quản lý hóa đơn -->
                <div class="nav-item">
                    <NavLink class="nav-link misa-link" href="invoices" title="Quản lý hóa đơn & VietQR">
                        <i class="bi bi-receipt misa-nav-icon"></i>
                        @if (!LayoutState.IsSidebarCollapsed)
                        {
                            <span class="misa-link-text">Quản lý hóa đơn</span>
                        }
                    </NavLink>
                </div>

                <!-- Kho & Danh mục sản phẩm -->
                <div class="nav-item">
                    <NavLink class="nav-link misa-link" href="manage-products" title="Kho & Danh mục sản phẩm">
                        <i class="bi bi-box-seam misa-nav-icon"></i>
                        @if (!LayoutState.IsSidebarCollapsed)
                        {
                            <span class="misa-link-text">Kho & Giá vốn</span>
                        }
                    </NavLink>
                </div>

                <!-- Lịch sử phiếu thu -->
                <div class="nav-item">
                    <NavLink class="nav-link misa-link" href="payment-history" title="Lịch sử phiếu thu & ngân hàng">
                        <i class="bi bi-bank misa-nav-icon"></i>
                        @if (!LayoutState.IsSidebarCollapsed)
                        {
                            <span class="misa-link-text">Lịch sử phiếu thu</span>
                        }
                    </NavLink>
                </div>
            }
            else // Sales
            {
                <!-- ================= 3. NHÂN VIÊN BÁN HÀNG (SALES) ================= -->
                <!-- Tổng quan -->
                <div class="nav-item">
                    <NavLink class="nav-link misa-link active-green" href="dashboard" Match="NavLinkMatch.All" title="Tổng quan bán hàng">
                        <i class="bi bi-grid-fill misa-nav-icon"></i>
                        @if (!LayoutState.IsSidebarCollapsed)
                        {
                            <span class="misa-link-text">Tổng quan</span>
                        }
                    </NavLink>
                </div>

                <!-- Lập hóa đơn bán buôn -->
                <div class="nav-item">
                    <NavLink class="nav-link misa-link" href="create-invoice" title="Lập hóa đơn bán buôn">
                        <i class="bi bi-cart-plus-fill misa-nav-icon"></i>
                        @if (!LayoutState.IsSidebarCollapsed)
                        {
                            <span class="misa-link-text">Bán hàng (Lập HĐ)</span>
                        }
                    </NavLink>
                </div>

                <!-- Danh sách hóa đơn -->
                <div class="nav-item">
                    <NavLink class="nav-link misa-link" href="invoices" title="Quản lý hóa đơn & VietQR">
                        <i class="bi bi-receipt misa-nav-icon"></i>
                        @if (!LayoutState.IsSidebarCollapsed)
                        {
                            <span class="misa-link-text">Quản lý hóa đơn</span>
                        }
                    </NavLink>
                </div>

                <!-- Kho hàng sỉ -->
                <div class="nav-item">
                    <NavLink class="nav-link misa-link" href="manage-products" title="Kho hàng sỉ & tồn kho">
                        <i class="bi bi-box-seam misa-nav-icon"></i>
                        @if (!LayoutState.IsSidebarCollapsed)
                        {
                            <span class="misa-link-text">Kho hàng sỉ</span>
                        }
                    </NavLink>
                </div>
            }
        </nav>
    </div>

    <!-- 3. BOTTOM FOOTER: TOGGLE COLLAPSE / EXPAND BUTTON -->
    <div class="misa-sidebar-footer p-2 border-top border-secondary border-opacity-20 d-flex align-items-center @(LayoutState.IsSidebarCollapsed ? "flex-column gap-2 justify-content-center" : "justify-content-between") flex-shrink-0">
        @if (!LayoutState.IsSidebarCollapsed)
        {
            <div class="small text-muted-misa d-flex align-items-center gap-1.5" style="font-size: 0.7rem;">
                <span class="misa-version-badge">Capstone 18</span>
            </div>
        }
        
        <button class="btn btn-misa-collapse-toggle d-flex align-items-center justify-content-center" 
                @onclick="LayoutState.ToggleSidebar" 
                title="@(LayoutState.IsSidebarCollapsed ? "Mở rộng menu" : "Thu gọn menu")">
            <i class="bi @(LayoutState.IsSidebarCollapsed ? "bi-chevron-bar-right" : "bi-chevron-bar-left") fs-6"></i>
        </button>
    </div>

</div>

@code {
    private bool isCustomer = false;
    private bool isAccountant = false;
    private bool isSales = false;

    protected override async Task OnInitializedAsync()
    {
        LayoutState.OnChange += StateHasChanged;

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        if (user.Identity?.IsAuthenticated == true)
        {
            isCustomer = user.IsInRole("Customer");
            isAccountant = user.IsInRole("Accountant");
            isSales = user.IsInRole("Sales") || (!isCustomer && !isAccountant);
        }
    }

    public void Dispose()
    {
        LayoutState.OnChange -= StateHasChanged;
    }
}
