@using WebBanHang.Services
@using WebBanHang.UseCases.AI
@using WebBanHang.UseCases.DTOs
@using Microsoft.AspNetCore.Components.Authorization
@inject LedgerConfirmationStateService LedgerState
@inject IGetSmartRemindersUseCase GetSmartRemindersUseCase
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider
@implements IDisposable

<div class="position-relative">
    <button class="app-tool-btn position-relative" 
            title="Hộp thư Công nợ & Phê duyệt (@(unreadCount > 0 ? $"{unreadCount} tin mới" : "Trực tuyến"))"
            @onclick="ToggleDropdown">
        <i class="bi bi-chat-dots-fill fs-6 text-primary"></i>
        @if (unreadCount > 0)
        {
            <span class="app-counter-badge bg-danger">
                @(unreadCount > 9 ? "9+" : unreadCount.ToString())
            </span>
        }
    </button>

    @if (isOpen)
    {
        <!-- BACKDROP -->
        <div class="position-fixed top-0 start-0 w-100 h-100" style="z-index: 1040; background: transparent;" @onclick="CloseDropdown"></div>

        <!-- POPOVER DROPDOWN -->
        <div class="position-absolute bg-white rounded-3 shadow-lg border mt-1 overflow-hidden" 
             style="top: 100%; right: -60px; width: 440px; max-width: 95vw; max-height: 540px; z-index: 1050; border-color: #cbd5e1 !important;"
             @onclick:stopPropagation="true">
            <!-- HEADER -->
            <div class="p-3 bg-light border-bottom d-flex align-items-center justify-content-between gap-2">
                <div class="d-flex align-items-center gap-2">
                    <div class="p-1.5 bg-primary bg-opacity-10 text-primary rounded-circle">
                        <i class="bi bi-chat-left-text-fill fs-5"></i>
                    </div>
                    <div>
                        <h6 class="fw-bold text-dark mb-0 text-nowrap" style="font-size: 15px;">Hộp Thư Công Nợ</h6>
                        <small class="text-muted text-nowrap" style="font-size: 12px;">
                            @(unreadCount > 0 ? $"{unreadCount} thông điệp cần xử lý" : "Hệ thống kết nối trực tuyến")
                        </small>
                    </div>
                </div>
                @if (unreadCount > 0)
                {
                    <button class="btn btn-sm btn-link text-decoration-none p-0 text-success fw-bold text-nowrap d-flex align-items-center gap-1" 
                            style="font-size: 12.5px;" 
                            @onclick="MarkAllRead">
                        <i class="bi bi-check2-all fs-6"></i>
                        <span>Đánh dấu đã đọc</span>
                    </button>
                }
            </div>

            <!-- TABS -->
            <div class="d-flex bg-white border-bottom px-2 pt-1 gap-1">
                <button type="button" 
                        class="btn btn-sm rounded-0 border-0 py-2 px-3 fw-bold small text-nowrap @(activeTab == 0 ? "text-primary border-bottom border-primary border-2" : "text-secondary")"
                        style="font-size: 13px;"
                        @onclick="() => activeTab = 0">
                    <i class="bi bi-inbox-fill me-1"></i> Phản Ánh & Đối Soát
                    @if (unreadCount > 0)
                    {
                        <span class="badge bg-danger rounded-pill ms-1" style="font-size: 10px;">@unreadCount</span>
                    }
                </button>
                <button type="button" 
                        class="btn btn-sm rounded-0 border-0 py-2 px-3 fw-bold small text-nowrap @(activeTab == 1 ? "text-primary border-bottom border-primary border-2" : "text-secondary")"
                        style="font-size: 13px;"
                        @onclick="() => activeTab = 1">
                    <i class="bi bi-stars text-warning me-1"></i> Cảnh Báo AVA AI
                    @if (activeSmartRemindersCount > 0)
                    {
                        <span class="badge bg-warning text-dark rounded-pill ms-1" style="font-size: 10px;">@activeSmartRemindersCount</span>
                    }
                </button>
            </div>

            <!-- TAB 0: KHIẾU NẠI & ĐỐI SOÁT THỰC TẾ -->
            @if (activeTab == 0)
            {
                <div style="max-height: 380px; overflow-y: auto;">
                    @if (messages == null || !messages.Any())
                    {
                        <div class="p-4 text-center">
                            <i class="bi bi-inbox fs-1 d-block mb-2 text-primary opacity-50"></i>
                            <div class="fw-bold text-dark mb-1" style="font-size: 14.5px;">Chưa có khiếu nại hoặc đối soát mới</div>
                            <p class="text-muted small mb-3" style="font-size: 12.5px; line-height: 1.45;">
                                Khi đại lý gửi phản ánh lệch số liệu hoặc xác nhận số dư từ Cổng Đại Lý (/portal/ledger), thông báo nghiệp vụ sẽ hiển thị trực tiếp tại đây.
                            </p>
                            <div class="d-flex flex-column gap-2">
                                <button type="button" class="btn btn-outline-primary btn-sm rounded-pill py-1.5" style="font-size: 12.5px;" @onclick="GoToCustomerLedger">
                                    <i class="bi bi-journal-text me-1"></i> Mở Sổ Đối Soát Các Đại Lý
                                </button>
                                <button type="button" class="btn btn-light btn-sm text-secondary border rounded-pill py-1.5" style="font-size: 12px;" @onclick="SimulateTestDispute">
                                    <i class="bi bi-lightning-charge text-warning me-1"></i> Mô phỏng phản ánh từ Tuấn Hương (Demo)
                                </button>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var m in messages)
                            {
                                <div class="list-group-item p-3 border-0 border-bottom text-start @(m.IsRead ? "bg-white opacity-75" : "bg-light bg-opacity-75")">
                                    <div class="d-flex align-items-center justify-content-between mb-1.5">
                                        @switch (m.Type)
                                        {
                                            case DebtMessageType.Dispute:
                                                <span class="badge bg-danger-subtle text-danger border border-danger-subtle small fw-bold">
                                                    <i class="bi bi-exclamation-triangle-fill me-1"></i>Khiếu nại số liệu
                                                </span>
                                                break;
                                            case DebtMessageType.LimitOverrideRequest:
                                                <span class="badge bg-warning-subtle text-dark border border-warning-subtle small fw-bold">
                                                    <i class="bi bi-arrow-up-right-circle-fill me-1"></i>Xin vượt hạn mức
                                                </span>
                                                break;
                                            case DebtMessageType.BalanceConfirmation:
                                                <span class="badge bg-success-subtle text-success border border-success-subtle small fw-bold">
                                                    <i class="bi bi-check-circle-fill me-1"></i>Đại lý đã chốt số dư
                                                </span>
                                                break;
                                            case DebtMessageType.DebtReminderSent:
                                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle small fw-bold">
                                                    <i class="bi bi-send-fill me-1"></i>Nhật ký AI Nhắc nợ
                                                </span>
                                                break;
                                        }
                                        <small class="text-muted" style="font-size: 11px;">@m.CreatedAt.ToString("HH:mm dd/MM")</small>
                                    </div>
                                    <div class="fw-bold text-dark mb-1" style="font-size: 13.5px;">@m.Title</div>
                                    <div class="text-muted text-break mb-2" style="font-size: 12.5px; line-height: 1.45;">
                                        @m.Content
                                    </div>
                                    <div class="d-flex align-items-center justify-content-between pt-1">
                                        <span class="small text-secondary fw-semibold" style="font-size: 12px;">@m.CustomerName</span>
                                        <button type="button" class="btn btn-outline-primary btn-sm rounded-pill py-0.5 px-3" style="font-size: 12px;"
                                                @onclick="() => NavigateTo(m)">
                                            Xem chi tiết <i class="bi bi-chevron-right ms-0.5"></i>
                                        </button>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
            <!-- TAB 1: CẢNH BÁO AVA AI TỪ CƠ SỞ DỮ LIỆU SQL -->
            else if (activeTab == 1)
            {
                <div style="max-height: 380px; overflow-y: auto;" class="p-2">
                    @if (smartReminders == null || !smartReminders.Any())
                    {
                        <div class="p-4 text-center text-muted small">
                            <i class="bi bi-shield-check fs-2 text-success d-block mb-1"></i>
                            Tuyệt vời! Không có cảnh báo nợ quá hạn hoặc rủi ro hạn mức nào.
                        </div>
                    }
                    else
                    {
                        <div class="d-flex flex-column gap-2 p-1">
                            @foreach (var rem in smartReminders.Where(r => !r.IsDismissed))
                            {
                                <div class="p-2.5 rounded-3 bg-white border shadow-xs">
                                    <div class="d-flex align-items-center justify-content-between mb-1">
                                        <span class="badge bg-@rem.PriorityBadge-subtle text-@rem.PriorityBadge border border-@rem.PriorityBadge-subtle small fw-bold">
                                            @rem.Priority
                                        </span>
                                        <small class="text-muted" style="font-size: 11px;">@rem.InvoiceNumber</small>
                                    </div>
                                    <div class="fw-bold text-dark small mb-1" style="font-size: 13px;">@rem.Title</div>
                                    <div class="text-muted small mb-2" style="font-size: 12px; line-height: 1.4;">@rem.Description</div>
                                    <div class="d-flex align-items-center justify-content-between">
                                        <span class="text-primary fw-bold small" style="font-size: 12px;">@rem.CustomerName</span>
                                        <button type="button" class="btn btn-outline-primary btn-sm rounded-pill py-0.5 px-2.5" style="font-size: 11.5px;"
                                                @onclick="() => HandleSmartReminderClick(rem)">
                                            Xử lý ngay <i class="bi bi-chevron-right ms-0.5"></i>
                                        </button>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    <div class="p-2 border-top mt-2">
                        <button type="button" class="btn btn-primary btn-sm rounded-pill w-100 py-1.5 fw-bold d-flex align-items-center justify-content-center gap-2"
                                style="font-size: 12.5px;"
                                @onclick="OpenAvaPanel">
                            <i class="bi bi-stars"></i> Mở Trợ Lý AI AVA & Chat Trực Tiếp
                        </button>
                    </div>
                </div>
            }

            <!-- FOOTER STATUS BAR -->
            <div class="p-2.5 bg-light border-top d-flex align-items-center justify-content-between">
                <span class="text-muted small" style="font-size: 11.5px;">
                    <i class="bi bi-shield-check text-success me-1"></i> Đồng bộ thời gian thực
                </span>
                <a href="/customer-ledger" class="text-decoration-none small text-primary fw-bold" style="font-size: 12px;" @onclick="CloseDropdown">
                    Sổ đối soát toàn bộ <i class="bi bi-chevron-right"></i>
                </a>
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public EventCallback OnOpenAva { get; set; }

    private bool isOpen = false;
    private int activeTab = 0;
    private List<DebtMessageItem>? messages;
    private List<SmartReminderDto>? smartReminders;
    private int unreadCount => LedgerState.GetUnreadMessageCount();
    private int activeSmartRemindersCount => smartReminders?.Count(r => !r.IsDismissed && (r.Priority == "Khẩn" || r.Priority == "Cần chú ý")) ?? 0;
    private string role = "Sales";
    private int? customerId = null;

    protected override async Task OnInitializedAsync()
    {
        messages = LedgerState.GetMessages();
        LedgerState.OnChange += OnStateChanged;

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        if (user.Identity?.IsAuthenticated == true)
        {
            role = user.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "Sales";
            if (int.TryParse(user.FindFirst("CustomerId")?.Value, out int cid))
            {
                customerId = cid;
            }
        }

        await LoadSmartReminders();
    }

    private async Task LoadSmartReminders()
    {
        try
        {
            var list = await GetSmartRemindersUseCase.ExecuteAsync(role, customerId);
            smartReminders = list.ToList();
        }
        catch
        {
            smartReminders = new List<SmartReminderDto>();
        }
    }

    private void OnStateChanged()
    {
        messages = LedgerState.GetMessages();
        InvokeAsync(StateHasChanged);
    }

    private void ToggleDropdown()
    {
        isOpen = !isOpen;
        if (isOpen)
        {
            messages = LedgerState.GetMessages();
            _ = LoadSmartReminders();
        }
    }

    private void CloseDropdown()
    {
        isOpen = false;
    }

    private void MarkAllRead()
    {
        LedgerState.MarkAllAsRead();
        messages = LedgerState.GetMessages();
    }

    private void NavigateTo(DebtMessageItem item)
    {
        LedgerState.MarkAsRead(item.Id);
        isOpen = false;
        Navigation.NavigateTo(item.ActionUrl);
    }

    private void GoToCustomerLedger()
    {
        isOpen = false;
        Navigation.NavigateTo("/customer-ledger");
    }

    private void SimulateTestDispute()
    {
        LedgerState.SimulateSampleDispute();
        messages = LedgerState.GetMessages();
    }

    private void HandleSmartReminderClick(SmartReminderDto rem)
    {
        isOpen = false;
        Navigation.NavigateTo(rem.Url);
    }

    private async Task OpenAvaPanel()
    {
        isOpen = false;
        if (OnOpenAva.HasDelegate)
        {
            await OnOpenAva.InvokeAsync();
        }
    }

    public void Dispose()
    {
        LedgerState.OnChange -= OnStateChanged;
    }
}
