@using WebBanHang.Components.Landing

<section class="landing-hero lp-section--dark position-relative overflow-hidden" id="gioi-thieu" aria-label="Giới thiệu nền tảng">
    <!-- 1. MULTI-LAYERED BACKGROUND EFFECTS (MESH GRADIENT + VIGNETTE + GRID MASK) -->
    <div class="landing-hero-bg" aria-hidden="true">
        <div class="landing-orb landing-orb-1"></div>
        <div class="landing-orb landing-orb-2"></div>
        <div class="landing-orb landing-orb-3"></div>
        <div class="landing-grid-pattern"></div>
        <div class="landing-hero-vignette"></div>
    </div>

    <!-- 3D FLOATING BACKGROUND LAYER (STAGE 1) -->
    <div class="lp-bg3d" aria-hidden="true" tabindex="-1">
        <!-- Ambient Glow Halos -->
        <div class="lp-bg3d-glow lp-bg3d-glow-blue" style="width: 380px; height: 380px; top: 12%; left: 4%;"></div>
        <div class="lp-bg3d-glow lp-bg3d-glow-emerald" style="width: 340px; height: 340px; bottom: 15%; right: 8%;"></div>

        <!-- 3D Carton Box (Near Depth, Parallax 0.22) -->
        <div class="cube-3d cube-carton depth-near" data-parallax-speed="0.22" style="top: 18%; left: 3%; --cube-w: 80px; --cube-h: 80px;">
            <div class="cube-3d-inner">
                <div class="cube-face cube-front"><span class="box-tape"></span><span class="box-icon">📦</span></div>
                <div class="cube-face cube-back"></div>
                <div class="cube-face cube-top"><span class="box-tape-h"></span></div>
                <div class="cube-face cube-bottom"></div>
                <div class="cube-face cube-left"></div>
                <div class="cube-face cube-right"></div>
            </div>
        </div>

        <!-- 3D Beverage Can (Mid Depth, Parallax 0.16) -->
        <div class="cylinder-can-3d depth-mid" data-parallax-speed="0.16" style="top: 66%; left: 10%;">
            <svg width="76" height="106" viewBox="0 0 80 110" fill="none" xmlns="http://www.w3.org/2000/svg">
                <defs>
                    <linearGradient id="heroCanGrad" x1="0" y1="0" x2="1" y2="0">
                        <stop offset="0%" stop-color="#1e40af" />
                        <stop offset="30%" stop-color="#3b82f6" />
                        <stop offset="55%" stop-color="#93c5fd" />
                        <stop offset="75%" stop-color="#2563eb" />
                        <stop offset="100%" stop-color="#1e3a8a" />
                    </linearGradient>
                    <linearGradient id="heroCanTop" x1="0" y1="0" x2="0" y2="1">
                        <stop offset="0%" stop-color="#e2e8f0" />
                        <stop offset="100%" stop-color="#94a3b8" />
                    </linearGradient>
                </defs>
                <ellipse cx="40" cy="100" rx="28" ry="7" fill="rgba(0,0,0,0.4)" filter="blur(3px)" />
                <path d="M 12 25 L 12 85 C 12 95 68 95 68 85 L 68 25 Z" fill="url(#heroCanGrad)" />
                <path d="M 38 25 L 38 86" stroke="rgba(255,255,255,0.6)" stroke-width="3" filter="blur(1px)" />
                <ellipse cx="40" cy="25" rx="28" ry="10" fill="url(#heroCanTop)" stroke="#cbd5e1" stroke-width="1.2" />
                <ellipse cx="40" cy="24" rx="21" ry="6" fill="#64748b" />
                <path d="M 36 21 C 36 19 44 19 44 21 C 44 24 36 24 36 21 Z" fill="#f8fafc" />
            </svg>
        </div>

        <!-- 3D Gold Coin (Far Depth, Parallax 0.08) -->
        <div class="coin-3d depth-far" data-parallax-speed="0.08" style="top: 14%; right: 8%;">
            <svg width="64" height="64" viewBox="0 0 68 68" fill="none" xmlns="http://www.w3.org/2000/svg">
                <defs>
                    <linearGradient id="heroCoinGold" x1="0" y1="0" x2="1" y2="1">
                        <stop offset="0%" stop-color="#fef08a" />
                        <stop offset="40%" stop-color="#f59e0b" />
                        <stop offset="85%" stop-color="#b45309" />
                    </linearGradient>
                </defs>
                <ellipse cx="34" cy="56" rx="24" ry="5" fill="rgba(0,0,0,0.3)" filter="blur(3px)" />
                <path d="M 8 34 C 8 48 60 48 60 34 L 60 39 C 60 53 8 53 8 39 Z" fill="#b45309" />
                <ellipse cx="34" cy="34" rx="26" ry="18" fill="url(#heroCoinGold)" stroke="#fef08a" stroke-width="1.2" />
                <ellipse cx="34" cy="34" rx="21" ry="13" fill="none" stroke="rgba(254, 240, 138, 0.6)" stroke-width="0.8" stroke-dasharray="2 2" />
                <text x="34" y="38" font-family="'Plus Jakarta Sans', sans-serif" font-weight="800" font-size="13" fill="#78350f" text-anchor="middle">₫</text>
            </svg>
        </div>

        <!-- 3D Mini Carton Box (Mid Depth, Parallax 0.14) -->
        <div class="cube-3d cube-carton cube-alt depth-mid lp-bg3d-extra" data-parallax-speed="0.14" style="bottom: 12%; right: 46%; --cube-w: 52px; --cube-h: 52px;">
            <div class="cube-3d-inner cube-alt">
                <div class="cube-face cube-front"><span class="box-tape"></span></div>
                <div class="cube-face cube-back"></div>
                <div class="cube-face cube-top"><span class="box-tape-h"></span></div>
                <div class="cube-face cube-bottom"></div>
                <div class="cube-face cube-left"></div>
                <div class="cube-face cube-right"></div>
            </div>
        </div>

        <!-- 3D Mini Coin (Far Depth, Parallax 0.06) -->
        <div class="coin-3d depth-far lp-bg3d-extra" data-parallax-speed="0.06" style="bottom: 22%; left: 45%;">
            <svg width="48" height="48" viewBox="0 0 68 68" fill="none" xmlns="http://www.w3.org/2000/svg">
                <ellipse cx="34" cy="34" rx="24" ry="16" fill="url(#heroCoinGold)" stroke="#fef08a" stroke-width="1" />
                <text x="34" y="38" font-family="'Plus Jakarta Sans', sans-serif" font-weight="800" font-size="12" fill="#78350f" text-anchor="middle">✓</text>
            </svg>
        </div>
    </div>

    <div class="container position-relative" style="z-index: 2;">
        <div class="row align-items-center g-4 g-lg-5 py-3 py-lg-5">
            <!-- 2. LEFT COLUMN: VALUE PROPOSITIONS & CALL TO ACTIONS -->
            <div class="col-12 col-lg-7 text-center text-lg-start">
                <!-- TOP BADGE WITH PULSING STATUS -->
                <div class="landing-hero-badge reveal-fade-up d-inline-flex align-items-center gap-2 mb-3">
                    <span class="landing-badge-pill">
                        <span class="landing-pulse-dot"></span>
                        @LandingConstants.CourseCode • Capstone 18
                    </span>
                    <span class="landing-badge-text">@LandingConstants.SubTitle</span>
                </div>

                <!-- HERO HEADLINE WITH ANIMATED GRADIENT & TEXT REVEAL -->
                <h1 class="landing-hero-title reveal-fade-up mb-3">
                    Bán Buôn Thần Tốc.<br />
                    <span class="landing-title-gradient">Kiểm Soát Công Nợ Tuyệt Đối.</span>
                </h1>

                <!-- BUSINESS-FOCUSED VALUE DESCRIPTION (MAX 560px, KHÔNG BỊ BẺ HẸP) -->
                <p class="landing-hero-subtitle mx-auto mx-lg-0 reveal-fade-up mb-4">
                    Giải pháp toàn diện cho nhà phân phối hàng tiêu dùng: Thiết lập hạn mức tín dụng thông minh, thu hồi dòng tiền minh bạch chuẩn FIFO, và cảnh báo sớm nợ quá hạn nhờ trợ lý tài chính thông minh.
                </p>

                <!-- 2 CTA BUTTONS: CHÍNH XANH LÁ ĐẶC BO 12px + PHỤ KÍNH VIỀN RGBA -->
                <div class="d-flex flex-wrap align-items-center justify-content-center justify-content-lg-start gap-3 reveal-fade-up mb-4">
                    <a href="/login" class="landing-btn-hero-primary d-inline-flex align-items-center gap-2" aria-label="Bắt đầu trải nghiệm nền tảng ngay">
                        <span>Trải Nghiệm Hệ Thống Ngay</span>
                        <i class="bi bi-arrow-right hero-btn-arrow"></i>
                    </a>
                    <a href="#san-pham" class="landing-btn-hero-glass d-inline-flex align-items-center gap-2" aria-label="Xem danh mục sản phẩm phân phối">
                        <i class="bi bi-grid-3x3-gap-fill text-info"></i>
                        <span>Xem Danh Mục Sản Phẩm</span>
                    </a>
                </div>

                <!-- 3 BUSINESS VALUE PROPOSITIONS (REPLACES TECH CHIPS) -->
                <div class="d-flex flex-wrap align-items-center justify-content-center justify-content-lg-start gap-3 text-secondary small reveal-fade-up">
                    <div class="d-flex align-items-center gap-2 landing-trust-item">
                        <i class="bi bi-shield-check text-success fs-5"></i>
                        <span class="text-white fw-medium">Hạn mức tín dụng tự động</span>
                    </div>
                    <div class="d-flex align-items-center gap-2 landing-trust-item">
                        <i class="bi bi-arrow-repeat text-primary fs-5"></i>
                        <span class="text-white fw-medium">Cấn trừ nợ chuẩn FIFO</span>
                    </div>
                    <div class="d-flex align-items-center gap-2 landing-trust-item">
                        <i class="bi bi-bar-chart-steps text-warning fs-5"></i>
                        <span class="text-white fw-medium">Báo cáo 4 xô tuổi nợ</span>
                    </div>
                </div>
            </div>

            <!-- 3. RIGHT COLUMN: MULTI-LAYER WORKSPACE MOCKUP WITH 3D PARALLAX -->
            <div class="col-12 col-lg-5">
                <div class="landing-mockup-stage reveal-fade-up" id="heroMockupStage">
                    
                    <!-- MAIN DASHBOARD WINDOW CARD (FRAME KÍNH BACKDROP-FILTER + BO 24px) -->
                    <div class="landing-workspace-main-card" id="mainDashboardCard">
                        <!-- WINDOW CONTROLS & HEADER -->
                        <div class="d-flex align-items-center justify-content-between pb-3 mb-3 border-bottom border-white border-opacity-10">
                            <div class="d-flex align-items-center gap-1.5">
                                <span class="window-dot dot-red"></span>
                                <span class="window-dot dot-amber"></span>
                                <span class="window-dot dot-green"></span>
                                <span class="text-white-50 ms-2 fw-semibold" style="font-size: 0.8rem;">
                                    Bàn Làm Việc Kế Toán & Bán Hàng
                                </span>
                            </div>
                            <span class="badge bg-success bg-opacity-25 text-success border border-success border-opacity-25 px-2 py-0.5 rounded-pill" style="font-size: 0.7rem;">
                                <i class="bi bi-broadcast me-1"></i> Real-time
                            </span>
                        </div>

                        <!-- 2 KPI MINI STATS -->
                        <div class="row g-2.5 mb-3">
                            <div class="col-6">
                                <div class="landing-mini-stat">
                                    <div class="text-white-50 small" style="font-size: 0.74rem;">Hạn Mức Đã Cấp</div>
                                    <div class="fw-bold text-white fs-5 mt-0.5">@LandingConstants.HeroMockup.TotalCreditAllocated</div>
                                    <div class="text-success small fw-medium mt-0.5" style="font-size: 0.7rem;">
                                        <i class="bi bi-shield-check"></i> An toàn 100%
                                    </div>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="landing-mini-stat">
                                    <div class="text-white-50 small" style="font-size: 0.74rem;">Thu Hồi Nợ FIFO</div>
                                    <div class="fw-bold text-white fs-5 mt-0.5">@LandingConstants.HeroMockup.DemoDebtCollectionRate</div>
                                    <div class="text-info small fw-medium mt-0.5" style="font-size: 0.7rem;">
                                        <i class="bi bi-lightning-charge"></i> Cấn trừ tự động
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- 4-BUCKET AGING PROGRESS BAR (4 MÀU RÕ RÀNG + NHÃN >= 12px) -->
                        <div class="landing-mini-stat mb-3">
                            <div class="d-flex align-items-center justify-content-between mb-2">
                                <span class="text-white fw-semibold" style="font-size: 0.82rem;">
                                    <i class="bi bi-bar-chart-fill text-primary me-1"></i> Tuổi Nợ 4 Xô
                                </span>
                                <span class="badge bg-secondary bg-opacity-25 text-white-50 border border-white border-opacity-10" style="font-size: 0.68rem;">
                                    * Dữ liệu minh họa
                                </span>
                            </div>
                            
                            <!-- PROGRESS BAR: 4 SEGMENTS (55% / 25% / 12% / 8%) >= 10px HEIGHT -->
                            <div class="progress landing-aging-progress" style="height: 14px; background: rgba(255,255,255,0.08); border-radius: 8px;">
                                <div class="progress-bar bg-aging-emerald" 
                                     style="width: 55%; background-color: #10b981 !important;" 
                                     title="0 - 30 ngày: 55%">
                                </div>
                                <div class="progress-bar bg-aging-amber" 
                                     style="width: 25%; background-color: #f59e0b !important;" 
                                     title="31 - 60 ngày: 25%">
                                </div>
                                <div class="progress-bar bg-aging-orange" 
                                     style="width: 12%; background-color: #f97316 !important;" 
                                     title="61 - 90 ngày: 12%">
                                </div>
                                <div class="progress-bar bg-aging-rose" 
                                     style="width: 8%; background-color: #ef4444 !important;" 
                                     title="> 90 ngày: 8%">
                                </div>
                            </div>

                            <!-- LEGEND LABELS (>= 12px CHUẨN RUBRIC) -->
                            <div class="row g-1 text-center mt-2" style="font-size: 12px;">
                                <div class="col-3 fw-bold text-truncate" style="color: #10b981;" title="0 - 30 ngày (55%)">
                                    0-30 ngày
                                    <span class="d-block text-white-50" style="font-size: 11px;">55%</span>
                                </div>
                                <div class="col-3 fw-bold text-truncate" style="color: #f59e0b;" title="31 - 60 ngày (25%)">
                                    31-60 ngày
                                    <span class="d-block text-white-50" style="font-size: 11px;">25%</span>
                                </div>
                                <div class="col-3 fw-bold text-truncate" style="color: #f97316;" title="61 - 90 ngày (12%)">
                                    61-90 ngày
                                    <span class="d-block text-white-50" style="font-size: 11px;">12%</span>
                                </div>
                                <div class="col-3 fw-bold text-truncate" style="color: #ef4444;" title="> 90 ngày (8%)">
                                    >90 ngày
                                    <span class="d-block text-white-50" style="font-size: 11px;">8%</span>
                                </div>
                            </div>
                        </div>

                        <!-- FOOTER NOTE -->
                        <div class="d-flex align-items-center justify-content-between text-white-50 pt-1" style="font-size: 0.72rem;">
                            <span>Cân đối toàn vẹn (IsIntegrityValid): <strong class="text-success">Khớp 100%</strong></span>
                            <span>Đối soát tức thời</span>
                        </div>
                    </div>

                    <!-- FLOATING CARD 1: AVA AI ALERT (OFFSET TOP-RIGHT) -->
                    <div class="landing-float-card float-card-top-right" id="floatCard1">
                        <div class="d-flex align-items-center gap-2 mb-1.5">
                            <img src="/images/ava-avatar.svg" alt="AVA AI" class="rounded-circle" style="width: 24px; height: 24px;" />
                            <span class="fw-bold text-white small" style="font-size: 0.78rem;">Trợ Lý AVA Kế Toán</span>
                            <span class="badge bg-warning text-dark ms-auto" style="font-size: 0.68rem;">Cần chú ý</span>
                        </div>
                        <div class="text-white-50 small" style="font-size: 0.74rem; line-height: 1.4;">
                            <strong class="text-white">@LandingConstants.HeroMockup.AvaAlertCustomer:</strong> @LandingConstants.HeroMockup.AvaAlertMsg
                        </div>
                    </div>

                    <!-- FLOATING CARD 2: FIFO RECEIPT ALLOCATION (OFFSET BOTTOM-LEFT) -->
                    <div class="landing-float-card float-card-bottom-left" id="floatCard2">
                        <div class="d-flex align-items-center justify-content-between mb-1">
                            <span class="badge bg-success small px-2 py-0.5" style="font-size: 0.68rem;">
                                <i class="bi bi-check-all me-1"></i> FIFO Đã Cấn Trừ
                            </span>
                            <span class="fw-bold" style="color: #10b981; font-size: 0.82rem;">+@LandingConstants.HeroMockup.FifoReceiptAmount</span>
                        </div>
                        <div class="text-white-50 small" style="font-size: 0.72rem;">
                            Phiếu thu #@LandingConstants.HeroMockup.FifoReceiptNo: Gạch nợ HĐ cũ nhất trước
                        </div>
                    </div>

                    <!-- FLOATING CARD 3: CREDIT TIER BADGE (OFFSET BOTTOM-RIGHT) -->
                    <div class="landing-float-card float-card-bottom-right" id="floatCard3">
                        <div class="d-flex align-items-center gap-2">
                            <div class="p-1.5 rounded-circle bg-primary bg-opacity-25 text-primary">
                                <i class="bi bi-shield-shaded fs-5"></i>
                            </div>
                            <div>
                                <div class="text-white fw-bold small" style="font-size: 0.76rem;">Điểm Tín Nhiệm</div>
                                <div class="fw-semibold" style="color: #10b981; font-size: 0.72rem;">
                                    @LandingConstants.HeroMockup.CreditScore — @LandingConstants.HeroMockup.CreditGrade
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
</section>
