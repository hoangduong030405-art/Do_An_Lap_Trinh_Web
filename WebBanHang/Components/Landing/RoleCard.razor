<section class="landing-section lp-section--light position-relative overflow-hidden" id="kien-truc">
    <!-- 3D FLOATING BACKGROUND LAYER (STAGE 1) -->
    <div class="lp-bg3d" aria-hidden="true" tabindex="-1">
        <!-- Ambient Subtle Halos -->
        <div class="lp-bg3d-glow lp-bg3d-glow-blue" style="width: 340px; height: 340px; top: 12%; right: 4%;"></div>
        <div class="lp-bg3d-glow lp-bg3d-glow-purple" style="width: 300px; height: 300px; bottom: 10%; left: 4%;"></div>

        <!-- 3D 4-Tier Clean Architecture Isometric Stack (Mid Depth, Parallax 0.18) -->
        <div class="clean-arch-stack-3d depth-mid" data-parallax-speed="0.18" style="top: 14%; right: 4%;">
            <svg width="150" height="170" viewBox="0 0 150 170" fill="none" xmlns="http://www.w3.org/2000/svg">
                <defs>
                    <linearGradient id="layerWeb" x1="0" y1="0" x2="1" y2="1">
                        <stop offset="0%" stop-color="rgba(59,130,246,0.35)" />
                        <stop offset="100%" stop-color="rgba(37,99,235,0.15)" />
                    </linearGradient>
                    <linearGradient id="layerSql" x1="0" y1="0" x2="1" y2="1">
                        <stop offset="0%" stop-color="rgba(99,102,241,0.35)" />
                        <stop offset="100%" stop-color="rgba(79,70,229,0.15)" />
                    </linearGradient>
                    <linearGradient id="layerUseCases" x1="0" y1="0" x2="1" y2="1">
                        <stop offset="0%" stop-color="rgba(16,185,129,0.35)" />
                        <stop offset="100%" stop-color="rgba(5,150,105,0.15)" />
                    </linearGradient>
                    <linearGradient id="layerCore" x1="0" y1="0" x2="1" y2="1">
                        <stop offset="0%" stop-color="rgba(139,92,246,0.35)" />
                        <stop offset="100%" stop-color="rgba(109,40,217,0.15)" />
                    </linearGradient>
                </defs>
                <line x1="75" y1="18" x2="75" y2="145" stroke="rgba(59,130,246,0.5)" stroke-width="2" stroke-dasharray="3 3" />
                
                <!-- Slab 4 (Bottom): CoreBusiness -->
                <g transform="translate(0, 105)">
                    <polygon points="15,25 75,45 135,25 75,5" fill="url(#layerCore)" stroke="#8b5cf6" stroke-width="1.2" />
                    <polygon points="15,25 75,45 75,50 15,30" fill="rgba(109,40,217,0.3)" />
                    <polygon points="75,45 135,25 135,30 75,50" fill="rgba(91,33,182,0.4)" />
                    <text x="75" y="28" font-family="system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif" font-weight="700" font-size="7.5" fill="#6d28d9" text-anchor="middle">1. CoreBusiness</text>
                </g>
                
                <!-- Slab 3: UseCases -->
                <g transform="translate(0, 70)">
                    <polygon points="15,25 75,45 135,25 75,5" fill="url(#layerUseCases)" stroke="#10b981" stroke-width="1.2" />
                    <polygon points="15,25 75,45 75,50 15,30" fill="rgba(5,150,105,0.3)" />
                    <polygon points="75,45 135,25 135,30 75,50" fill="rgba(4,120,87,0.4)" />
                    <text x="75" y="28" font-family="system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif" font-weight="700" font-size="7.5" fill="#047857" text-anchor="middle">2. UseCases</text>
                </g>
                
                <!-- Slab 2: Plugins.DataStore.SQL -->
                <g transform="translate(0, 35)">
                    <polygon points="15,25 75,45 135,25 75,5" fill="url(#layerSql)" stroke="#6366f1" stroke-width="1.2" />
                    <polygon points="15,25 75,45 75,50 15,30" fill="rgba(79,70,229,0.3)" />
                    <polygon points="75,45 135,25 135,30 75,50" fill="rgba(67,56,202,0.4)" />
                    <text x="75" y="28" font-family="system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif" font-weight="700" font-size="7.5" fill="#4338ca" text-anchor="middle">3. Plugins.SQL</text>
                </g>
                
                <!-- Slab 1 (Top): WebBanHang (Blazor UI) -->
                <g transform="translate(0, 0)">
                    <polygon points="15,25 75,45 135,25 75,5" fill="url(#layerWeb)" stroke="#3b82f6" stroke-width="1.2" />
                    <polygon points="15,25 75,45 75,50 15,30" fill="rgba(37,99,235,0.3)" />
                    <polygon points="75,45 135,25 135,30 75,50" fill="rgba(29,78,216,0.4)" />
                    <text x="75" y="28" font-family="system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif" font-weight="700" font-size="7.5" fill="#1d4ed8" text-anchor="middle">4. WebBanHang UI</text>
                </g>
            </svg>
        </div>

        <!-- 3D Security Shield (Near Depth, Parallax 0.22) -->
        <div class="shield-3d depth-near" data-parallax-speed="0.22" style="position: absolute; bottom: 10%; left: 4%;">
            <svg width="68" height="80" viewBox="0 0 72 84" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M 36 6 L 62 16 C 62 48 36 74 36 74 C 36 74 10 48 10 16 Z" fill="rgba(59,130,246,0.18)" stroke="#3b82f6" stroke-width="1.5" />
                <path d="M 28 38 L 34 44 L 46 30" stroke="#3b82f6" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
        </div>

        <!-- 3D Tech Cube (Far Depth, Parallax 0.08) -->
        <div class="cube-3d cube-tech depth-far lp-bg3d-extra" data-parallax-speed="0.08" style="top: 18%; left: 8%; --cube-w: 48px; --cube-h: 48px;">
            <div class="cube-3d-inner">
                <div class="cube-face cube-front"></div>
                <div class="cube-face cube-back"></div>
                <div class="cube-face cube-top"></div>
                <div class="cube-face cube-bottom"></div>
                <div class="cube-face cube-left"></div>
                <div class="cube-face cube-right"></div>
            </div>
        </div>
    </div>

    <div class="container position-relative" style="z-index: 2;">
        <!-- HEADER -->
        <div class="text-center">
            <span class="landing-section-badge reveal-fade-up">Kiến Trúc & Phân Quyền</span>
            <h2 class="landing-section-title reveal-fade-up">
                Kiến Trúc Clean Architecture & 3 Vai Trò Vận Hành
            </h2>
            <p class="landing-section-desc reveal-fade-up">
                Hệ thống 4 tầng phân tách độc lập (CoreBusiness - UseCases - SQL - WebBanHang), bảo mật Cookie Authentication đa vai trò và phân lập dữ liệu tài chính.
            </p>
        </div>

        <div class="row g-4">
            <!-- ROLE 1: ACCOUNTANT -->
            <div class="col-12 col-md-4">
                <div class="landing-role-card lp-tilt-card reveal-3d-card reveal-delay-1">
                    <div class="lp-tilt-float">
                        <span class="landing-role-badge bg-primary-subtle text-primary border border-primary border-opacity-25">
                            <i class="bi bi-shield-lock-fill me-1"></i> Quản Trị Viên / Kế Toán
                        </span>
                    </div>
                    <h4 class="fw-bold text-slate-navy mb-2">Kế Toán Công Nợ</h4>
                    <p class="text-muted small mb-4">
                        Toàn quyền giám sát dòng tiền, thẩm định hạn mức nợ và đối soát tài chính của nhà phân phối.
                    </p>

                    <ul class="list-unstyled d-flex flex-column gap-2.5 small text-slate-navy mb-4 flex-grow-1">
                        <li class="d-flex align-items-center gap-2">
                            <i class="bi bi-check-circle-fill text-success"></i>
                            <span>Phê duyệt & điều chỉnh hạn mức tín dụng</span>
                        </li>
                        <li class="d-flex align-items-center gap-2">
                            <i class="bi bi-check-circle-fill text-success"></i>
                            <span>Thực hiện thu tiền cấn trừ tự động FIFO</span>
                        </li>
                        <li class="d-flex align-items-center gap-2">
                            <i class="bi bi-check-circle-fill text-success"></i>
                            <span>Xem Sổ Chi Tiết Công Nợ lũy kế (Ledger)</span>
                        </li>
                        <li class="d-flex align-items-center gap-2">
                            <i class="bi bi-check-circle-fill text-success"></i>
                            <span>Xuất báo cáo tuổi nợ 4 xô định dạng CSV</span>
                        </li>
                        <li class="d-flex align-items-center gap-2">
                            <i class="bi bi-check-circle-fill text-success"></i>
                            <span>Sử dụng AVA AI thẩm định & gửi email nợ</span>
                        </li>
                    </ul>

                    <a href="/login" class="btn btn-primary rounded-pill w-100 fw-bold py-2 shadow-sm d-flex align-items-center justify-content-center gap-2">
                        <span>Đăng Nhập Kế Toán</span> <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
            </div>

            <!-- ROLE 2: SALES -->
            <div class="col-12 col-md-4">
                <div class="landing-role-card lp-tilt-card reveal-3d-card reveal-delay-2">
                    <div class="lp-tilt-float">
                        <span class="landing-role-badge bg-success-subtle text-success border border-success border-opacity-25">
                            <i class="bi bi-cart-check-fill me-1"></i> Nghiệp Vụ Kinh Doanh
                        </span>
                    </div>
                    <h4 class="fw-bold text-slate-navy mb-2">Nhân Viên Bán Hàng</h4>
                    <p class="text-muted small mb-4">
                        Tập trung tối đa vào tốc độ lên đơn bán buôn, kiểm tra tồn kho hàng hóa và in hóa đơn xuất kho.
                    </p>

                    <ul class="list-unstyled d-flex flex-column gap-2.5 small text-slate-navy mb-4 flex-grow-1">
                        <li class="d-flex align-items-center gap-2">
                            <i class="bi bi-check-circle-fill text-success"></i>
                            <span>Lên đơn hàng nhanh qua giỏ hàng Scoped</span>
                        </li>
                        <li class="d-flex align-items-center gap-2">
                            <i class="bi bi-check-circle-fill text-success"></i>
                            <span>Tự động kiểm tra hạn mức trước khi xuất kho</span>
                        </li>
                        <li class="d-flex align-items-center gap-2">
                            <i class="bi bi-check-circle-fill text-success"></i>
                            <span>Tra cứu danh mục sản phẩm & tồn kho thực</span>
                        </li>
                        <li class="d-flex align-items-center gap-2">
                            <i class="bi bi-check-circle-fill text-success"></i>
                            <span>In hóa đơn khổ A4 kèm mã VietQR Napas</span>
                        </li>
                        <li class="d-flex align-items-center gap-2 text-muted">
                            <i class="bi bi-dash-circle"></i>
                            <span class="text-decoration-line-through">Không có quyền sửa hạn mức nợ</span>
                        </li>
                    </ul>

                    <a href="/login" class="btn btn-outline-success rounded-pill w-100 fw-bold py-2 d-flex align-items-center justify-content-center gap-2">
                        <span>Đăng Nhập Bán Hàng</span> <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
            </div>

            <!-- ROLE 3: CUSTOMER / B2B PORTAL -->
            <div class="col-12 col-md-4">
                <div class="landing-role-card lp-tilt-card reveal-3d-card reveal-delay-3">
                    <div class="lp-tilt-float">
                        <span class="landing-role-badge bg-info-subtle text-info border border-info border-opacity-25">
                            <i class="bi bi-shop me-1"></i> Khách Hàng / Đối Tác
                        </span>
                    </div>
                    <h4 class="fw-bold text-slate-navy mb-2">Đại Lý Phân Phối B2B</h4>
                    <p class="text-muted small mb-4">
                        Cổng tự phục vụ dành cho các chủ đại lý tạp hóa, siêu thị mini theo dõi đơn và thanh toán 24/7.
                    </p>

                    <ul class="list-unstyled d-flex flex-column gap-2.5 small text-slate-navy mb-4 flex-grow-1">
                        <li class="d-flex align-items-center gap-2">
                            <i class="bi bi-check-circle-fill text-success"></i>
                            <span>Theo dõi số dư công nợ & hạn mức còn lại</span>
                        </li>
                        <li class="d-flex align-items-center gap-2">
                            <i class="bi bi-check-circle-fill text-success"></i>
                            <span>Tra cứu lịch sử mua hàng & tải hóa đơn A4</span>
                        </li>
                        <li class="d-flex align-items-center gap-2">
                            <i class="bi bi-check-circle-fill text-success"></i>
                            <span>Quét mã VietQR thanh toán đúng số dư nợ</span>
                        </li>
                        <li class="d-flex align-items-center gap-2">
                            <i class="bi bi-check-circle-fill text-success"></i>
                            <span>Chủ động đặt thêm hàng sỉ online trực tiếp</span>
                        </li>
                        <li class="d-flex align-items-center gap-2">
                            <i class="bi bi-check-circle-fill text-success"></i>
                            <span>Minh bạch số tiền đã trả qua từng đợt FIFO</span>
                        </li>
                    </ul>

                    <a href="/login" class="btn btn-outline-info rounded-pill w-100 fw-bold py-2 d-flex align-items-center justify-content-center gap-2">
                        <span>Cổng Đại Lý B2B</span> <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>
