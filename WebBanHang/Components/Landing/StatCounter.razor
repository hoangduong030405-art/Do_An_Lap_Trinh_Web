@using WebBanHang.UseCases.DTOs
@using WebBanHang.Components.Landing

<section class="landing-stats-section lp-section--dark py-4">
    <div class="container">
        <div class="landing-stats-container reveal-fade-up">
            <div class="row g-4 divide-y divide-y-md-0">
                <!-- STAT 1: SỐ MẶT HÀNG -->
                <div class="col-6 col-lg-3">
                    <div class="landing-stat-card">
                        <div class="d-inline-flex p-2.5 rounded-3 mb-2" style="background: rgba(59, 130, 246, 0.15); color: #60a5fa;">
                            <i class="bi bi-box-seam-fill fs-4"></i>
                        </div>
                        @if (hasManyProducts)
                        {
                            <div class="landing-stat-number"
                                 data-counter-target="@Statistics!.TotalProducts"
                                 data-counter-suffix="+">
                                @(Statistics!.TotalProducts)+
                            </div>
                        }
                        else
                        {
                            <div class="landing-stat-number text-nowrap" style="font-size: 1.55rem; letter-spacing: -0.01em;">
                                100% Chính Hãng
                            </div>
                        }
                        <div class="landing-stat-label">Mặt Hàng Sỉ</div>
                        <p class="landing-stat-desc">Bia, Nước ngọt, Sữa, Mì, Dầu ăn...</p>
                    </div>
                </div>

                <!-- STAT 2: ĐẠI LÝ PHÂN PHỐI -->
                <div class="col-6 col-lg-3">
                    <div class="landing-stat-card border-start-lg">
                        <div class="d-inline-flex p-2.5 rounded-3 mb-2" style="background: rgba(16, 185, 129, 0.15); color: #34d399;">
                            <i class="bi bi-people-fill fs-4"></i>
                        </div>
                        @if (hasManyCustomers)
                        {
                            <div class="landing-stat-number"
                                 data-counter-target="@Statistics!.TotalCustomers"
                                 data-counter-suffix="+">
                                @(Statistics!.TotalCustomers)+
                            </div>
                        }
                        else
                        {
                            <div class="landing-stat-number text-nowrap" style="font-size: 1.55rem; letter-spacing: -0.01em;">
                                Hạn Mức Độc Lập
                            </div>
                        }
                        <div class="landing-stat-label">Đại Lý B2B</div>
                        <p class="landing-stat-desc">Quản lý hạn mức nợ theo hồ sơ</p>
                    </div>
                </div>

                <!-- STAT 3: HÓA ĐƠN XỬ LÝ -->
                <div class="col-6 col-lg-3">
                    <div class="landing-stat-card border-start-lg">
                        <div class="d-inline-flex p-2.5 rounded-3 mb-2" style="background: rgba(245, 158, 11, 0.15); color: #fbbf24;">
                            <i class="bi bi-receipt fs-4"></i>
                        </div>
                        @if (hasManyInvoices)
                        {
                            <div class="landing-stat-number"
                                 data-counter-target="@Statistics!.TotalInvoicesProcessed"
                                 data-counter-suffix="+">
                                @(Statistics!.TotalInvoicesProcessed)+
                            </div>
                        }
                        else
                        {
                            <div class="landing-stat-number text-nowrap" style="font-size: 1.55rem; letter-spacing: -0.01em;">
                                Chuẩn ACID
                            </div>
                        }
                        <div class="landing-stat-label">Hóa Đơn Xuất Kho</div>
                        <p class="landing-stat-desc">Giao dịch an toàn trên SQL Server</p>
                    </div>
                </div>

                <!-- STAT 4: TỶ LỆ THU HỒI NỢ -->
                <div class="col-6 col-lg-3">
                    <div class="landing-stat-card border-start-lg">
                        <div class="d-inline-flex p-2.5 rounded-3 mb-2" style="background: rgba(139, 92, 246, 0.15); color: #a78bfa;">
                            <i class="bi bi-shield-check fs-4"></i>
                        </div>
                        @if (hasRealCollection)
                        {
                            <div class="landing-stat-number"
                                 data-counter-target="@Statistics!.DebtCollectionRate"
                                 data-counter-suffix="%"
                                 data-counter-decimals="1">
                                @(Statistics!.DebtCollectionRate.ToString("N1"))%
                            </div>
                        }
                        else
                        {
                            <div class="landing-stat-number text-nowrap" style="font-size: 1.55rem; color: #94a3b8; letter-spacing: -0.01em;">
                                Chưa có dữ liệu
                            </div>
                        }
                        <div class="landing-stat-label">Thu Nợ Đúng Hạn</div>
                        <p class="landing-stat-desc">Tự động phân bổ khi có phiếu thu</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    [Parameter]
    public PublicStatisticsDto? Statistics { get; set; }

    private bool hasManyProducts => Statistics != null && Statistics.TotalProducts >= 10;
    private bool hasManyCustomers => Statistics != null && Statistics.TotalCustomers >= 10;
    private bool hasManyInvoices => Statistics != null && Statistics.TotalInvoicesProcessed >= 10;
    private bool hasRealCollection => Statistics != null && Statistics.DebtCollectionRate > 0;
}
