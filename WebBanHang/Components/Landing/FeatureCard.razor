<section class="landing-section lp-section--light position-relative overflow-hidden" id="tinh-nang">
    <!-- 3D FLOATING BACKGROUND LAYER (STAGE 1) -->
    <div class="lp-bg3d" aria-hidden="true" tabindex="-1">
        <!-- Ambient Subtle Halos -->
        <div class="lp-bg3d-glow lp-bg3d-glow-blue" style="width: 320px; height: 320px; top: 10%; left: 3%;"></div>
        <div class="lp-bg3d-glow lp-bg3d-glow-emerald" style="width: 280px; height: 280px; bottom: 10%; right: 5%;"></div>

        <!-- 3D Security Shield (Near Depth, Parallax 0.20) -->
        <div class="shield-3d depth-near" data-parallax-speed="0.20" style="position: absolute; top: 14%; left: 4%;">
            <svg width="72" height="84" viewBox="0 0 72 84" fill="none" xmlns="http://www.w3.org/2000/svg">
                <defs>
                    <linearGradient id="shieldGrad" x1="0" y1="0" x2="1" y2="1">
                        <stop offset="0%" stop-color="#3b82f6" />
                        <stop offset="60%" stop-color="#1d4ed8" />
                        <stop offset="100%" stop-color="#1e3a8a" />
                    </linearGradient>
                </defs>
                <path d="M 36 6 L 62 16 C 62 48 36 74 36 74 C 36 74 10 48 10 16 Z" fill="url(#shieldGrad)" stroke="#60a5fa" stroke-width="1.5" />
                <path d="M 36 12 L 56 20 C 56 46 36 68 36 68 C 36 68 16 46 16 20 Z" fill="rgba(255,255,255,0.12)" />
                <path d="M 28 38 L 34 44 L 46 30" stroke="#ffffff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
        </div>

        <!-- 3D Tech Cube (Mid Depth, Parallax 0.15) -->
        <div class="cube-3d cube-tech depth-mid" data-parallax-speed="0.15" style="top: 58%; right: 4%; --cube-w: 64px; --cube-h: 64px;">
            <div class="cube-3d-inner">
                <div class="cube-face cube-front"></div>
                <div class="cube-face cube-back"></div>
                <div class="cube-face cube-top"></div>
                <div class="cube-face cube-bottom"></div>
                <div class="cube-face cube-left"></div>
                <div class="cube-face cube-right"></div>
            </div>
        </div>

        <!-- 3D Silver/Blue Coin (Far Depth, Parallax 0.08) -->
        <div class="coin-3d depth-far" data-parallax-speed="0.08" style="bottom: 12%; left: 16%;">
            <svg width="56" height="56" viewBox="0 0 68 68" fill="none" xmlns="http://www.w3.org/2000/svg">
                <defs>
                    <linearGradient id="silverCoinGrad" x1="0" y1="0" x2="1" y2="1">
                        <stop offset="0%" stop-color="#f8fafc" />
                        <stop offset="50%" stop-color="#94a3b8" />
                        <stop offset="100%" stop-color="#475569" />
                    </linearGradient>
                </defs>
                <ellipse cx="34" cy="34" rx="26" ry="18" fill="url(#silverCoinGrad)" stroke="#cbd5e1" stroke-width="1.2" />
                <text x="34" y="38" font-family="'Plus Jakarta Sans', sans-serif" font-weight="800" font-size="13" fill="#1e293b" text-anchor="middle">⚡</text>
            </svg>
        </div>

        <!-- 3D Mini Tech Cube (Mid Depth, Parallax 0.12) -->
        <div class="cube-3d cube-tech cube-alt depth-mid lp-bg3d-extra" data-parallax-speed="0.12" style="top: 20%; right: 28%; --cube-w: 44px; --cube-h: 44px;">
            <div class="cube-3d-inner cube-alt">
                <div class="cube-face cube-front"></div>
                <div class="cube-face cube-back"></div>
                <div class="cube-face cube-top"></div>
                <div class="cube-face cube-bottom"></div>
                <div class="cube-face cube-left"></div>
                <div class="cube-face cube-right"></div>
            </div>
        </div>
    </div>

    <div class="container position-relative" style="z-index: 2;">
        <!-- HEADER -->
        <div class="text-center">
            <span class="landing-section-badge reveal-fade-up">Giải Pháp Cốt Lõi</span>
            <h2 class="landing-section-title reveal-fade-up">
                Kiểm Soát Rủi Ro Tài Chính Toàn Diện Cho Doanh Nghiệp
            </h2>
            <p class="landing-section-desc reveal-fade-up">
                Kết hợp chặt chẽ giữa quản trị dòng tiền kế toán thực tế và chuỗi cung ứng hàng hóa phân phối bán buôn.
            </p>
        </div>

        <!-- 4 FEATURES GRID WITH 3D TILT & ENTRANCE -->
        <div class="row g-4">
            <!-- FEATURE 1: HẠN MỨC TÍN DỤNG -->
            <div class="col-12 col-md-6 col-lg-3">
                <div class="landing-feature-card lp-tilt-card reveal-3d-card reveal-delay-1">
                    <div class="lp-tilt-float">
                        <div class="landing-feature-icon landing-icon-blue">
                            <i class="bi bi-shield-lock-fill"></i>
                        </div>
                    </div>
                    <h5 class="fw-bold text-slate-navy mb-2.5">Kiểm Soát Hạn Mức Tín Dụng</h5>
                    <p class="text-muted small mb-0" style="line-height: 1.6;">
                        Tự động chặn lập đơn khi tổng nợ cũ cộng đơn mới vượt trần tín dụng (Credit Limit). Bắt ngoại lệ thân thiện, chống phát sinh nợ xấu ngay từ khâu bán hàng.
                    </p>
                </div>
            </div>

            <!-- FEATURE 2: THU NỢ FIFO -->
            <div class="col-12 col-md-6 col-lg-3">
                <div class="landing-feature-card lp-tilt-card reveal-3d-card reveal-delay-2">
                    <div class="lp-tilt-float">
                        <div class="landing-feature-icon landing-icon-green">
                            <i class="bi bi-arrow-repeat"></i>
                        </div>
                    </div>
                    <h5 class="fw-bold text-slate-navy mb-2.5">Thu Tiền Cấn Trừ FIFO</h5>
                    <p class="text-muted small mb-0" style="line-height: 1.6;">
                        Thuật toán First-In First-Out tự động ưu tiên gạch nợ cho các hóa đơn quá hạn hoặc phát sinh sớm nhất trước. Minh bạch tuyệt đối trên từng phiếu thu.
                    </p>
                </div>
            </div>

            <!-- FEATURE 3: TUỔI NỢ 4 XÔ -->
            <div class="col-12 col-md-6 col-lg-3">
                <div class="landing-feature-card lp-tilt-card reveal-3d-card reveal-delay-3">
                    <div class="lp-tilt-float">
                        <div class="landing-feature-icon landing-icon-yellow">
                            <i class="bi bi-bar-chart-steps"></i>
                        </div>
                    </div>
                    <h5 class="fw-bold text-slate-navy mb-2.5">Báo Cáo Tuổi Nợ 4 Xô</h5>
                    <p class="text-muted small mb-0" style="line-height: 1.6;">
                        Phân loại chính xác các khoản nợ vào 4 xô thời gian (0-30, 31-60, 61-90, >90 ngày). Tích hợp cờ kiểm soát toàn vẹn dữ liệu IsIntegrityValid chuẩn 100%.
                    </p>
                </div>
            </div>

            <!-- FEATURE 4: AI CHẤM ĐIỂM TÍN DỤNG -->
            <div class="col-12 col-md-6 col-lg-3">
                <div class="landing-feature-card lp-tilt-card reveal-3d-card reveal-delay-4">
                    <div class="lp-tilt-float">
                        <div class="landing-feature-icon landing-icon-purple">
                            <i class="bi bi-stars"></i>
                        </div>
                    </div>
                    <h5 class="fw-bold text-slate-navy mb-2.5">AI Chấm Điểm & Nhắc Nợ</h5>
                    <p class="text-muted small mb-0" style="line-height: 1.6;">
                        Trợ lý AI tự động xếp hạng tín nhiệm khách hàng (A/B/C/D), tự động soạn thảo email đòi nợ chuẩn văn phong doanh nghiệp. Kế toán phê duyệt trước khi gửi.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>
