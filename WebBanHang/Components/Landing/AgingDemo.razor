<section class="landing-section" id="cong-no" style="background-color: var(--landing-slate-50);">
    <div class="container">
        <!-- HEADER -->
        <div class="text-center">
            <span class="landing-section-badge reveal-fade-up">Minh Họa Trực Quan</span>
            <h2 class="landing-section-title reveal-fade-up">
                Cơ Chế Phân Khớp Tuổi Nợ & Cấn Trừ FIFO
            </h2>
            <p class="landing-section-desc reveal-fade-up">
                Giải quyết triệt để tình trạng tranh chấp công nợ giữa nhà phân phối và đại lý nhờ nguyên lý kế toán chuẩn mực.
            </p>
        </div>

        <div class="row g-4 align-items-stretch">
            <!-- LEFT: 4-BUCKET AGING DEMO CARD -->
            <div class="col-12 col-lg-6">
                <div class="landing-demo-card h-100 reveal-fade-up">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <h5 class="fw-bold text-slate-navy mb-0 d-flex align-items-center gap-2">
                            <i class="bi bi-clock-history text-primary"></i> Cơ Cấu Tuổi Nợ 4 Xô (Aging)
                        </h5>
                        <span class="badge bg-secondary-subtle text-secondary small border">Dữ liệu minh họa</span>
                    </div>
                    <p class="text-muted small mb-4">
                        Tự động phân loại từng hóa đơn chưa thanh toán vào các khung hạn nợ để tính dự phòng nợ khó đòi và kích hoạt biện pháp thu hồi:
                    </p>

                    <!-- VISUAL AGING PROGRESS BAR -->
                    <div class="landing-aging-bar mb-3">
                        <div class="aging-segment bg-success" style="width: 55%;" title="Trong hạn 0-30 ngày">
                            55%
                        </div>
                        <div class="aging-segment bg-warning text-dark" style="width: 25%;" title="Quá hạn 31-60 ngày">
                            25%
                        </div>
                        <div class="aging-segment" style="width: 12%; background-color: #fd7e14;" title="Quá hạn 61-90 ngày">
                            12%
                        </div>
                        <div class="aging-segment bg-danger" style="width: 8%;" title="Quá hạn >90 ngày">
                            8%
                        </div>
                    </div>

                    <!-- 4 BUCKET CARDS -->
                    <div class="row g-2 text-center mb-3">
                        <div class="col-3">
                            <div class="p-2 rounded bg-success text-white">
                                <div class="small fw-semibold" style="font-size: 0.72rem;">0 - 30 Ngày</div>
                                <div class="fw-bold small">55.000.000 đ</div>
                            </div>
                        </div>
                        <div class="col-3">
                            <div class="p-2 rounded bg-warning text-dark">
                                <div class="small fw-semibold" style="font-size: 0.72rem;">31 - 60 Ngày</div>
                                <div class="fw-bold small">25.000.000 đ</div>
                            </div>
                        </div>
                        <div class="col-3">
                            <div class="p-2 rounded text-white" style="background-color: #fd7e14;">
                                <div class="small fw-semibold" style="font-size: 0.72rem;">61 - 90 Ngày</div>
                                <div class="fw-bold small">12.000.000 đ</div>
                            </div>
                        </div>
                        <div class="col-3">
                            <div class="p-2 rounded bg-danger text-white">
                                <div class="small fw-semibold" style="font-size: 0.72rem;">> 90 Ngày</div>
                                <div class="fw-bold small">8.000.000 đ</div>
                            </div>
                        </div>
                    </div>

                    <!-- INTEGRITY CHECK BADGE -->
                    <div class="p-2.5 rounded-3 bg-light border d-flex align-items-center justify-content-between mt-auto">
                        <span class="text-muted small">Kiểm soát toàn vẹn (IsIntegrityValid):</span>
                        <span class="text-success small fw-bold d-flex align-items-center gap-1">
                            <i class="bi bi-patch-check-fill"></i> Khớp 100% Tổng Nợ: 100.000.000 đ
                        </span>
                    </div>
                </div>
            </div>

            <!-- RIGHT: FIFO ALLOCATION SIMULATION -->
            <div class="col-12 col-lg-6">
                <div class="landing-demo-card h-100 reveal-fade-up">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <h5 class="fw-bold text-slate-navy mb-0 d-flex align-items-center gap-2">
                            <i class="bi bi-arrow-down-up text-success"></i> Thuật Toán Phân Bổ FIFO
                        </h5>
                        <button class="btn btn-sm @(isSimulated ? "btn-outline-secondary" : "btn-primary") px-3" @onclick="ToggleFifoSimulation">
                            <i class="bi bi-play-circle me-1"></i> @(isSimulated ? "Đặt Lại Mô Phỏng" : "Mô Phỏng Thu Tiền 5 Trđ")
                        </button>
                    </div>

                    <p class="text-muted small mb-3">
                        Khách hàng thanh toán <strong>5.000.000 đ</strong>. Hệ thống tự động phân bổ vào hóa đơn cũ nhất trước:
                    </p>

                    <!-- INVOICE 1: OLDEST (3.000.000 đ) -->
                    <div class="card p-3 mb-2.5 border @(isSimulated ? "border-success bg-success-subtle bg-opacity-25" : "bg-white")">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="fw-bold text-slate-navy small">HĐ #001 (Lập 45 ngày trước - Nợ cũ nhất)</span>
                            <span class="badge @(isSimulated ? "bg-success" : "bg-danger") small">
                                @(isSimulated ? "ĐÃ THANH TOÁN ĐỦ (PAID)" : "ĐANG NỢ 3.000.000 đ")
                            </span>
                        </div>
                        <div class="small text-muted d-flex justify-content-between">
                            <span>Tổng nợ đơn: 3.000.000 đ</span>
                            <span class="fw-bold text-success">@(isSimulated ? "Được cấn trừ: +3.000.000 đ (Số dư nợ: 0 đ)" : "Chưa cấn trừ")</span>
                        </div>
                    </div>

                    <!-- INVOICE 2: NEWER (4.000.000 đ) -->
                    <div class="card p-3 mb-2.5 border @(isSimulated ? "border-warning bg-warning-subtle bg-opacity-25" : "bg-white")">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="fw-bold text-slate-navy small">HĐ #002 (Lập 10 ngày trước - Đơn kế tiếp)</span>
                            <span class="badge @(isSimulated ? "bg-warning text-dark" : "bg-danger") small">
                                @(isSimulated ? "TRẢ 1 PHẦN (PARTIALLY PAID)" : "ĐANG NỢ 4.000.000 đ")
                            </span>
                        </div>
                        <div class="small text-muted d-flex justify-content-between">
                            <span>Tổng nợ đơn: 4.000.000 đ</span>
                            <span class="fw-bold text-warning-emphasis">@(isSimulated ? "Được cấn trừ nốt: +2.000.000 đ (Còn nợ: 2.000.000 đ)" : "Chưa cấn trừ")</span>
                        </div>
                    </div>

                    <!-- RESULT EXPLANATION -->
                    <div class="p-2.5 rounded-3 bg-light border small text-muted mt-3">
                        <i class="bi bi-info-circle text-primary me-1"></i>
                        <span>Tiền thu 5 Trđ trừ hết 3 Trđ cho HĐ #001, phần dư 2 Trđ cấn trừ tiếp cho HĐ #002. Đúng chuẩn FIFO!</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private bool isSimulated = false;

    private void ToggleFifoSimulation()
    {
        isSimulated = !isSimulated;
    }
}
