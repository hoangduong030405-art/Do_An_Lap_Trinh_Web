@page "/create-invoice"
@attribute [Authorize(Roles = "Accountant,Sales")]
@rendermode InteractiveServer
@implements IDisposable

@using WebBanHang.UseCases.Invoices
@using WebBanHang.UseCases.Customers
@using WebBanHang.UseCases.Products
@using WebBanHang.CoreBusiness.Entities
@using WebBanHang.CoreBusiness.Exceptions
@using WebBanHang.Services
@using WebBanHang.Components.Controls
@using WebBanHang.UseCases.DTOs

@inject ICreateInvoiceUseCase CreateInvoiceUseCase
@inject IViewCustomerListUseCase ViewCustomerListUseCase
@inject IViewProductCatalogUseCase ViewProductCatalogUseCase
@inject IAssessCreditRiskUseCase AssessCreditRiskUseCase
@inject IGetCustomerDebtUseCase GetCustomerDebtUseCase
@inject DraftInvoiceStateService State

<div class="app-page-container">
    <PageHeader Title="Lập Hóa Đơn Bán Hàng"
                Subtitle="Xuất kho hàng sỉ, tự động kiểm tra hạn mức tín dụng và tạo mã VietQR"
                Icon="bi-cart-plus-fill">
        <Actions>
            <a href="/invoices" class="btn btn-secondary">
                <i class="bi bi-arrow-left me-1"></i> Danh Sách Hóa Đơn
            </a>
        </Actions>
    </PageHeader>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger">@errorMessage</div>
}
@if (!string.IsNullOrEmpty(successMessage))
{
    <div class="alert alert-success">@successMessage</div>
}

<div class="row mb-4">
    <div class="col-md-6">
        <h4>1. Chọn Khách Hàng</h4>
        <select class="form-select mb-2" @onchange="OnCustomerSelected">
            <option value="">-- Chọn khách hàng --</option>
            @if (customers != null)
            {
                @foreach (var c in customers)
                {
                    <option value="@c.Id" selected="@(c.Id == State.SelectedCustomerId)">@c.FullName - @c.CustomerCode</option>
                }
            }
        </select>
        
        @if (State.SelectedCustomer != null)
        {
            <div class="mt-2">
                <strong>Hạn mức tín dụng: </strong> @State.SelectedCustomer.CreditLimit.ToString("N0") đ <br />
                <strong>Công nợ hiện tại: </strong> @currentDebt.ToString("N0") đ <br />
                <div class="d-flex align-items-center gap-2 mt-1">
                    <CustomerDebtBadge 
                        CreditLimit="@State.SelectedCustomer.CreditLimit" 
                        CurrentDebt="@currentDebt" 
                        OnBadgeClick="() => {}" />
                    
                    @if (customerRisk != null)
                    {
                        @if (customerRisk.RatingGrade == "A")
                        {
                            <span class="badge bg-success" title="@customerRisk.Recommendation">
                                <i class="bi bi-robot"></i> AI Tín Nhiệm: Hạng A (@customerRisk.CreditScore/100)
                            </span>
                        }
                        else if (customerRisk.RatingGrade == "B")
                        {
                            <span class="badge bg-primary" title="@customerRisk.Recommendation">
                                <i class="bi bi-robot"></i> AI Tín Nhiệm: Hạng B (@customerRisk.CreditScore/100)
                            </span>
                        }
                        else if (customerRisk.RatingGrade == "C")
                        {
                            <span class="badge bg-warning text-dark" title="@customerRisk.Recommendation">
                                <i class="bi bi-robot"></i> AI Tín Nhiệm: Hạng C (@customerRisk.CreditScore/100)
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-danger" title="@customerRisk.Recommendation">
                                <i class="bi bi-robot"></i> AI Tín Nhiệm: Hạng D (@customerRisk.CreditScore/100 - Báo Động)
                            </span>
                        }
                    }
                </div>
            </div>
        }
    </div>
</div>

<div class="row mb-4">
    <div class="col-12">
        <h4>2. Hóa Đơn Nháp</h4>
        <InvoiceLineEditor 
            Items="@State.Items" 
            OnIncrement="HandleIncrement" 
            OnDecrement="HandleDecrement" 
            OnRemove="HandleRemove" />
            
        @if (State.Items.Any())
        {
            <div class="card bg-light border-0 p-3 mt-3 shadow-xs rounded-3">
                <div class="row align-items-center">
                    <div class="col-md-3">
                        <small class="text-muted d-block">Số lượng mặt hàng</small>
                        <span class="fs-5 fw-bold text-dark">@State.TotalItemCount SP (@State.Items.Count loại hàng)</span>
                    </div>
                    <div class="col-md-3">
                        <small class="text-muted d-block">Tổng tiền vốn nhập (COGS)</small>
                        <span class="fs-5 fw-bold text-secondary">@State.TotalCost.ToString("N0") đ</span>
                    </div>
                    <div class="col-md-3">
                        <small class="text-muted d-block">Tổng doanh thu bán sỉ</small>
                        <span class="fs-4 fw-bold text-primary">@State.TotalAmount.ToString("N0") đ</span>
                    </div>
                    <div class="col-md-3 text-md-end">
                        <small class="text-muted d-block">Lợi nhuận gộp dự kiến</small>
                        <span class="fs-4 fw-bold text-success">+@State.TotalProfit.ToString("N0") đ</span>
                        <span class="badge bg-success-subtle text-success border border-success-subtle ms-1">@State.ProfitMargin%</span>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<div class="row mb-4">
    <div class="col-12">
        <h4>3. Sản Phẩm Khả Dụng Trong Kho</h4>
        @if (products != null && products.Any())
        {
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th style="width: 60px;" class="text-center">Ảnh</th>
                        <th>Mã SP</th>
                        <th>Tên Hàng Hóa</th>
                        <th class="text-center">ĐVT</th>
                        <th class="text-end">Giá Nhập (Vốn)</th>
                        <th class="text-end">Giá Bán Sỉ</th>
                        <th class="text-end">Lãi Gộp / SP</th>
                        <th class="text-center">Tồn Kho</th>
                        <th class="text-center">Thao Tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in products)
                    {
                        <tr>
                            <td class="text-center">
                                <img src="@(string.IsNullOrEmpty(p.ImageUrl) ? "/images/products/sp001-coca-cola.svg" : p.ImageUrl)" 
                                     alt="@p.Name" 
                                     style="width: 44px; height: 44px; object-fit: contain;" 
                                     class="rounded border bg-white p-1 shadow-xs" />
                            </td>
                            <td><span class="badge bg-light text-secondary border font-monospace">@p.ProductCode</span></td>
                            <td class="fw-semibold">@p.Name</td>
                            <td class="text-center">@p.Unit</td>
                            <td class="text-end text-muted small">@p.CostPrice.ToString("N0") đ</td>
                            <td class="text-end fw-bold text-primary">@p.UnitPrice.ToString("N0") đ</td>
                            <td class="text-end">
                                <span class="badge bg-success-subtle text-success border border-success-subtle">
                                    +@p.UnitProfit.ToString("N0") đ (@p.ProfitMargin%)
                                </span>
                            </td>
                            <td class="text-center">
                                <span class="badge @(p.StockQuantity <= 10 ? "bg-warning text-dark" : "bg-success")">
                                    @p.StockQuantity
                                </span>
                            </td>
                            <td class="text-center">
                                <button class="btn btn-primary btn-sm rounded-pill px-3" @onclick="() => State.AddProduct(p, 1)">
                                    <i class="bi bi-cart-plus me-1"></i> + Thêm
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

@if (State.Items.Any() && State.SelectedCustomerId.HasValue)
{
    <button class="btn btn-success btn-lg mb-5" @onclick="SubmitInvoice">Xác Nhận Lập Hóa Đơn</button>
}

</div><!-- /app-page-container -->

@code {
    private IEnumerable<Customer>? customers;
    private IEnumerable<Product>? products;
    private decimal currentDebt;
    private CreditRiskAssessmentDto? customerRisk;
    private string errorMessage = "";
    private string successMessage = "";

    protected override async Task OnInitializedAsync()
    {
        State.OnChange += StateHasChanged;
        customers = await ViewCustomerListUseCase.ExecuteAsync();
        products = await ViewProductCatalogUseCase.ExecuteAsync();
    }

    public void Dispose()
    {
        State.OnChange -= StateHasChanged;
    }

    private async Task OnCustomerSelected(ChangeEventArgs e)
    {
        errorMessage = "";
        successMessage = "";
        if (int.TryParse(e.Value?.ToString(), out int customerId))
        {
            var customer = customers?.FirstOrDefault(c => c.Id == customerId);
            if (customer != null)
            {
                State.SetCustomer(customer);
                currentDebt = await GetCustomerDebtUseCase.ExecuteAsync(customerId);
                try
                {
                    customerRisk = await AssessCreditRiskUseCase.ExecuteAsync(customerId);
                }
                catch
                {
                    customerRisk = null;
                }
            }
        }
        else
        {
            State.Clear();
            currentDebt = 0;
            customerRisk = null;
        }
    }

    private void HandleIncrement(int productId)
    {
        var item = State.Items.FirstOrDefault(i => i.ProductId == productId);
        if (item != null)
        {
            State.UpdateQuantity(productId, item.Quantity + 1);
        }
    }

    private void HandleDecrement(int productId)
    {
        var item = State.Items.FirstOrDefault(i => i.ProductId == productId);
        if (item != null)
        {
            State.UpdateQuantity(productId, item.Quantity - 1);
        }
    }

    private void HandleRemove(int productId)
    {
        State.RemoveProduct(productId);
    }

    private async Task SubmitInvoice()
    {
        errorMessage = "";
        successMessage = "";

        if (!State.SelectedCustomerId.HasValue)
        {
            errorMessage = "Vui lòng chọn khách hàng.";
            return;
        }

        try
        {
            var customerId = State.SelectedCustomerId.Value;
            var lines = State.Items.Select(i => new InvoiceLine
            {
                ProductId = i.ProductId,
                Quantity = i.Quantity,
                UnitPrice = i.UnitPrice
            }).ToList();

            var invoiceId = await CreateInvoiceUseCase.ExecuteAsync(customerId, DateTime.Now, lines);
            
            successMessage = $"Lập hóa đơn thành công! Mã hóa đơn mới tạo là: #{invoiceId}. Tồn kho và công nợ đã được cập nhật.";
            State.Clear();
            currentDebt = 0;
            customerRisk = null;
            products = await ViewProductCatalogUseCase.ExecuteAsync();
        }
        catch (CreditLimitExceededException ex)
        {
            errorMessage = ex.Message;
        }
        catch (BusinessRuleException ex)
        {
            errorMessage = ex.Message;
        }
        catch (Exception ex)
        {
            errorMessage = $"Đã xảy ra lỗi không xác định: {ex.Message}";
        }
    }
}
