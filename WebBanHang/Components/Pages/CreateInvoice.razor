@page "/create-invoice"
@attribute [Authorize(Roles = "Accountant,Sales")]
@rendermode InteractiveServer
@implements IDisposable

@using WebBanHang.UseCases.Invoices
@using WebBanHang.UseCases.Customers
@using WebBanHang.UseCases.Products
@using WebBanHang.CoreBusiness.Entities
@using WebBanHang.CoreBusiness.Exceptions
@using WebBanHang.Services
@using WebBanHang.Components.Controls
@using WebBanHang.UseCases.DTOs
@using Microsoft.AspNetCore.Components.Authorization

@inject ICreateInvoiceUseCase CreateInvoiceUseCase
@inject IViewCustomerListUseCase ViewCustomerListUseCase
@inject IViewProductCatalogUseCase ViewProductCatalogUseCase
@inject IAssessCreditRiskUseCase AssessCreditRiskUseCase
@inject IGetCustomerDebtUseCase GetCustomerDebtUseCase
@inject DraftInvoiceStateService State
@inject AuthenticationStateProvider AuthStateProvider

<div class="app-page-container">
    <PageHeader Title="Lập Hóa Đơn Bán Hàng"
                Subtitle="Xuất kho hàng sỉ, tự động thẩm định hạn mức nợ và kích hoạt thanh toán VietQR"
                Icon="bi-cart-plus-fill">
        <Actions>
            <a href="/invoices" class="btn btn-secondary">
                <i class="bi bi-arrow-left me-1"></i> Danh Sách Hóa Đơn
            </a>
        </Actions>
    </PageHeader>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-xs border-danger mb-4" role="alert">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-exclamation-octagon-fill fs-5 flex-shrink-0"></i>
                <div class="fw-semibold">@errorMessage</div>
            </div>
            <button type="button" class="btn-close" @onclick="() => errorMessage = string.Empty"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="alert alert-success alert-dismissible fade show shadow-xs border-success mb-4" role="alert">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-check-circle-fill fs-5 flex-shrink-0"></i>
                <div class="fw-semibold">@successMessage</div>
            </div>
            <button type="button" class="btn-close" @onclick="() => successMessage = string.Empty"></button>
        </div>
    }

    <!-- =========================================================================
         BƯỚC 1: KHÁCH HÀNG & THẨM ĐỊNH HẠN MỨC TÍN DỤNG
         ========================================================================= -->
    <div class="card mb-4 border shadow-sm" style="border-radius: 16px; border-color: #e5eaf1 !important; background: #ffffff;">
        <div class="card-header bg-white border-bottom py-3 px-4 d-flex align-items-center justify-content-between" style="border-color: #e5eaf1 !important;">
            <div class="d-flex align-items-center gap-2">
                <span class="badge bg-primary-subtle text-primary rounded-circle p-2" style="width: 32px; height: 32px; display: inline-flex; align-items: center; justify-content: center; font-weight: bold;">1</span>
                <h6 class="card-title mb-0 fw-bold text-dark fs-6">Chọn Đại Lý / Khách Hàng B2B</h6>
            </div>
            @if (State.SelectedCustomer != null)
            {
                <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-1.5" style="font-size: 14.5px; font-weight: 600;">
                    <i class="bi bi-check2 me-1"></i>Đã chọn đại lý
                </span>
            }
        </div>
        <div class="card-body p-4">
            <div class="row g-4 align-items-start">
                <div class="col-12 col-lg-5">
                    <label class="form-label fw-bold text-dark mb-1.5" style="font-size: 16px;">
                        Tên Khách Hàng / Đại Lý <span class="text-danger">*</span>
                    </label>
                    <select class="form-select" @onchange="OnCustomerSelected" style="min-height: 44px; font-size: 15px;">
                        <option value="">-- Bấm để chọn đại lý phân phối --</option>
                        @if (customers != null)
                        {
                            @foreach (var c in customers)
                            {
                                <option value="@c.Id" selected="@(c.Id == State.SelectedCustomerId)">
                                    @c.FullName (@c.CustomerCode) - ĐT: @c.PhoneNumber
                                </option>
                            }
                        }
                    </select>
                    <div class="form-text text-muted" style="font-size: 16px;">
                        Hệ thống tự động tra cứu số dư nợ TK 131 và đối soát trần tín dụng theo thời gian thực.
                    </div>
                </div>

                <div class="col-12 col-lg-7">
                    @if (State.SelectedCustomer != null)
                    {
                        var creditLimit = State.SelectedCustomer.CreditLimit;
                        var remainingCredit = creditLimit - currentDebt;
                        var utilizationRate = creditLimit > 0 ? (currentDebt / creditLimit) * 100m : 0m;
                        var isWarning = utilizationRate >= 90m || remainingCredit < 0m;

                        <div class="p-3.5 rounded-3 border bg-light" style="border-color: #e5eaf1 !important;">
                            <div class="d-flex align-items-center justify-content-between mb-3">
                                <div>
                                    <h6 class="fw-bold text-dark mb-0.5">@State.SelectedCustomer.FullName</h6>
                                    <span class="text-muted small" style="font-size: 16px;">Mã KH: <strong>@State.SelectedCustomer.CustomerCode</strong> • Hạn nợ: <strong>@State.SelectedCustomer.PaymentTermsDays ngày</strong></span>
                                </div>
                                <div>
                                    @if (customerRisk != null)
                                    {
                                        @if (customerRisk.RatingGrade == "A")
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle px-2.5 py-1.5" style="font-size: 14.5px; font-weight: 600;" title="@customerRisk.Recommendation">
                                                <i class="bi bi-shield-check me-1"></i>Hạng A (@customerRisk.CreditScore/100)
                                            </span>
                                        }
                                        else if (customerRisk.RatingGrade == "B")
                                        {
                                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2.5 py-1.5" style="font-size: 14.5px; font-weight: 600;" title="@customerRisk.Recommendation">
                                                <i class="bi bi-shield me-1"></i>Hạng B (@customerRisk.CreditScore/100)
                                            </span>
                                        }
                                        else if (customerRisk.RatingGrade == "C")
                                        {
                                            <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle px-2.5 py-1.5" style="font-size: 14.5px; font-weight: 600;" title="@customerRisk.Recommendation">
                                                <i class="bi bi-shield-exclamation me-1"></i>Hạng C (@customerRisk.CreditScore/100)
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2.5 py-1.5" style="font-size: 14.5px; font-weight: 600;" title="@customerRisk.Recommendation">
                                                <i class="bi bi-shield-x me-1"></i>Hạng D - Cảnh báo nợ (@customerRisk.CreditScore/100)
                                            </span>
                                        }
                                    }
                                </div>
                            </div>

                            <!-- 3 KPI BOXES -->
                            <div class="row g-2 mb-3 text-center">
                                <div class="col-4">
                                    <div class="p-2.5 rounded-3 bg-white border">
                                        <div class="text-muted" style="font-size: 16px; font-weight: 600;">Hạn Mức Cấp</div>
                                        <div class="fw-bold text-dark fs-6" style="font-variant-numeric: tabular-nums;">@creditLimit.ToString("N0") đ</div>
                                    </div>
                                </div>
                                <div class="col-4">
                                    <div class="p-2.5 rounded-3 bg-white border">
                                        <div class="text-muted" style="font-size: 16px; font-weight: 600;">Nợ Hiện Tại</div>
                                        <div class="fw-bold text-danger fs-6" style="font-variant-numeric: tabular-nums;">@currentDebt.ToString("N0") đ</div>
                                    </div>
                                </div>
                                <div class="col-4">
                                    <div class="p-2.5 rounded-3 bg-white border">
                                        <div class="text-muted" style="font-size: 16px; font-weight: 600;">Còn Được Mua Nợ</div>
                                        <div class="fw-bold @(remainingCredit > 0 ? "text-success" : "text-danger") fs-6" style="font-variant-numeric: tabular-nums;">
                                            @remainingCredit.ToString("N0") đ
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- UTILIZATION PROGRESS BAR -->
                            <div>
                                <div class="d-flex justify-content-between align-items-center mb-1" style="font-size: 16px;">
                                    <span class="text-muted">Tỷ lệ sử dụng hạn mức tín dụng:</span>
                                    <span class="fw-bold @(isWarning ? "text-danger" : "text-primary")">@utilizationRate.ToString("N1")%</span>
                                </div>
                                <div class="progress" style="height: 8px; border-radius: 4px;">
                                    <div class="progress-bar @(utilizationRate > 90 ? "bg-danger" : utilizationRate > 70 ? "bg-warning" : "bg-success")" 
                                         role="progressbar" 
                                         style="width: @(Math.Min(utilizationRate, 100m))%"></div>
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="p-4 rounded-3 border bg-light text-center text-muted" style="border-style: dashed !important; border-color: #cbd5e1 !important;">
                            <i class="bi bi-person-bounding-box fs-3 d-block mb-1 text-secondary"></i>
                            <span>Chọn một khách hàng ở danh sách bên trái để hiển thị hồ sơ nợ & hạn mức tín dụng.</span>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- =========================================================================
         BƯỚC 2: HÓA ĐƠN NHÁP & TỔNG KẾT TÀI CHÍNH
         ========================================================================= -->
    <div class="card mb-4 border shadow-sm" style="border-radius: 16px; border-color: #e5eaf1 !important; background: #ffffff;">
        <div class="card-header bg-white border-bottom py-3 px-4 d-flex align-items-center justify-content-between" style="border-color: #e5eaf1 !important;">
            <div class="d-flex align-items-center gap-2">
                <span class="badge bg-primary-subtle text-primary rounded-circle p-2" style="width: 32px; height: 32px; display: inline-flex; align-items: center; justify-content: center; font-weight: bold;">2</span>
                <h6 class="card-title mb-0 fw-bold text-dark fs-6">Danh Sách Mặt Hàng Xuất Kho (Giỏ Hàng Nháp)</h6>
            </div>
            @if (State.Items.Any())
            {
                <span class="badge bg-primary px-3 py-1.5" style="font-size: 14.5px; font-weight: 600;">
                    @State.TotalItemCount sản phẩm (@State.Items.Count loại hàng)
                </span>
            }
        </div>
        <div class="card-body p-4">
            <InvoiceLineEditor 
                Items="@State.Items" 
                IsSales="@isSales"
                OnIncrement="HandleIncrement" 
                OnDecrement="HandleDecrement" 
                OnRemove="HandleRemove" />

            @if (State.Items.Any())
            {
                <div class="card p-3.5 mt-3 border bg-light" style="border-radius: 12px; border-color: #e5eaf1 !important;">
                    <div class="row align-items-center text-center text-md-start g-3">
                        @if (!isSales)
                        {
                            <div class="col-6 col-md-3">
                                <span class="text-muted d-block" style="font-size: 16px;">Tổng Giá Vốn (COGS):</span>
                                <span class="fs-5 fw-bold text-secondary" style="font-variant-numeric: tabular-nums;">@State.TotalCost.ToString("N0") đ</span>
                            </div>
                            <div class="col-6 col-md-3">
                                <span class="text-muted d-block" style="font-size: 16px;">Lợi Nhuận Gộp Kỳ Vọng:</span>
                                <span class="fs-5 fw-bold text-success" style="font-variant-numeric: tabular-nums;">
                                    +@State.TotalProfit.ToString("N0") đ
                                </span>
                                <span class="badge bg-success-subtle text-success border border-success-subtle ms-1" style="font-size: 16px;">@State.ProfitMargin%</span>
                            </div>
                            <div class="col-12 col-md-3">
                                <span class="text-muted d-block" style="font-size: 16px;">Tổng Tiền Bán Sỉ (Chưa thanh toán):</span>
                                <span class="fs-4 fw-extrabold text-primary" style="font-variant-numeric: tabular-nums;">@State.TotalAmount.ToString("N0") đ</span>
                            </div>
                            <div class="col-12 col-md-3 text-md-end">
                                <button type="button" 
                                        class="btn btn-primary btn-lg w-100 shadow-sm fw-bold d-flex align-items-center justify-content-center gap-2"
                                        disabled="@(!State.SelectedCustomerId.HasValue)"
                                        @onclick="SubmitInvoice"
                                        style="min-height: 48px; border-radius: 12px;">
                                    <i class="bi bi-check-circle-fill"></i>
                                    <span>Xác Nhận Lập Hóa Đơn</span>
                                </button>
                            </div>
                        }
                        else
                        {
                            <div class="col-12 col-md-6">
                                <span class="text-muted d-block" style="font-size: 16px;">Tổng Tiền Bán Sỉ (Chưa thanh toán):</span>
                                <span class="fs-4 fw-extrabold text-primary" style="font-variant-numeric: tabular-nums;">@State.TotalAmount.ToString("N0") đ</span>
                            </div>
                            <div class="col-12 col-md-6 text-md-end">
                                <button type="button" 
                                        class="btn btn-primary btn-lg w-100 shadow-sm fw-bold d-flex align-items-center justify-content-center gap-2"
                                        disabled="@(!State.SelectedCustomerId.HasValue)"
                                        @onclick="SubmitInvoice"
                                        style="min-height: 48px; border-radius: 12px;">
                                    <i class="bi bi-check-circle-fill"></i>
                                    <span>Xác Nhận Lập Hóa Đơn</span>
                                </button>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- =========================================================================
         BƯỚC 3: SẢN PHẨM KHẢ DỤNG TRONG KHO
         ========================================================================= -->
    <div class="card mb-4 border shadow-sm" style="border-radius: 16px; border-color: #e5eaf1 !important; background: #ffffff;">
        <div class="card-header bg-white border-bottom py-3 px-4 d-flex flex-wrap align-items-center justify-content-between gap-3" style="border-color: #e5eaf1 !important;">
            <div class="d-flex align-items-center gap-2">
                <span class="badge bg-primary-subtle text-primary rounded-circle p-2" style="width: 32px; height: 32px; display: inline-flex; align-items: center; justify-content: center; font-weight: bold;">3</span>
                <h6 class="card-title mb-0 fw-bold text-dark fs-6">Chọn Sản Phẩm Khả Dụng Trong Kho</h6>
            </div>
            <div class="d-flex align-items-center gap-2">
                <div class="input-group input-group-sm" style="max-width: 260px;">
                    <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-search"></i></span>
                    <input type="text" class="form-control border-start-0" placeholder="Lọc mã hoặc tên hàng..." 
                           @bind="productSearch" @bind:event="oninput" />
                    @if (!string.IsNullOrEmpty(productSearch))
                    {
                        <button class="btn btn-outline-secondary" @onclick="() => productSearch = string.Empty">
                            <i class="bi bi-x"></i>
                        </button>
                    }
                </div>
                <span class="badge bg-light text-secondary border px-2.5 py-1.5" style="font-size: 16px;">
                    @(filteredProducts?.Count() ?? 0) mặt hàng
                </span>
            </div>
        </div>
        <div class="card-body p-0">
            @if (filteredProducts != null && filteredProducts.Any())
            {
                <div class="table-responsive bg-white" style="background-color: #ffffff !important;">
                    <table class="table table-hover align-middle mb-0 bg-white" style="background-color: #ffffff !important; --bs-table-bg: #ffffff !important;">
                        <thead style="background-color: #f1f5f9 !important;">
                            <tr style="background-color: #f1f5f9 !important;">
                                <th style="width: 60px; font-size: 14.5px; font-weight: 700; color: #334155;" class="text-center">Ảnh</th>
                                <th style="min-width: 100px; font-size: 14.5px; font-weight: 700; color: #334155;">Mã SP</th>
                                <th style="min-width: 200px; font-size: 14.5px; font-weight: 700; color: #334155;">Tên Hàng Hóa</th>
                                <th class="text-center" style="min-width: 70px; font-size: 14.5px; font-weight: 700; color: #334155;">ĐVT</th>
                                @if (!isSales)
                                {
                                    <th class="text-end" style="min-width: 120px; font-size: 14.5px; font-weight: 700; color: #334155;">Giá Nhập (Vốn)</th>
                                }
                                <th class="text-end" style="min-width: 120px; font-size: 14.5px; font-weight: 700; color: #334155;">Giá Bán Sỉ</th>
                                @if (!isSales)
                                {
                                    <th class="text-end" style="min-width: 130px; font-size: 14.5px; font-weight: 700; color: #334155;">Lãi Gộp / SP</th>
                                }
                                <th class="text-center" style="min-width: 90px; font-size: 14.5px; font-weight: 700; color: #334155;">Tồn Kho</th>
                                <th class="text-center" style="width: 120px; font-size: 14.5px; font-weight: 700; color: #334155;">Thao Tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in filteredProducts)
                            {
                                <tr>
                                    <td class="text-center">
                                        <img src="@(string.IsNullOrEmpty(p.ImageUrl) ? "/images/products/sp001-coca-cola.svg" : p.ImageUrl)" 
                                             alt="@p.Name" 
                                             style="width: 40px; height: 40px; object-fit: contain;" 
                                             class="rounded border bg-white p-1 shadow-xs" />
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-secondary border font-monospace px-2 py-1" style="font-size: 16px;">@p.ProductCode</span>
                                    </td>
                                    <td class="fw-semibold text-dark">@p.Name</td>
                                    <td class="text-center text-secondary" style="font-size: 16px;">@p.Unit</td>
                                    @if (!isSales)
                                    {
                                        <td class="text-end text-muted" style="font-size: 16px; font-variant-numeric: tabular-nums;">
                                            @p.CostPrice.ToString("N0") đ
                                        </td>
                                    }
                                    <td class="text-end fw-bold text-primary" style="font-size: 16px; font-variant-numeric: tabular-nums;">
                                        @p.UnitPrice.ToString("N0") đ
                                    </td>
                                    @if (!isSales)
                                    {
                                        <td class="text-end">
                                            <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1" style="font-size: 16px;">
                                                +@p.UnitProfit.ToString("N0") đ (@p.ProfitMargin%)
                                            </span>
                                        </td>
                                    }
                                    <td class="text-center">
                                        <span class="badge @(p.StockQuantity <= 10 ? "bg-warning text-dark" : "bg-success") px-2.5 py-1" style="font-size: 14.5px; font-weight: 600;">
                                            @p.StockQuantity
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        <button type="button" 
                                                class="btn btn-outline-primary btn-sm rounded-pill px-3 fw-semibold" 
                                                @onclick="() => State.AddProduct(p, 1)"
                                                disabled="@(p.StockQuantity <= 0)">
                                            <i class="bi bi-plus-lg me-1"></i>Thêm
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5 text-muted">
                    <i class="bi bi-box-seam fs-1 d-block mb-2 text-secondary"></i>
                    <span>Không tìm thấy sản phẩm nào phù hợp với từ khóa lọc.</span>
                </div>
            }
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "customerId")]
    public int? CustomerIdParam { get; set; }

    private bool isSales = false;
    private IEnumerable<Customer>? customers;
    private IEnumerable<Product>? products;
    private decimal currentDebt;
    private CreditRiskAssessmentDto? customerRisk;
    private string errorMessage = "";
    private string successMessage = "";
    private string productSearch = "";

    private IEnumerable<Product>? filteredProducts =>
        string.IsNullOrWhiteSpace(productSearch)
            ? products
            : products?.Where(p => 
                (p.Name?.Contains(productSearch, StringComparison.OrdinalIgnoreCase) ?? false) || 
                (p.ProductCode?.Contains(productSearch, StringComparison.OrdinalIgnoreCase) ?? false));

    protected override async Task OnInitializedAsync()
    {
        State.OnChange += StateHasChanged;
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        isSales = authState.User.IsInRole("Sales");

        customers = await ViewCustomerListUseCase.ExecuteAsync();
        products = await ViewProductCatalogUseCase.ExecuteAsync();

        if (CustomerIdParam.HasValue && CustomerIdParam.Value > 0)
        {
            var customer = customers?.FirstOrDefault(c => c.Id == CustomerIdParam.Value);
            if (customer != null)
            {
                State.SetCustomer(customer);
                currentDebt = await GetCustomerDebtUseCase.ExecuteAsync(customer.Id);
                try
                {
                    customerRisk = await AssessCreditRiskUseCase.ExecuteAsync(customer.Id);
                }
                catch
                {
                    customerRisk = null;
                }
            }
        }
    }

    public void Dispose()
    {
        State.OnChange -= StateHasChanged;
    }

    private async Task OnCustomerSelected(ChangeEventArgs e)
    {
        errorMessage = "";
        successMessage = "";
        if (int.TryParse(e.Value?.ToString(), out int customerId))
        {
            var customer = customers?.FirstOrDefault(c => c.Id == customerId);
            if (customer != null)
            {
                State.SetCustomer(customer);
                currentDebt = await GetCustomerDebtUseCase.ExecuteAsync(customerId);
                try
                {
                    customerRisk = await AssessCreditRiskUseCase.ExecuteAsync(customerId);
                }
                catch
                {
                    customerRisk = null;
                }
            }
        }
        else
        {
            State.Clear();
            currentDebt = 0;
            customerRisk = null;
        }
    }

    private void HandleIncrement(int productId)
    {
        var item = State.Items.FirstOrDefault(i => i.ProductId == productId);
        if (item != null)
        {
            State.UpdateQuantity(productId, item.Quantity + 1);
        }
    }

    private void HandleDecrement(int productId)
    {
        var item = State.Items.FirstOrDefault(i => i.ProductId == productId);
        if (item != null)
        {
            State.UpdateQuantity(productId, item.Quantity - 1);
        }
    }

    private void HandleRemove(int productId)
    {
        State.RemoveProduct(productId);
    }

    private async Task SubmitInvoice()
    {
        errorMessage = "";
        successMessage = "";

        if (!State.SelectedCustomerId.HasValue)
        {
            errorMessage = "Vui lòng chọn khách hàng trước khi lập hóa đơn.";
            return;
        }

        if (!State.Items.Any())
        {
            errorMessage = "Hóa đơn nháp đang trống. Vui lòng thêm ít nhất một sản phẩm.";
            return;
        }

        try
        {
            var customerId = State.SelectedCustomerId.Value;
            var lines = State.Items.Select(i => new InvoiceLine
            {
                ProductId = i.ProductId,
                Quantity = i.Quantity,
                UnitPrice = i.UnitPrice
            }).ToList();

            var invoiceId = await CreateInvoiceUseCase.ExecuteAsync(customerId, DateTime.Now, lines);
            
            successMessage = $"Lập hóa đơn thành công! Mã hóa đơn: #{invoiceId}. Tồn kho và hạn mức công nợ đã được cập nhật.";
            State.Clear();
            currentDebt = 0;
            customerRisk = null;
            products = await ViewProductCatalogUseCase.ExecuteAsync();
        }
        catch (CreditLimitExceededException ex)
        {
            errorMessage = ex.Message;
        }
        catch (BusinessRuleException ex)
        {
            errorMessage = ex.Message;
        }
        catch (Exception ex)
        {
            errorMessage = $"Đã xảy ra lỗi không xác định: {ex.Message}";
        }
    }
}
