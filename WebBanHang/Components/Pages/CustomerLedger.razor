@page "/customer-ledger"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Accountant")]
@implements IDisposable

@using WebBanHang.UseCases.Customers
@using WebBanHang.UseCases.DTOs
@using WebBanHang.CoreBusiness.Entities
@using WebBanHang.Components.Controls
@using WebBanHang.Services

@inject IViewCustomerListUseCase ViewCustomerListUseCase
@inject IViewCustomerLedgerUseCase ViewCustomerLedgerUseCase
@inject LedgerConfirmationStateService ConfirmationState
@inject IJSRuntime JSRuntime

<PageTitle>Sổ Chi Tiết Công Nợ Khách Hàng</PageTitle>

<div class="app-page-container">
    <PageHeader Title="Sổ Chi Tiết Công Nợ Khách Hàng"
                Subtitle="Tra cứu phát sinh nợ, đối soát thanh toán và in biên bản đối chiếu công nợ chuẩn kế toán"
                Icon="bi-journal-text">
        <Actions>
            @if (ledger != null)
            {
                <button class="btn btn-primary d-flex align-items-center gap-1.5" @onclick="PrintLedger">
                    <i class="bi bi-printer"></i>
                    <span>In Sổ Đối Soát (A4)</span>
                </button>
            }
        </Actions>
    </PageHeader>

    <!-- THANH CHỌN KHÁCH HÀNG & THAO TÁC (ẨN KHI IN) -->
    <div class="card border mb-4 p-3.5 bg-white shadow-sm d-print-none" style="border-radius: 14px; border-color: #e5eaf1 !important;">
        <div class="row g-3 align-items-center">
            <div class="col-12 col-md-6">
                <label class="form-label fw-bold text-dark mb-1" style="font-size: 16px;">
                    <i class="bi bi-person-check text-primary me-1"></i> Chọn Đại Lý / Khách Hàng Cần Tra Cứu Sổ Cái
                </label>
                <select class="form-select" @onchange="OnCustomerSelected" style="min-height: 44px; font-size: 15px;">
                    <option value="0">-- Bấm để chọn đại lý phân phối --</option>
                    @if (customers != null)
                    {
                        @foreach (var c in customers)
                        {
                            <option value="@c.Id" selected="@(c.Id == selectedCustomerId)">
                                @c.FullName (@c.CustomerCode) - ĐT: @c.PhoneNumber
                            </option>
                        }
                    }
                </select>
            </div>
            <div class="col-12 col-md-6 text-md-end pt-md-3">
                @if (ledger != null)
                {
                    <div class="d-flex align-items-center justify-content-md-end gap-2">
                        <span class="badge bg-light text-secondary border px-3 py-2" style="font-size: 16px;">
                            Tổng @ledger.Entries.Count giao dịch phát sinh
                        </span>
                        <button class="btn btn-primary" @onclick="PrintLedger">
                            <i class="bi bi-printer me-1"></i> In Biên Bản Ký Nhận
                        </button>
                    </div>
                }
            </div>
        </div>
    </div>

    @if (customerConfirmation != null)
    {
        <div class="alert alert-success d-flex align-items-center gap-2 mb-3 shadow-xs d-print-none">
            <i class="bi bi-patch-check-fill fs-5 text-success"></i>
            <div>
                <strong>Đại lý đã đối soát & xác nhận khớp số dư điện tử:</strong> Số dư nợ @customerConfirmation.EndingBalance.ToString("N0") đ đã được đại lý xác nhận khớp lúc @customerConfirmation.ConfirmedAt.ToString("HH:mm - dd/MM/yyyy").
            </div>
        </div>
    }

    @if (customerDisputes != null && customerDisputes.Any())
    {
        <div class="alert alert-warning mb-3 shadow-xs d-print-none">
            <div class="fw-bold mb-2"><i class="bi bi-exclamation-triangle-fill text-warning me-1"></i> Có phản ánh lệch số liệu từ đại lý này:</div>
            @foreach (var d in customerDisputes)
            {
                <div class="d-flex align-items-center justify-content-between p-2 rounded bg-white bg-opacity-75 border mb-1">
                    <div class="small text-dark">
                        <strong>[HĐ: @d.InvoiceNumber]</strong> @d.Note 
                        <span class="text-muted ms-1">(@d.ReportedAt.ToString("HH:mm dd/MM/yyyy"))</span>
                    </div>
                    <button type="button" class="btn btn-sm btn-outline-success py-0.5 px-2.5 rounded-pill fw-semibold" 
                            style="font-size: 12px;" 
                            @onclick="() => ResolveDispute(d)">
                        <i class="bi bi-check2-circle me-1"></i>Đã xử lý xong
                    </button>
                </div>
            }
        </div>
    }

    @if (loading)
    {
        <div class="text-center py-5 d-print-none">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="mt-2 text-muted">Đang truy vấn sổ cái công nợ khách hàng...</p>
        </div>
    }
    else if (selectedCustomerId == 0)
    {
        <div class="d-print-none">
            <EmptyState Title="Chưa chọn khách hàng"
                        Description="Vui lòng chọn một đại lý phân phối từ thanh menu phía trên để hiển thị toàn bộ lịch sử phát sinh nợ và thanh toán."
                        Icon="bi-journal-medical" />
        </div>
    }
    else if (ledger != null)
    {
        <!-- 4 THẺ CHỈ SỐ TỔNG HỢP CÔNG NỢ (ẨN KHI IN) -->
        <div class="row g-3 mb-4 d-print-none">
            <div class="col-6 col-lg-3">
                <div class="p-3 rounded-3 bg-white border shadow-xs text-center" style="border-color: #e5eaf1 !important;">
                    <span class="text-muted small fw-semibold text-uppercase" style="font-size: 16px;">Hạn Mức Tín Dụng</span>
                    <div class="fs-5 fw-bold text-dark mt-1" style="font-variant-numeric: tabular-nums;">
                        @ledger.CreditLimit.ToString("N0") đ
                    </div>
                </div>
            </div>
            <div class="col-6 col-lg-3">
                <div class="p-3 rounded-3 bg-white border shadow-xs text-center" style="border-color: #e5eaf1 !important;">
                    <span class="text-muted small fw-semibold text-uppercase" style="font-size: 16px;">Phát Sinh Nợ (+) Mua Hàng</span>
                    <div class="fs-5 fw-bold text-primary mt-1" style="font-variant-numeric: tabular-nums;">
                        +@ledger.TotalDebit.ToString("N0") đ
                    </div>
                </div>
            </div>
            <div class="col-6 col-lg-3">
                <div class="p-3 rounded-3 bg-white border shadow-xs text-center" style="border-color: #e5eaf1 !important;">
                    <span class="text-muted small fw-semibold text-uppercase" style="font-size: 16px;">Phát Sinh Có (-) Đã Nộp</span>
                    <div class="fs-5 fw-bold text-success mt-1" style="font-variant-numeric: tabular-nums;">
                        -@ledger.TotalCredit.ToString("N0") đ
                    </div>
                </div>
            </div>
            <div class="col-6 col-lg-3">
                <div class="p-3 rounded-3 bg-white border shadow-xs text-center" style="border-color: #e5eaf1 !important;">
                    <span class="text-muted small fw-semibold text-uppercase" style="font-size: 16px;">Dư Nợ Cuối Kỳ Còn Lại</span>
                    <div class="fs-5 fw-bold @(ledger.EndingBalance > 0 ? "text-danger" : "text-success") mt-1" style="font-variant-numeric: tabular-nums;">
                        @ledger.EndingBalance.ToString("N0") đ
                    </div>
                </div>
            </div>
        </div>

        <div id="printableInvoiceArea">
            <!-- KHUNG SỔ CHI TIẾT IN ẤN CHUẨN A4 -->
            <div class="card border shadow-sm p-4 bg-white" style="border-radius: 16px; border-color: #e5eaf1 !important;">
                <!-- HEADER THÔNG TIN KHÁCH HÀNG -->
                <div class="row border-bottom pb-3 mb-3">
                    <div class="col-7">
                        <h5 class="fw-bold text-primary mb-1">CÔNG TY CỔ PHẦN CÔNG NGHỆ & THƯƠNG MẠI ECO2415</h5>
                        <div class="small fw-semibold text-dark">SỔ CHI TIẾT CÔNG NỢ PHẢI THU KHÁCH HÀNG (TK 131)</div>
                        <div class="small text-muted">Thời điểm kết xuất: @DateTime.Now.ToString("dd/MM/yyyy HH:mm") • Đơn vị tính: VNĐ</div>
                    </div>
                    <div class="col-5 text-end">
                        <h6 class="fw-bold text-dark mb-1">@ledger.CustomerName</h6>
                        <div class="small">Mã khách hàng: <strong>@ledger.CustomerCode</strong></div>
                        <div class="small">Số điện thoại: @ledger.CustomerPhone</div>
                        <div class="small">Hạn mức nợ được cấp: <strong>@ledger.CreditLimit.ToString("N0") đ</strong></div>
                    </div>
                </div>

                <!-- BẢNG GIAO DỊCH LŨY KẾ -->
                <div class="table-responsive border mb-4 bg-white" style="border-radius: 14px; border-color: #e5eaf1 !important; background-color: #ffffff !important;">
                    <table class="table table-bordered table-hover align-middle mb-0 bg-white" style="background-color: #ffffff !important; --bs-table-bg: #ffffff !important;">
                        <thead class="text-center" style="background-color: #f1f5f9 !important;">
                            <tr style="background-color: #f1f5f9 !important;">
                                <th style="width: 120px; font-size: 14.5px; font-weight: 700; color: #334155; background-color: #f1f5f9 !important;">Ngày</th>
                                <th style="width: 120px; font-size: 14.5px; font-weight: 700; color: #334155; background-color: #f1f5f9 !important;">Chứng Từ</th>
                                <th style="width: 140px; font-size: 14.5px; font-weight: 700; color: #334155; background-color: #f1f5f9 !important;">Số Hiệu</th>
                                <th style="font-size: 14.5px; font-weight: 700; color: #334155; background-color: #f1f5f9 !important;">Diễn Giải Giao Dịch</th>
                                <th style="width: 150px; font-size: 14.5px; font-weight: 700; color: #334155; background-color: #f1f5f9 !important;" class="text-end">Phát Sinh Nợ (+)</th>
                                <th style="width: 150px; font-size: 14.5px; font-weight: 700; color: #334155; background-color: #f1f5f9 !important;" class="text-end">Phát Sinh Có (-)</th>
                                <th style="width: 160px; font-size: 14.5px; font-weight: 700; color: #334155; background-color: #f1f5f9 !important;" class="text-end">Dư Nợ Lũy Kế</th>
                            </tr>
                        </thead>
                        <tbody style="background-color: #ffffff !important; color: #0f172a !important;">
                            @if (ledger.Entries.Any())
                            {
                                @foreach (var entry in ledger.Entries)
                                {
                                    <tr style="background-color: #ffffff !important;">
                                        <td class="text-center" style="font-size: 16px; color: #0f172a; background-color: #ffffff !important;">@entry.TransactionDate.ToString("dd/MM/yyyy")</td>
                                        <td class="text-center" style="background-color: #ffffff !important;">
                                            @if (entry.DocumentType == "Hóa Đơn")
                                            {
                                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2.5 py-1" style="font-size: 14px; font-weight: 600;">Hóa Đơn</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-success-subtle text-success border border-success-subtle px-2.5 py-1" style="font-size: 14px; font-weight: 600;">Phiếu Thu</span>
                                            }
                                        </td>
                                        <td class="fw-bold font-monospace text-dark" style="font-size: 16px; background-color: #ffffff !important;">@entry.DocumentNumber</td>
                                        <td style="font-size: 16px; color: #0f172a; background-color: #ffffff !important;">@entry.Description</td>
                                        <td class="text-end text-primary fw-semibold" style="font-size: 16px; font-variant-numeric: tabular-nums; background-color: #ffffff !important;">
                                            @(entry.Debit > 0 ? entry.Debit.ToString("N0") + " đ" : "-")
                                        </td>
                                        <td class="text-end text-success fw-semibold" style="font-size: 16px; font-variant-numeric: tabular-nums; background-color: #ffffff !important;">
                                            @(entry.Credit > 0 ? entry.Credit.ToString("N0") + " đ" : "-")
                                        </td>
                                        <td class="text-end fw-bold @(entry.RunningBalance > 0 ? "text-danger" : "text-dark")" style="font-size: 16px; font-variant-numeric: tabular-nums; background-color: #ffffff !important;">
                                            @entry.RunningBalance.ToString("N0") đ
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr style="background-color: #ffffff !important;">
                                    <td colspan="7" class="text-center py-5 text-muted" style="background-color: #ffffff !important; font-size: 15px;">
                                        Khách hàng chưa có giao dịch phát sinh nào trong hệ thống.
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot style="background-color: #f8fafc !important; font-weight: 700;">
                            <tr style="background-color: #f8fafc !important;">
                                <td colspan="4" class="text-end text-dark" style="font-size: 16px; font-weight: 700; background-color: #f8fafc !important;">TỔNG PHÁT SINH TRONG KỲ:</td>
                                <td class="text-end text-primary" style="font-size: 16px; font-weight: 700; font-variant-numeric: tabular-nums; background-color: #f8fafc !important;">+@ledger.TotalDebit.ToString("N0") đ</td>
                                <td class="text-end text-success" style="font-size: 16px; font-weight: 700; font-variant-numeric: tabular-nums; background-color: #f8fafc !important;">-@ledger.TotalCredit.ToString("N0") đ</td>
                                <td></td>
                            </tr>
                            <tr class="table-warning">
                                <td colspan="4" class="text-end text-danger" style="font-size: 16px; font-weight: 700;">SỐ DƯ NỢ CUỐI KỲ CẦN THU HỒI:</td>
                                <td colspan="3" class="text-end text-danger" style="font-size: 18px; font-weight: 700; font-variant-numeric: tabular-nums;">
                                    @ledger.EndingBalance.ToString("N0") đ
                                </td>
                            </tr>
                        </tfoot>
                    </table>
                </div>

                <!-- CHỮ KÝ BIÊN BẢN ĐỐI SOÁT CÔNG NỢ -->
                <div class="row text-center mt-4 pt-3 border-top">
                    <div class="col-6">
                        <div class="fw-bold">ĐẠI DIỆN KHÁCH HÀNG</div>
                        <div class="text-muted small fst-italic">(Ký, ghi rõ họ tên và đóng dấu xác nhận)</div>
                        <div style="height: 70px;"></div>
                        <div class="fw-bold text-dark">@ledger.CustomerName</div>
                    </div>
                    <div class="col-6">
                        <div class="fw-bold">ĐẠI DIỆN PHÒNG KẾ TOÁN ECO2415</div>
                        <div class="text-muted small fst-italic">(Ký, ghi rõ họ tên và đóng dấu)</div>
                        <div style="height: 70px;"></div>
                        <div class="fw-bold text-primary">Kế Toán Công Nợ</div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "customerId")]
    public int? CustomerIdParam { get; set; }

    private IEnumerable<Customer>? customers;
    private int selectedCustomerId = 0;
    private CustomerLedgerDto? ledger;
    private bool loading = false;
    private CustomerLedgerConfirmation? customerConfirmation;
    private List<CustomerLedgerDispute> customerDisputes = new();

    protected override async Task OnInitializedAsync()
    {
        ConfirmationState.OnChange += OnConfirmationStateChanged;
        customers = await ViewCustomerListUseCase.ExecuteAsync();
        if (CustomerIdParam.HasValue && CustomerIdParam.Value > 0)
        {
            selectedCustomerId = CustomerIdParam.Value;
            await LoadLedger();
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (CustomerIdParam.HasValue && CustomerIdParam.Value > 0 && CustomerIdParam.Value != selectedCustomerId)
        {
            selectedCustomerId = CustomerIdParam.Value;
            await LoadLedger();
        }
    }

    private void ResolveDispute(CustomerLedgerDispute d)
    {
        ConfirmationState.ResolveDispute(d.CustomerId, d.InvoiceNumber);
        customerDisputes = ConfirmationState.GetDisputes(selectedCustomerId);
    }

    private async Task OnCustomerSelected(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int cId))
        {
            selectedCustomerId = cId;
            await LoadLedger();
        }
        else
        {
            selectedCustomerId = 0;
            ledger = null;
        }
    }

    private async Task LoadLedger()
    {
        if (selectedCustomerId <= 0)
        {
            ledger = null;
            return;
        }

        loading = true;
        try
        {
            ledger = await ViewCustomerLedgerUseCase.ExecuteAsync(selectedCustomerId);
            customerConfirmation = ConfirmationState.GetConfirmation(selectedCustomerId);
            customerDisputes = ConfirmationState.GetDisputes(selectedCustomerId);
        }
        finally
        {
            loading = false;
        }
    }

    private async Task PrintLedger()
    {
        await JSRuntime.InvokeVoidAsync("window.print");
    }

    private async void OnConfirmationStateChanged()
    {
        if (selectedCustomerId > 0)
        {
            customerConfirmation = ConfirmationState.GetConfirmation(selectedCustomerId);
            customerDisputes = ConfirmationState.GetDisputes(selectedCustomerId);
            await InvokeAsync(StateHasChanged);
        }
    }

    public void Dispose()
    {
        ConfirmationState.OnChange -= OnConfirmationStateChanged;
    }
}
