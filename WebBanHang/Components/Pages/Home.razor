@page "/dashboard"

@attribute [Authorize]

@rendermode InteractiveServer



@using WebBanHang.UseCases.Dashboard

@using WebBanHang.UseCases.DTOs

@using WebBanHang.CoreBusiness.Entities

@using Microsoft.AspNetCore.Components.Authorization

@using WebBanHang.Services



@inject IGetDashboardDataUseCase GetDashboardDataUseCase

@inject NavigationManager Navigation

@inject AuthenticationStateProvider AuthStateProvider

@inject LayoutStateService LayoutState

@implements IDisposable



<PageTitle>Tổng Quan - Phân Hệ Bán Hàng & Quản Trị Công Nợ B2B</PageTitle>



@if (loading)

{

    <div class="d-flex flex-column align-items-center justify-content-center py-5 my-5">

        <div class="spinner-border text-success" role="status" style="width: 3rem; height: 3rem;">

            <span class="visually-hidden">Đang nạp dữ liệu...</span>

        </div>

        <p class="mt-3 text-muted small fw-semibold">Đang tổng hợp số liệu kế toán & công nợ từ hệ thống...</p>

    </div>

}

else if (dashboard != null)

{

    <div class="app-page-container">

        <!-- =========================================================================

             1. UNIFIED PAGE HEADER & EXECUTIVE ACTIONS (STRIPE / LINEAR STYLE)

             ========================================================================= -->

        <PageHeader Title="Tổng Quan Hoạt Động"

                    Subtitle="Phân hệ Bán hàng & Quản trị Công nợ B2B — Bàn làm việc điều hành"

                    Icon="bi-grid-fill">

            <Actions>

                <!-- Period Selector Dropdown -->

                <div class="d-flex align-items-center gap-2 bg-white rounded-3 px-3 py-1.5 border shadow-sm">

                    <i class="bi bi-calendar3 text-muted"></i>

                    <select class="form-select border-0 bg-transparent py-0 fw-semibold" @onchange="OnPeriodChanged" value="@selectedPeriod" style="min-height: auto; width: auto;">

                        <option value="today">Hôm nay</option>

                        <option value="this_week">Tuần này</option>

                        <option value="this_month">Tháng này</option>

                        <option value="this_quarter">Quý này</option>

                        <option value="this_year">Năm nay</option>

                    </select>

                </div>



                <!-- Date Range Indicator -->

                <span class="badge bg-light text-secondary border fw-normal py-2 px-3 d-none d-lg-inline-block" style="font-size: 15px;">

                    @periodStartDate.ToString("dd/MM/yyyy") - @periodEndDate.ToString("dd/MM/yyyy")

                </span>



                <!-- Action Toolbar Buttons -->

                <button class="btn btn-secondary d-flex align-items-center gap-1.5" 

                        title="Làm mới dữ liệu (F5)" 

                        @onclick="LoadDashboard">

                    <i class="bi bi-arrow-clockwise @(isRefreshing ? "spin-animate" : "")"></i>

                    <span class="d-none d-sm-inline">Làm mới</span>

                </button>



                <button class="btn btn-secondary d-flex align-items-center gap-1.5" 

                        title="Tùy chỉnh bàn làm việc" 

                        @onclick="ToggleCustomizeModal">

                    <i class="bi bi-sliders2"></i>

                    <span class="d-none d-md-inline">Tùy chỉnh</span>

                </button>



                <button class="btn btn-primary d-flex align-items-center gap-1.5" 

                        title="In báo cáo tổng quan" 

                        @onclick="PrintOverview">

                    <i class="bi bi-printer"></i>

                    <span class="d-none d-sm-inline">In báo cáo</span>

                </button>

            </Actions>

        </PageHeader>



        <!-- =========================================================================

             2. EXECUTIVE KPI STAT CARDS (4 CHỈ SỐ TRỌNG YẾU CHUẨN STRIPE)

             ========================================================================= -->

        <div class="row g-4 mb-4">

            <!-- KPI 1: TỔNG DOANH THU BÁN HÀNG -->

            <div class="col-12 col-sm-6 col-xl-3">

                <StatCard Label="DOANH THU BÁN HÀNG"

                          Value="@((dashboard.TotalRevenue / 1000000m).ToString("N2"))"

                          Unit="Trđ"

                          Trend="@dashboard.PreviousPeriodComparisonText"

                          Hint="@($"{dashboard.TotalInvoicesCount} hóa đơn ↗")"

                          Tone="primary"

                          Icon="bi-cash-coin"

                          OnClick="@(() => Navigation.NavigateTo("/invoices"))" />

            </div>



            <!-- KPI 2: TIỀN THỰC THU -->

            <div class="col-12 col-sm-6 col-xl-3">

                <StatCard Label="TIỀN ĐÃ THU VỀ"

                          Value="@((dashboard.TotalCollectedAmount / 1000000m).ToString("N2"))"

                          Unit="Trđ"

                          Trend="@($"{collectionRate:N1}% thu hồi")"

                          Hint="Gạch nợ FIFO ↗"

                          Tone="success"

                          Icon="bi-wallet2"

                          OnClick="@(() => Navigation.NavigateTo("/payments"))" />

            </div>



            <!-- KPI 3: TỔNG NỢ PHẢI THU (TK 131) -->

            <div class="col-12 col-sm-6 col-xl-3">

                <StatCard Label="NỢ PHẢI THU (TK 131)"

                          Value="@((dashboard.TotalOutstandingDebt / 1000000m).ToString("N2"))"

                          Unit="Trđ"

                          Trend="@($"{dashboard.TotalDebtorsCount}/{dashboard.TotalCustomersCount} KH")"

                          Hint="Báo cáo tuổi nợ ↗"

                          Tone="warning"

                          Icon="bi-clock-history"

                          OnClick="@(() => Navigation.NavigateTo("/aging-report"))" />

            </div>



            <!-- KPI 4: NỢ QUÁ HẠN (CẢNH BÁO) -->

            <div class="col-12 col-sm-6 col-xl-3">

                <StatCard Label="NỢ QUÁ HẠN (CẢNH BÁO)"

                          Value="@((overdueDebt / 1000000m).ToString("N2"))"

                          Unit="Trđ"

                          Trend="@($"{dashboard.OverdueInvoicesCount} HĐ quá hạn")"

                          Hint="@($"{overduePercent:N1}% tổng nợ ↗")"

                          Tone="danger"

                          Icon="bi-exclamation-triangle-fill"

                          OnClick="@(() => Navigation.NavigateTo("/aging-report"))" />

            </div>

        </div>



    <!-- =========================================================================

         3. AVA AI EXECUTIVE COPILOT BANNER & 3 INSIGHT CARDS

         ========================================================================= -->

    <div class="app-announcement-bar d-flex align-items-center justify-content-between p-2 px-3 mb-2 rounded bg-white border shadow-xs">

        <div class="d-flex align-items-center gap-2 small">

            <span class="badge bg-danger text-white px-2 py-0.5 rounded-pill" style="font-size: 14px; font-weight: 700;">MỚI</span>

            <span class="fw-semibold text-slate-navy">Khám phá Trợ lý AI AVA Kế toán:</span>

            <span class="text-muted d-none d-md-inline">Tự động phân tích sức khỏe tài chính, giám sát tuổi nợ 4 xô và cảnh báo hạn mức bán hàng</span>

        </div>

        <button class="btn btn-link btn-sm p-0 text-decoration-none fw-bold text-success d-flex align-items-center gap-1" 

                @onclick="OpenAvaAnalysisModal">

            <span>Bắt đầu sử dụng</span>

            <i class="bi bi-arrow-right-short fs-5"></i>

        </button>

    </div>



    <div class="app-insight-banner mb-3 shadow-xs">

        <div class="d-flex align-items-center justify-content-between mb-2.5">

            <div class="d-flex align-items-center gap-2">

                <img src="/images/ava-avatar.svg" alt="AVA AI" style="width: 28px; height: 28px; border-radius: 50%;" />

                <div>

                    <span class="fw-bold text-slate-navy small">Phân Tích Tài Chính Thông Minh Với AVA</span>

                    <span class="text-muted ms-2 small d-none d-md-inline" style="font-size: 15px;">• Cập nhật theo thời gian thực</span>

                </div>

            </div>

            <div class="d-flex align-items-center gap-2">

                <button class="btn btn-sm btn-white border shadow-xs py-1.5 px-3 fw-semibold text-primary d-flex align-items-center gap-1.5" 
                        style="font-size: 15px; color: #2563eb !important; background-color: #eff6ff !important; border-color: #bfdbfe !important;"
                        @onclick="OpenAvaAnalysisModal">

                    <i class="bi bi-stars text-primary"></i>

                    <span>Phân tích với AVA</span>

                </button>

                <button class="btn btn-sm btn-white border shadow-xs py-1 px-2.5 small fw-semibold text-muted" 

                        @onclick="ToggleCustomizeModal">

                    <i class="bi bi-pencil me-1"></i> Tùy chỉnh

                </button>

            </div>

        </div>



        <!-- 3 Insight Cards -->

        <div class="row g-2.5">

            <!-- Insight 1: Doanh thu & Lợi nhuận -->

            <div class="col-12 col-md-4">

                <div class="app-insight-card">

                    <div class="mb-2">

                        <div class="d-flex align-items-center gap-1 text-success fw-bold small mb-1">

                            <i class="bi bi-graph-up-arrow"></i>

                            <span>Biên Lợi Nhuận Doanh Số</span>

                        </div>

                        <p class="text-muted mb-0 small" style="font-size: 15px; line-height: 1.5;">

                            Tổng doanh thu đạt <strong>@((dashboard.TotalRevenue / 1000000m).ToString("N1")) triệu đồng</strong>. Lợi nhuận gộp thực tế đạt <strong>+@((actualProfit / 1000000m).ToString("N1")) trđ (@profitMargin%)</strong>, duy trì tỷ suất sinh lời an toàn.

                        </p>

                    </div>

                    <a href="/invoices" class="fw-bold text-decoration-none text-primary" style="font-size: 15px;">

                        Phân tích chuyên sâu <i class="bi bi-chevron-right ms-0.5"></i>

                    </a>

                </div>

            </div>



            <!-- Insight 2: Rủi ro tập trung công nợ KH -->

            <div class="col-12 col-md-4">

                <div class="app-insight-card">

                    <div class="mb-2">

                        <div class="d-flex align-items-center gap-1 text-warning fw-bold small mb-1">

                            <i class="bi bi-pie-chart-fill"></i>

                            <span>Tập Trung Công Nợ Khách Hàng</span>

                        </div>

                        <p class="text-muted mb-0 small" style="font-size: 15px; line-height: 1.5;">

                            @{

                                var debtorCount = dashboard.TopDebtors.Count;

                                var debtorLabel = debtorCount < 5 ? $"{debtorCount} KH đang nợ" : "Top 5 KH nợ lớn nhất";

                            }

                            Tổng công nợ @debtorLabel chiếm <strong>@(top5DebtPercentage.ToString("N1"))%</strong> tổng nợ phải thu. Nguồn thu phụ thuộc vào nhóm đại lý trọng điểm, cần giám sát chặt chẽ trần tín dụng.

                        </p>

                    </div>

                    <a href="/aging-report" class="fw-bold text-decoration-none text-primary" style="font-size: 15px;">

                        Phân tích chuyên sâu <i class="bi bi-chevron-right ms-0.5"></i>

                    </a>

                </div>

            </div>



            <!-- Insight 3: Kiểm soát rủi ro tuổi nợ -->

            <div class="col-12 col-md-4">

                <div class="app-insight-card">

                    <div class="mb-2">

                        <div class="d-flex align-items-center gap-1 text-primary fw-bold small mb-1">

                            <i class="bi bi-shield-check"></i>

                            <span>Kiểm Soát Tuổi Nợ & Thu Hồi</span>

                        </div>

                        <p class="text-muted mb-0 small" style="font-size: 15px; line-height: 1.5;">

                            Tổng nợ <strong>@((dashboard.TotalOutstandingDebt / 1000000m).ToString("N1")) trđ</strong>. Tỷ lệ nợ quá hạn ở mức <strong>@(overduePercent.ToString("N1"))%</strong>. Khuyến nghị kế toán ưu tiên cấn trừ thu nợ theo nguyên tắc FIFO.

                        </p>

                    </div>

                    <a href="/payments" class="fw-bold text-decoration-none text-primary" style="font-size: 15px;">

                        Phân tích chuyên sâu <i class="bi bi-chevron-right ms-0.5"></i>

                    </a>

                </div>

            </div>

        </div>

    </div>



    <!-- =========================================================================

         4. MAIN DASHBOARD GRID (ROW 1: TÀI CHÍNH, NỢ THEO HẠN, DÒNG TIỀN)

         ========================================================================= -->

    <div class="row g-3 mb-3">

        <!-- CARD 1: TÌNH HÌNH TÀI CHÍNH (DOANH THU - CHI PHÍ - LỢI NHUẬN) -->

        <div class="col-12 col-lg-4">

            <div class="app-card">

                <div class="app-card-header">

                    <h6 class="app-card-title">

                        <i class="bi bi-cash-coin text-success"></i> Tình hình tài chính

                    </h6>

                    <div class="d-flex align-items-center gap-2">

                        <span class="badge bg-light text-secondary border small">@selectedPeriodText</span>

                        <span class="text-muted small" style="font-size: 15px;">Đvt: Trđ</span>

                    </div>

                </div>



                <div class="app-card-body d-flex flex-column justify-content-center">

                    <div class="app-metric-row">

                        <span class="text-slate-navy fw-semibold">Doanh thu thuần</span>

                        <span class="app-metric-val-blue">@((dashboard.TotalRevenue / 1000000m).ToString("N3"))</span>

                    </div>

                    <div class="app-metric-row">

                        <span class="text-slate-navy fw-semibold">Giá vốn hàng bán (COGS)</span>

                        <span class="app-metric-val-dark text-danger">@((actualCost / 1000000m).ToString("N3"))</span>

                    </div>

                    <div class="app-metric-row">

                        <span class="text-slate-navy fw-semibold">Lợi nhuận gộp thực tế</span>

                        <span class="app-metric-val-green">@((actualProfit / 1000000m).ToString("N3"))</span>

                    </div>

                    <div class="app-metric-row">

                        <span class="text-slate-navy fw-semibold">Tổng vốn tồn kho đang chôn</span>

                        <span class="app-metric-val-blue">@((dashboard.TotalInventoryCost / 1000000m).ToString("N3"))</span>

                    </div>



                    <!-- Profitability Ratio Progress Bar -->

                    <div class="mt-3 pt-2 border-top">

                        <div class="d-flex justify-content-between small text-muted mb-1" style="font-size: 15px;">

                            <span>Tỷ suất lợi nhuận gộp:</span>

                            <span class="fw-bold text-success">@(profitMargin.ToString("N1"))%</span>

                        </div>

                        <div class="progress" style="height: 10px; border-radius: 6px;">

                            <div class="progress-bar bg-success rounded-pill" style="width: @(Math.Min(100, Math.Max(5, profitMargin)))%"></div>

                            <div class="progress-bar bg-secondary-subtle rounded-pill" style="width: @(Math.Max(0, 100 - profitMargin))%"></div>

                        </div>

                    </div>

                </div>



                <div class="app-card-footer">

                    <span>Số liệu tính đến: @lastUpdated.ToString("HH:mm")</span>

                    <a href="javascript:void(0)" @onclick="LoadDashboard" class="text-primary fw-bold text-decoration-none">Tải lại</a>

                </div>

            </div>

        </div>



        <!-- CARD 2: NỢ PHẢI THU THEO HẠN NỢ (Enterprise AGING SIGNATURE WIDGET) -->

        <div class="col-12 col-lg-4">

            <div class="app-card">

                <div class="app-card-header">

                    <h6 class="app-card-title">

                        <i class="bi bi-wallet2 text-warning"></i> Nợ phải thu theo hạn nợ

                    </h6>

                    <span class="text-muted small" style="font-size: 15px;">Đvt: Trđ</span>

                </div>



                <div class="app-card-body d-flex flex-column justify-content-between">

                    <div>

                        <div class="mb-2.5">

                            <div class="text-muted" style="font-size: 16px;">Tổng nợ phải thu</div>

                            <div class="fw-bold text-slate-navy" style="font-size: 32px; line-height: 1.2; font-variant-numeric: tabular-nums;">

                                @((dashboard.TotalOutstandingDebt / 1000000m).ToString("N1")) <small class="fs-6 fw-normal text-muted">Triệu đồng</small>

                            </div>

                        </div>



                        <div class="d-flex justify-content-between align-items-center mb-2.5">

                            <div>

                                <div class="text-muted" style="font-size: 16px;">Quá hạn</div>

                                <div class="fw-bold text-orange" style="color: #ff7700; font-size: 22px; font-variant-numeric: tabular-nums;">

                                    @((overdueDebt / 1000000m).ToString("N1")) <small class="fw-normal fs-6">Trđ</small>

                                </div>

                            </div>

                            <div class="text-end">

                                <div class="text-muted" style="font-size: 16px;">Trong Hạn</div>

                                <div class="fw-bold text-secondary" style="font-size: 22px; font-variant-numeric: tabular-nums;">

                                    @((withinTermDebt / 1000000m).ToString("N1")) <small class="fw-normal fs-6">Trđ</small>

                                </div>

                            </div>

                        </div>



                        <!-- Dual Tone Progress Bar -->

                        <div class="app-debt-bar mb-1.5">

                            <div class="app-debt-bar-overdue" style="width: @(overdueBarWidth)%;" title="Quá hạn: @overdueBarWidth.ToString("N1")%"></div>

                            <div class="app-debt-bar-current" style="width: @(currentBarWidth)%;" title="Trong hạn: @currentBarWidth.ToString("N1")%"></div>

                        </div>



                        <div class="d-flex justify-content-between text-muted mb-3" style="font-size: 15px;">

                            <span><i class="bi bi-circle-fill me-1" style="color: #ff7700; font-size: 14px;"></i>Quá hạn (@overdueBarWidth.ToString("N0")%)</span>

                            <span><i class="bi bi-circle-fill me-1 text-secondary" style="font-size: 15px;"></i>Trong hạn (@currentBarWidth.ToString("N0")%)</span>

                        </div>

                    </div>



                    <!-- Breakdown Table 5 Buckets (Single Source of Truth) -->

                    <div class="border rounded p-2 bg-light-subtle">

                        <div class="d-flex justify-content-between small text-muted mb-1" style="font-size: 15px;">

                            <span><i class="bi bi-shield-check text-success me-1"></i>Chưa đến hạn:</span>

                            <span class="fw-bold text-slate-navy">@((dashboard.OverallAging.BucketNotDue / 1000000m).ToString("N1")) Trđ</span>

                        </div>

                        <div class="d-flex justify-content-between small text-muted mb-1" style="font-size: 15px;">

                            <span><i class="bi bi-clock-history text-info me-1"></i>Quá hạn 1 - 30 ngày:</span>

                            <span class="fw-bold text-info">@((dashboard.OverallAging.Bucket1To30 / 1000000m).ToString("N1")) Trđ</span>

                        </div>

                        <div class="d-flex justify-content-between small text-muted mb-1" style="font-size: 15px;">

                            <span><i class="bi bi-exclamation-circle text-warning me-1"></i>Quá hạn 31 - 60 ngày:</span>

                            <span class="fw-bold text-warning">@((dashboard.OverallAging.Bucket31To60 / 1000000m).ToString("N1")) Trđ</span>

                        </div>

                        <div class="d-flex justify-content-between small text-muted mb-1" style="font-size: 15px;">

                            <span><i class="bi bi-exclamation-triangle text-orange me-1"></i>Quá hạn 61 - 90 ngày:</span>

                            <span class="fw-bold text-orange" style="color: #ff7700;">@((dashboard.OverallAging.Bucket61To90 / 1000000m).ToString("N1")) Trđ</span>

                        </div>

                        <div class="d-flex justify-content-between small text-muted" style="font-size: 15px;">

                            <span><i class="bi bi-x-octagon text-danger me-1"></i>Quá hạn > 90 ngày:</span>

                            <span class="fw-bold text-danger">@((dashboard.OverallAging.BucketOver90 / 1000000m).ToString("N1")) Trđ</span>

                        </div>

                        @if (!dashboard.OverallAging.IsIntegrityValid)

                        {

                            <div class="alert alert-danger py-1 px-2 mt-2 mb-0 small text-center" style="font-size: 15px;">

                                <i class="bi bi-exclamation-octagon-fill me-1"></i> Cảnh báo: Lệch số liệu giữa các xô và tổng nợ!

                            </div>

                        }

                    </div>

                </div>



                <div class="app-card-footer">

                    <span>Số liệu tính đến: @lastUpdated.ToString("HH:mm")</span>

                    <a href="/aging-report" class="text-primary fw-bold text-decoration-none">Báo cáo phân tích tuổi nợ ↗</a>

                </div>

            </div>

        </div>



        <!-- CARD 3: DÒNG TIỀN & THỰC THU VS. DOANH SỐ -->

        <div class="col-12 col-lg-4">

            <div class="app-card">

                <div class="app-card-header">

                    <h6 class="app-card-title">

                        <i class="bi bi-arrow-left-right text-primary"></i> Dòng tiền: Bán chịu & Thu tiền

                    </h6>

                    <span class="text-muted small" style="font-size: 15px;">Đvt: Trđ</span>

                </div>



                <div class="app-card-body d-flex flex-column justify-content-between">

                    <div>

                        <div class="d-flex align-items-center justify-content-between mb-2.5">

                            <div>

                                <span class="text-muted" style="font-size: 16px;">Doanh số bán chịu:</span>

                                <div class="fw-bold text-primary" style="font-size: 26px; font-variant-numeric: tabular-nums;">@((dashboard.TotalRevenue / 1000000m).ToString("N1")) <small class="fs-6 fw-normal">Trđ</small></div>

                            </div>

                            <div class="text-end">

                                <span class="text-muted" style="font-size: 16px;">Tiền thu về (FIFO):</span>

                                <div class="fw-bold text-success" style="font-size: 26px; font-variant-numeric: tabular-nums;">@((dashboard.TotalCollectedAmount / 1000000m).ToString("N1")) <small class="fs-6 fw-normal">Trđ</small></div>

                            </div>

                        </div>



                        <!-- Mini Dual Bar Graphic (Upgraded Size) -->

                        <div class="bg-light rounded-3 p-3 mb-2.5 border">

                            <div class="d-flex align-items-end justify-content-around" style="height: 160px;">

                                @if (dashboard.MonthlyRevenues.Any())

                                {

                                    var maxVal = Math.Max(1m, dashboard.MonthlyRevenues.Max(m => Math.Max(m.Revenue, m.Collected)));

                                    @foreach (var m in dashboard.MonthlyRevenues.TakeLast(6))

                                    {

                                        var revHeight = Math.Max(12, (int)((m.Revenue / maxVal) * 125));

                                        var colHeight = Math.Max(12, (int)((m.Collected / maxVal) * 125));

                                        <div class="d-flex flex-column align-items-center gap-1.5">

                                            <div class="d-flex align-items-end gap-1.5" style="height: 125px;">

                                                <div class="bg-primary rounded-top shadow-xs" style="width: 18px; height: @(revHeight)px;" title="Doanh thu: @((m.Revenue / 1000000m).ToString("N1")) Trđ"></div>

                                                <div class="bg-success rounded-top shadow-xs" style="width: 18px; height: @(colHeight)px;" title="Thu tiền: @((m.Collected / 1000000m).ToString("N1")) Trđ"></div>

                                            </div>

                                            <span class="text-secondary fw-bold" style="font-size: 15px;">@m.MonthLabel</span>

                                        </div>

                                    }

                                }

                            </div>

                            <div class="d-flex justify-content-center gap-4 mt-2" style="font-size: 15px; font-weight: 600;">

                                <span><span class="app-dot bg-primary"></span> Bán ra</span>

                                <span><span class="app-dot bg-success"></span> Thu tiền về</span>

                            </div>

                        </div>

                    </div>



                    @if (dashboard.TotalCollectedAmount > 0)

                    {

                        <div class="alert alert-success py-1.5 px-2.5 mb-0 small border-0 bg-success-subtle d-flex align-items-center gap-2">

                            <i class="bi bi-shield-check text-success fs-5"></i>

                            <span style="font-size: 15px;">

                                Đã thu hồi <strong>@collectionRate.ToString("N1")%</strong> doanh số. Dòng tiền kinh doanh thặng dư dương.

                            </span>

                        </div>

                    }

                    else

                    {

                        <div class="alert alert-warning py-1.5 px-2.5 mb-0 small border-0 bg-warning-subtle d-flex align-items-center gap-2">

                            <i class="bi bi-exclamation-triangle text-warning fs-5"></i>

                            <span style="font-size: 15px;">

                                Chưa phát sinh thu hồi công nợ trong kỳ (@collectionRate.ToString("N1")%). Cần theo dõi chặt chẽ hạn nợ.

                            </span>

                        </div>

                    }

                </div>



                <div class="app-card-footer">

                    <span>Cấn trừ tự động theo FIFO</span>

                    <a href="/payments" class="text-primary fw-bold text-decoration-none">Thu nợ ngay ↗</a>

                </div>

            </div>

        </div>

    </div>



    <!-- =========================================================================

         5. ROW 2: DOANH THU/CHI PHÍ/LỢI NHUẬN (INTERACTIVE Enterprise BAR & LINE CHART)

         ========================================================================= -->

    <div class="row g-3 mb-3">

        <!-- CARD 4: DOANH THU, CHI PHÍ, LỢI NHUẬN (INTERACTIVE 12-MONTH Enterprise CHART) -->

        <div class="col-12 col-xl-7">

            <div class="app-card position-relative">

                <div class="app-card-header">

                    <h6 class="app-card-title">

                        <i class="bi bi-graph-up text-primary"></i> Doanh thu, chi phí, lợi nhuận

                    </h6>

                    <div class="d-flex align-items-center gap-2">

                        <i class="bi bi-stars text-purple" title="Phân tích AI"></i>

                        <i class="bi bi-arrow-clockwise text-muted cursor-pointer" title="Làm mới biểu đồ" @onclick="LoadDashboard"></i>

                        <select class="app-dropdown-filter">

                            <option>Năm nay</option>

                            <option>Năm trước</option>

                        </select>

                    </div>

                </div>



                <div class="app-card-body p-3">

                    <!-- Top stats summary (Matching Enterprise Screenshot 4 & 5) -->

                    <div class="d-flex align-items-center gap-4 mb-3 pb-2 border-bottom">

                        <div>

                            <span class="text-muted d-block fw-bold" style="font-size: 14.5px; letter-spacing: 0.5px;">DOANH THU</span>

                            <span class="fw-bold" style="color: #00b060; font-size: 26px; font-variant-numeric: tabular-nums;">

                                @((chartTotalRevenue / 1000000m).ToString("N3")) <small class="fw-normal text-muted fs-6">Triệu đồng</small>

                            </span>

                        </div>

                        <div>

                            <span class="text-muted d-block fw-bold" style="font-size: 14.5px; letter-spacing: 0.5px;">CHI PHÍ</span>

                            <span class="fw-bold text-slate-navy" style="font-size: 26px; font-variant-numeric: tabular-nums;">

                                @((chartTotalCost / 1000000m).ToString("N3")) <small class="fw-normal text-muted fs-6">Triệu đồng</small>

                            </span>

                        </div>

                        <div>

                            <span class="d-block fw-bold" style="color: #ff7700; font-size: 14.5px; letter-spacing: 0.5px;">LỢI NHUẬN</span>

                            <span class="fw-bold" style="color: #ff7700; font-size: 26px; font-variant-numeric: tabular-nums;">

                                @((chartTotalProfit / 1000000m).ToString("N3")) <small class="fw-normal text-muted fs-6">Triệu đồng</small>

                            </span>

                        </div>

                    </div>



                    <!-- Interactive Enterprise B2B Chart (12 Months Bar & Line) -->

                    <div class="position-relative" style="height: 290px; width: 100%;">

                        

                        <!-- Floating Tooltip on Hover / Select (Matching Screenshot 5) -->

                        @if (hoveredMonth.HasValue)

                        {

                            var hm = hoveredMonth.Value;

                            var mData = dashboard.MonthlyRevenues.FirstOrDefault(x => x.MonthNumber == hm);

                            var tooltipLeftPercent = Math.Max(8, Math.Min(88, (hm - 1) * 8.33 + 4.16));

                            <div class="app-chart-tooltip" style="left: @(tooltipLeftPercent)%; top: 15px; transform: translateX(-50%);">

                                <div class="fw-bold mb-1 border-bottom border-secondary border-opacity-50 pb-1" style="font-size: 14px; color: #10b981;">

                                    Tháng @hm

                                </div>

                                @if (showRevenue)

                                {

                                    <div class="d-flex align-items-center gap-1.5" style="color: #10b981;">

                                        <i class="bi bi-square-fill" style="font-size: 15px;"></i>

                                        <span>Doanh thu: @((mData != null ? mData.Revenue / 1000000m : 0).ToString("N0")) Triệu đồng</span>

                                    </div>

                                }

                                @if (showCost)

                                {

                                    <div class="d-flex align-items-center gap-1.5" style="color: #f43f5e;">

                                        <i class="bi bi-square-fill" style="font-size: 15px;"></i>

                                        <span>Chi phí: @((mData != null ? mData.Cost / 1000000m : 0).ToString("N0")) Triệu đồng</span>

                                    </div>

                                }

                                @if (showProfit)

                                {

                                    <div class="d-flex align-items-center gap-1.5" style="color: #ff7700;">

                                        <i class="bi bi-circle-fill" style="font-size: 15px;"></i>

                                        <span>Lợi nhuận: @((mData != null ? mData.Profit / 1000000m : 0).ToString("N0")) Triệu đồng</span>

                                    </div>

                                }

                            </div>

                        }



                        @{

                            var monthsList = dashboard.MonthlyRevenues;

                            decimal maxRevenueOrCost = monthsList.Any() 

                                ? monthsList.Max(x => Math.Max(x.Revenue, x.Cost)) / 1000000m 

                                : 0m;

                            decimal maxScale = Math.Max(10m, (decimal)Math.Ceiling((double)maxRevenueOrCost * 1.25));

                            int baselineY = 130;

                            int chartHeightPositive = 100;

                        }

                        <svg viewBox="0 0 740 220" style="width: 100%; height: 100%; overflow: visible;">

                            <!-- Y-Axis Labels (Dynamic theo maxScale) -->

                            <text x="42" y="34" fill="#94a3b8" font-size="10" text-anchor="end">@maxScale.ToString("N0")</text>

                            <text x="42" y="84" fill="#94a3b8" font-size="10" text-anchor="end">@((maxScale / 2m).ToString("N0"))</text>

                            <text x="42" y="134" fill="#94a3b8" font-size="10" text-anchor="end">0</text>

                            <text x="42" y="184" fill="#94a3b8" font-size="10" text-anchor="end">(@((maxScale / 2m).ToString("N0")))</text>



                            <!-- Horizontal Grid Lines -->

                            <line x1="48" y1="30" x2="720" y2="30" stroke="#f1f5f9" stroke-dasharray="3 3" />

                            <line x1="48" y1="80" x2="720" y2="80" stroke="#f1f5f9" stroke-dasharray="3 3" />

                            <line x1="48" y1="130" x2="720" y2="130" stroke="#cbd5e1" stroke-width="1.2" />

                            <line x1="48" y1="180" x2="720" y2="180" stroke="#f1f5f9" stroke-dasharray="3 3" />



                            <!-- 12 MONTH COLUMNS -->



                            @for (int i = 1; i <= 12; i++)

                            {

                                int m = i;

                                int cx = 55 + (m - 1) * 55;

                                var mDto = monthsList.FirstOrDefault(x => x.MonthNumber == m);

                                decimal revTrd = mDto != null ? mDto.Revenue / 1000000m : 0m;

                                decimal costTrd = mDto != null ? mDto.Cost / 1000000m : 0m;

                                decimal profitTrd = mDto != null ? mDto.Profit / 1000000m : 0m;



                                int revH = revTrd > 0 ? Math.Max(4, (int)Math.Min(100, (revTrd / maxScale) * chartHeightPositive)) : 0;

                                int costH = costTrd > 0 ? Math.Max(4, (int)Math.Min(100, (costTrd / maxScale) * chartHeightPositive)) : 0;



                                bool isHovered = hoveredMonth == m;



                                <!-- Highlight column background and vertical dashed guideline when hovered -->

                                @if (isHovered)

                                {

                                    <line x1="@cx" y1="20" x2="@cx" y2="195" stroke="#94a3b8" stroke-dasharray="3 3" />

                                    <rect x="@(cx - 24)" y="20" width="48" height="175" fill="rgba(0,176,96,0.04)" rx="4" />

                                    <!-- Selected Month Border Box around X-axis label (Matching Screenshot 5) -->

                                    <rect x="@(cx - 18)" y="195" width="36" height="20" rx="3" fill="#f8fafc" stroke="#94a3b8" />

                                }



                                <!-- BARS: DOANH THU & CHI PHÍ -->

                                @if (showRevenue && showCost)

                                {

                                    <!-- Revenue Bar (Teal/Green) -->

                                    @if (revH > 0)

                                    {

                                        <rect x="@(cx - 11)" y="@(baselineY - revH)" width="10" height="@revH" fill="#10b981" rx="2" />

                                    }

                                    <!-- Cost Bar (Red/Pink) -->

                                    @if (costH > 0)

                                    {

                                        <rect x="@(cx + 1)" y="@(baselineY - costH)" width="10" height="@costH" fill="#f43f5e" rx="2" />

                                    }

                                }

                                else if (showRevenue)

                                {

                                    <!-- Revenue Bar ONLY (Single wide column, matching Screenshot 5) -->

                                    @if (revH > 0)

                                    {

                                        <rect x="@(cx - 8)" y="@(baselineY - revH)" width="16" height="@revH" fill="#10b981" rx="2" />

                                    }

                                }

                                else if (showCost)

                                {

                                    <!-- Cost Bar ONLY -->

                                    @if (costH > 0)

                                    {

                                        <rect x="@(cx - 8)" y="@(baselineY - costH)" width="16" height="@costH" fill="#f43f5e" rx="2" />

                                    }

                                }



                                <!-- Peak callout labels (as seen in screenshots: 1.035, 650, 253) -->

                                @if (showRevenue && revTrd >= 200m)

                                {

                                    <rect x="@(cx - 18)" y="@(baselineY - revH - 17)" width="36" height="15" rx="3" fill="#0f172a" opacity="0.85" />

                                    @((MarkupString)$"<text x=\"{cx}\" y=\"{baselineY - revH - 6}\" fill=\"#ffffff\" font-size=\"8.5\" font-weight=\"700\" text-anchor=\"middle\">{revTrd.ToString("N0")}</text>")

                                }



                                <!-- X-Axis Month Label -->

                                @((MarkupString)$"<text x=\"{cx}\" y=\"209\" fill=\"{(isHovered ? "#0f172a" : "#64748b")}\" font-size=\"10\" font-weight=\"{(isHovered ? "700" : "500")}\" text-anchor=\"middle\">Th {m}</text>")



                                <!-- Invisible hover trigger rect -->

                                <rect x="@(cx - 24)" y="15" width="48" height="195" fill="transparent" 

                                      style="cursor: pointer;"

                                      @onmouseover="() => hoveredMonth = m" 

                                      @onmouseout="() => hoveredMonth = null"

                                      @onclick="() => hoveredMonth = m" />

                            }



                            <!-- 3. LỢI NHUẬN LINE & CIRCULAR DATA POINTS (ORANGE) -->

                            @if (showProfit)

                            {

                                <!-- Build SVG path for profit points -->

                                string pathD = "";

                                for (int i = 1; i <= 12; i++)

                                {

                                    int m = i;

                                    int cx = 55 + (m - 1) * 55;

                                    var mDto = monthsList.FirstOrDefault(x => x.MonthNumber == m);

                                    decimal profitTrd = mDto != null ? mDto.Profit / 1000000m : 0m;

                                    // Calculate py based on profit (can be negative!)

                                    int py = baselineY - (int)((profitTrd / maxScale) * chartHeightPositive);

                                    py = Math.Max(25, Math.Min(200, py));

                                    pathD += (i == 1 ? $"M {cx} {py}" : $" L {cx} {py}");

                                }



                                <path d="@pathD" fill="none" stroke="#ff7700" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />



                                @for (int i = 1; i <= 12; i++)

                                {

                                    int m = i;

                                    int cx = 55 + (m - 1) * 55;

                                    var mDto = monthsList.FirstOrDefault(x => x.MonthNumber == m);

                                    decimal profitTrd = mDto != null ? mDto.Profit / 1000000m : 0m;

                                    int py = baselineY - (int)((profitTrd / maxScale) * chartHeightPositive);

                                    py = Math.Max(25, Math.Min(200, py));



                                    <circle cx="@cx" cy="@py" r="4" fill="#ff7700" stroke="#ffffff" stroke-width="1.5" />



                                    <!-- Negative callout badge if loss occurs -->

                                    @if (profitTrd < 0 && Math.Abs(profitTrd) >= 100m)

                                    {

                                        <rect x="@(cx - 22)" y="@(py + 6)" width="44" height="15" rx="3" fill="#0f172a" opacity="0.85" />

                                        @((MarkupString)$"<text x=\"{cx}\" y=\"{py + 17}\" fill=\"#ffffff\" font-size=\"8.5\" font-weight=\"700\" text-anchor=\"middle\">({Math.Abs(profitTrd).ToString("N0")})</text>")

                                    }

                                }

                            }

                        </svg>

                    </div>



                    <!-- Interactive Enterprise Legend Buttons (Matching Screenshot 4 & 5) -->

                    <div class="d-flex align-items-center justify-content-center gap-3 mt-2">

                        <button class="app-legend-btn @(showRevenue ? "" : "inactive")" 

                                title="Bấm để ẩn / hiện chuỗi Doanh thu" 

                                @onclick="ToggleRevenue">

                            <span class="app-dot" style="background-color: #00b060;"></span>

                            <span style="color: @(showRevenue ? "#1e293b" : "#94a3b8");">DOANH THU</span>

                        </button>



                        <button class="app-legend-btn @(showCost ? "" : "inactive")" 

                                title="Bấm để ẩn / hiện chuỗi Chi phí" 

                                @onclick="ToggleCost">

                            <span class="app-dot" style="background-color: #f43f5e;"></span>

                            <span style="color: @(showCost ? "#1e293b" : "#94a3b8");">CHI PHÍ</span>

                        </button>



                        <button class="app-legend-btn @(showProfit ? "" : "inactive")" 

                                title="Bấm để ẩn / hiện chuỗi Lợi nhuận" 

                                @onclick="ToggleProfit">

                            <span class="app-dot" style="background-color: #ff7700;"></span>

                            <span style="color: @(showProfit ? "#1e293b" : "#94a3b8");">LỢI NHUẬN</span>

                        </button>

                    </div>

                </div>



                <div class="app-card-footer">

                    <span><i class="bi bi-clock me-1"></i>Số liệu tính đến: @lastUpdated.ToString("HH:mm")</span>

                    <a href="javascript:void(0)" @onclick="LoadDashboard" class="text-primary fw-bold text-decoration-none">Tải lại</a>

                </div>

            </div>

        </div>



        <!-- CARD 5: HÀNG HÓA TỒN KHO -->

        <div class="col-12 col-xl-5">

            <div class="app-card">

                <div class="app-card-header">

                    <h6 class="app-card-title">

                        <i class="bi bi-box-seam text-primary"></i> Hàng hóa tồn kho

                    </h6>

                    <span class="text-muted small" style="font-size: 15px;">Đvt: Triệu đồng</span>

                </div>



                <div class="app-card-body p-3">

                    <div class="row g-2 mb-3 pb-2 border-bottom">

                        <div class="col-6 border-end">

                            <div class="text-muted small" style="font-size: 15px;">Tổng vốn bỏ ra (Nhập kho)</div>

                            <div class="fs-5 fw-bold text-danger">

                                @((dashboard.TotalInventoryCost / 1000000m).ToString("N1")) <small class="fs-6 fw-normal text-muted">Trđ</small>

                            </div>

                        </div>

                        <div class="col-6 ps-2">

                            <div class="text-muted small" style="font-size: 15px;">Giá trị bán sỉ tiềm năng</div>

                            <div class="fs-5 fw-bold text-primary">

                                @((dashboard.TotalInventoryValuation / 1000000m).ToString("N1")) <small class="fs-6 fw-normal text-muted">Trđ</small>

                            </div>

                        </div>

                        <div class="col-12 mt-1">

                            <span class="badge bg-success-subtle text-success border border-success-subtle small w-100 text-start py-1 px-2">

                                <i class="bi bi-piggy-bank me-1"></i> Lợi nhuận gộp kỳ vọng kho: <strong>+@((dashboard.TotalExpectedInventoryProfit / 1000000m).ToString("N1")) Trđ</strong> (@dashboard.ExpectedProfitMargin%)

                            </span>

                        </div>

                    </div>



                    <div class="table-responsive bg-white" style="background-color: #ffffff !important;">

                        <table class="table table-hover align-middle mb-0" style="font-size: 16px; background-color: #ffffff !important;">

                            <thead class="table-light text-muted" style="font-size: 14.5px; font-weight: 700; color: #334155; background-color: #f1f5f9 !important;">

                                <tr>

                                    <th>Tên hàng</th>

                                    <th class="text-end">Tồn kho</th>

                                    <th class="text-end text-danger">Vốn (Trđ)</th>

                                    <th class="text-end text-primary">Bán (Trđ)</th>

                                    <th class="text-end text-success">Lãi gộp</th>

                                </tr>

                            </thead>

                            <tbody>

                                @if (dashboard.TopInventoryProducts.Any())

                                {

                                    var dotColors = new[] { "#0075ff", "#8b5cf6", "#00b060", "#ff7700", "#ef4444" };

                                    int colorIdx = 0;

                                    @foreach (var prod in dashboard.TopInventoryProducts)

                                    {

                                        var curColor = dotColors[colorIdx % dotColors.Length];

                                        colorIdx++;

                                        var costVal = prod.TotalCost / 1000000m;

                                        var sellVal = prod.Valuation / 1000000m;

                                        var profitVal = prod.ExpectedProfit / 1000000m;

                                        <tr>

                                            <td>

                                                <span class="app-dot" style="background-color: @curColor;"></span>

                                                <span class="fw-semibold text-slate-navy text-truncate d-inline-block" style="max-width: 130px;" title="@prod.ProductName">

                                                    @prod.ProductName

                                                </span>

                                            </td>

                                            <td class="text-end fw-semibold text-dark">

                                                @prod.StockQuantity.ToString("N0") <span class="text-muted small">@prod.Unit</span>

                                            </td>

                                            <td class="text-end text-muted">

                                                @costVal.ToString("N1")

                                            </td>

                                            <td class="text-end fw-semibold text-primary">

                                                @sellVal.ToString("N1")

                                            </td>

                                            <td class="text-end fw-bold text-success">

                                                +@profitVal.ToString("N1")

                                            </td>

                                        </tr>

                                    }

                                }

                                else

                                {

                                    <tr>

                                        <td colspan="5" class="text-center text-muted py-3">Chưa có dữ liệu tồn kho</td>

                                    </tr>

                                }

                            </tbody>

                        </table>

                    </div>

                </div>



                <div class="app-card-footer">

                    <span>Số liệu tính đến: @lastUpdated.ToString("HH:mm")</span>

                    <a href="/manage-products" class="text-primary fw-bold text-decoration-none">Xem chi tiết kho ↗</a>

                </div>

            </div>

        </div>

    </div>



    <!-- =========================================================================

         6. ROW 3: MẶT HÀNG BÁN CHẠY & TOP 5 KHÁCH HÀNG NỢ LỚN NHẤT

         ========================================================================= -->

    <div class="row g-3 mb-3">

        <!-- CARD 6: MẶT HÀNG BÁN CHẠY (VỚI HÌNH ẢNH VECTOR ĐỒNG BỘ) -->

        <div class="col-12 col-lg-6">

            <div class="app-card">

                <div class="app-card-header">

                    <h6 class="app-card-title">

                        <i class="bi bi-trophy-fill text-warning"></i> Mặt hàng bán chạy nhất

                    </h6>

                    <span class="badge bg-light text-secondary border small">Top sản phẩm FMCG</span>

                </div>



                <div class="app-card-body p-0">

                    <div class="table-responsive bg-white" style="background-color: #ffffff !important;">

                        <table class="table table-hover align-middle mb-0" style="font-size: 16px; background-color: #ffffff !important;">

                            <thead class="table-light text-muted" style="font-size: 14.5px; font-weight: 700; color: #334155; background-color: #f1f5f9 !important;">

                                <tr>

                                    <th>Sản Phẩm</th>

                                    <th class="text-center">Số Lượng Bán</th>

                                    <th class="text-end">Doanh Thu</th>

                                </tr>

                            </thead>

                            <tbody>

                                @if (dashboard.TopProducts.Any())

                                {

                                    @foreach (var prod in dashboard.TopProducts)

                                    {

                                        <tr>

                                            <td>

                                                <div class="d-flex align-items-center gap-2">

                                                    <img src="@(string.IsNullOrEmpty(prod.ImageUrl) ? "/images/products/sp001-coca-cola.svg" : prod.ImageUrl)" 

                                                         alt="@prod.ProductName" 

                                                         style="width: 32px; height: 32px; object-fit: contain;" 

                                                         class="rounded border bg-light p-1 shadow-xs" />

                                                    <div>

                                                        <div class="fw-semibold text-slate-navy">@prod.ProductName</div>

                                                        <small class="text-muted" style="font-size: 15px;">@prod.ProductCode</small>

                                                    </div>

                                                </div>

                                            </td>

                                            <td class="text-center">

                                                <span class="badge bg-success-subtle text-success px-2 py-1 rounded-pill fw-bold">

                                                    @prod.TotalQuantitySold

                                                </span>

                                            </td>

                                            <td class="text-end fw-bold text-success">

                                                @prod.TotalRevenue.ToString("N0") đ

                                            </td>

                                        </tr>

                                    }

                                }

                                else

                                {

                                    <tr>

                                        <td colspan="3" class="text-center text-muted py-3">Chưa có giao dịch bán hàng</td>

                                    </tr>

                                }

                            </tbody>

                        </table>

                    </div>

                </div>



                <div class="app-card-footer">

                    <span>Tổng số: @dashboard.TopProducts.Count mặt hàng chủ lực</span>

                    <a href="/invoices" class="text-primary fw-bold text-decoration-none">Toàn bộ hóa đơn ↗</a>

                </div>

            </div>

        </div>



        <!-- CARD 7: TOP KHÁCH HÀNG NỢ & GIÁM SÁT HẠN MỨC AI -->

        <div class="col-12 col-lg-6">

            <div class="app-card">

                <div class="app-card-header">

                    <h6 class="app-card-title">

                        <i class="bi bi-shield-exclamation text-danger"></i> Giám sát hạn mức & Top 5 khách nợ

                    </h6>

                    <a href="/aging-report" class="btn btn-sm btn-outline-danger py-0.5 px-2" style="font-size: 15px;">

                        Báo Cáo 4 Xô

                    </a>

                </div>



                <div class="app-card-body p-0">

                    <div class="table-responsive bg-white" style="background-color: #ffffff !important;">

                        <table class="table table-hover align-middle mb-0" style="font-size: 16px; background-color: #ffffff !important;">

                            <thead class="table-light text-muted" style="font-size: 14.5px; font-weight: 700; color: #334155; background-color: #f1f5f9 !important;">

                                <tr>

                                    <th>Khách Hàng</th>

                                    <th>Dư Nợ Hiện Tại</th>

                                    <th>Tỷ Lệ / Hạn Mức</th>

                                    <th class="text-end">Tình Trạng</th>

                                </tr>

