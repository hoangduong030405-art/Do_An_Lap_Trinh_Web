@code {

    private DashboardSummaryDto? dashboard;

    private bool loading = true;

    private bool isRefreshing = false;

    private DateTime lastUpdated = DateTime.Now;



    // Filters & Modals state

    private string selectedPeriod = "this_month";

    private string selectedPeriodText => selectedPeriod switch

    {

        "today" => "Hôm nay",

        "this_week" => "Tuần này",

        "this_quarter" => "Quý này",

        "this_year" => "Năm nay",

        _ => "Tháng này"

    };



    private DateTime periodStartDate = new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1);

    private DateTime periodEndDate = new DateTime(DateTime.Now.Year, DateTime.Now.Month, DateTime.DaysInMonth(DateTime.Now.Year, DateTime.Now.Month));



    private bool showAvaModal = false;

    private bool showCustomizeModal = false;



    // Chart Interactive Series Toggles (Matching Enterprise Screenshot 4 & 5)

    private bool showRevenue = true;

    private bool showCost = true;

    private bool showProfit = true;

    private int? hoveredMonth = null;



    private decimal chartTotalRevenue => dashboard != null ? dashboard.MonthlyRevenues.Sum(m => m.Revenue) : 0;

    private decimal chartTotalCost => dashboard != null ? dashboard.MonthlyRevenues.Sum(m => m.Cost) : 0;

    private decimal chartTotalProfit => chartTotalRevenue - chartTotalCost;



    private void ToggleRevenue() => showRevenue = !showRevenue;

    private void ToggleCost() => showCost = !showCost;

    private void ToggleProfit() => showProfit = !showProfit;



    // Calculations: Real COGS & Real Profit directly from DTO

    private decimal actualCost => dashboard?.TotalActualCost ?? 0m;

    private decimal actualProfit => dashboard?.TotalActualProfit ?? 0m;

    private decimal profitMargin => dashboard?.ActualProfitMargin ?? 0m;

    

    private decimal collectionRate => dashboard?.CollectionRate ?? 0m;



    private decimal overdueDebt => dashboard?.OverdueDebt ?? 0m;



    private decimal withinTermDebt => dashboard?.CurrentDebt ?? 0m;



    private decimal overdueBarWidth => overduePercent;



    private decimal currentBarWidth => 100m - overdueBarWidth;



    private decimal top5DebtPercentage => dashboard?.Top5DebtorsPercentage ?? 0m;



    private decimal overduePercent => dashboard?.OverduePercent ?? 0m;



    protected override async Task OnInitializedAsync()

    {

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();

        if (authState.User.IsInRole("Customer"))

        {

            Navigation.NavigateTo("/portal/dashboard");

            return;

        }



        LayoutState.OnChange += OnLayoutStateChanged;

        selectedPeriod = LayoutState.SelectedPeriod;

        UpdatePeriodDates();

        await LoadDashboard();

    }



    private async void OnLayoutStateChanged()

    {

        await InvokeAsync(async () =>

        {

            if (selectedPeriod != LayoutState.SelectedPeriod)

            {

                selectedPeriod = LayoutState.SelectedPeriod;

                UpdatePeriodDates();

            }

            await LoadDashboard();

            StateHasChanged();

        });

    }



    public void Dispose()

    {

        LayoutState.OnChange -= OnLayoutStateChanged;

    }



    private async Task LoadDashboard()

    {

        isRefreshing = true;

        try

        {

            dashboard = await GetDashboardDataUseCase.ExecuteAsync(selectedPeriod);

            lastUpdated = DateTime.Now;

        }

        finally

        {

            loading = false;

            isRefreshing = false;

        }

    }



    private async Task OnPeriodChanged(ChangeEventArgs e)

    {

        selectedPeriod = e.Value?.ToString() ?? "this_month";

        LayoutState.SetSelectedPeriod(selectedPeriod);

        UpdatePeriodDates();

        await LoadDashboard();

    }



    private void UpdatePeriodDates()

    {

        var now = DateTime.Now;

        switch (selectedPeriod)

        {

            case "today":

                periodStartDate = now.Date;

                periodEndDate = now.Date;

                break;

            case "this_week":

                var diff = (7 + (now.DayOfWeek - DayOfWeek.Monday)) % 7;

                periodStartDate = now.AddDays(-1 * diff).Date;

                periodEndDate = periodStartDate.AddDays(6).Date;

                break;

            case "this_quarter":

                int quarterNumber = (now.Month - 1) / 3 + 1;

                periodStartDate = new DateTime(now.Year, (quarterNumber - 1) * 3 + 1, 1);

                periodEndDate = periodStartDate.AddMonths(3).AddDays(-1);

                break;

            case "this_year":

                periodStartDate = new DateTime(now.Year, 1, 1);

                periodEndDate = new DateTime(now.Year, 12, 31);

                break;

            default: // this_month

                periodStartDate = new DateTime(now.Year, now.Month, 1);

                periodEndDate = new DateTime(now.Year, now.Month, DateTime.DaysInMonth(now.Year, now.Month));

                break;

        }

    }



    private void OpenAvaAnalysisModal()

    {

        showAvaModal = true;

    }



    private void CloseAvaModal()

    {

        showAvaModal = false;

    }



    private void ToggleCustomizeModal()

    {

        showCustomizeModal = !showCustomizeModal;

    }



    private void PrintOverview()

    {

        Navigation.NavigateTo("/invoices");

    }

}

