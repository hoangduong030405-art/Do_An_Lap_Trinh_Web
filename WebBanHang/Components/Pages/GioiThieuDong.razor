    private B2bProduct? _selectedProduct;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            if (user.Identity?.IsAuthenticated == true)
            {
                _isAuthenticated = true;
                _dashboardUrl = user.IsInRole("Customer") ? "/portal/dashboard" : "/dashboard";
            }
        }
        catch
        {
            _isAuthenticated = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                await JS.InvokeVoidAsync("initDongAnimations");
            }
            catch (JSException)
            {
                // Fallback nếu Three.js/GSAP tải chậm
            }
        }
    }

    private void ToggleMenu() => _mobileOpen = !_mobileOpen;

    private void OpenRoleModal() => _showRoleModal = true;
    private void CloseRoleModal() => _showRoleModal = false;

    private async Task LoginRole(string username, string password, string returnUrl)
    {
        _showRoleModal = false;
        try
        {
            await JS.InvokeVoidAsync("loginDemoRole", username, password, returnUrl);
        }
        catch
        {
            Navigation.NavigateTo($"/login?role={username}");
        }
    }

    private async Task SmoothScrollTo(string selector)
    {
        _mobileOpen = false;
        try
        {
            await JS.InvokeVoidAsync("SmoothScroll", selector);
        }
        catch
        {
            // Fallback nếu JS interop bận
        }
    }

    private void SelectProduct(int id)
    {
        _selectedProduct = _products.FirstOrDefault(p => p.Id == id);
    }

    private void CloseProductModal()
    {
        _selectedProduct = null;
    }

    private void HandleSubmit()
    {
        if (!string.IsNullOrWhiteSpace(_contactName) && !string.IsNullOrWhiteSpace(_contactEmail))
        {
            _formSubmitted = true;
        }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("destroyDongAnimations");
        }
        catch
        {
            // Bỏ qua lỗi dispose
        }
    }
}
