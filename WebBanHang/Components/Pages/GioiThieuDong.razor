@page "/"
@page "/gioi-thieu"
@page "/gioi-thieu-dong"
@layout Layout.EmptyLayout
@attribute [AllowAnonymous]
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.Authorization
@inject IJSRuntime JS
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@implements IAsyncDisposable

<PageTitle>HUEGO B2B - Nền Tảng Phân Phối Sỉ & Quản Trị Tín Dụng Doanh Nghiệp</PageTitle>

<div class="dong-layout">
    <!-- Nền chuyển động động học Cyber Mesh & Three.js 3D Particle Galaxy xuyên suốt toàn bộ trang -->
    <div class="dong-animated-bg" aria-hidden="true">
        <canvas id="dong-ambient-canvas"></canvas>
        <div class="dong-ambient-grid"></div>
        <div class="dong-ambient-scanline"></div>
        <div class="dong-ambient-orb orb-1"></div>
        <div class="dong-ambient-orb orb-2"></div>
        <div class="dong-ambient-orb orb-3"></div>
        <div class="dong-ambient-orb orb-4"></div>
    </div>

    <!-- 0. Navbar dính cố định, blur -->
    <nav class="dong-nav" aria-label="Main Navigation">
        <div class="nav-inner">
            <button type="button" class="nav-brand" @onclick='async () => await SmoothScrollTo("#hero")'>
                HUEGO<span class="brand-accent"> B2B</span>
            </button>
            <div class="nav-menu">
                <button type="button" class="nav-menu-link" @onclick='async () => await SmoothScrollTo("#stats")'>Chỉ số</button>
                <button type="button" class="nav-menu-link" @onclick='async () => await SmoothScrollTo("#values")'>Giá trị</button>
                <button type="button" class="nav-menu-link" @onclick='async () => await SmoothScrollTo("#steps")'>Cách hoạt động</button>
                <button type="button" class="nav-menu-link" @onclick='async () => await SmoothScrollTo("#products")'>Sản phẩm</button>
                <button type="button" class="nav-menu-link" @onclick='async () => await SmoothScrollTo("#credit")'>Công nợ B2B</button>
                <button type="button" class="nav-menu-link" @onclick='async () => await SmoothScrollTo("#cta")'>Đăng ký</button>
            </div>
            <div class="nav-actions">
                <button type="button" class="nav-login-btn" @onclick="OpenRoleModal" title="Chọn vai trò đăng nhập demo nhanh">
                    <i class="bi bi-box-arrow-in-right me-1"></i>Đăng nhập
                </button>
                @if (_isAuthenticated)
                {
                    <a href="@_dashboardUrl" class="nav-btn nav-btn-primary">
                        <i class="bi bi-speedometer2 me-1"></i>Bàn làm việc
                    </a>
                }
                else
                {
                    <button type="button" class="nav-btn" @onclick='async () => await SmoothScrollTo("#cta")'>Mở tài khoản</button>
                }
            </div>
            <button class="nav-hamburger" @onclick="ToggleMenu" aria-label="Mở menu điều hướng" aria-expanded="@_mobileOpen">
                <span class="@(_mobileOpen ? "spin-1" : "")"></span>
                <span class="@(_mobileOpen ? "fade" : "")"></span>
                <span class="@(_mobileOpen ? "spin-2" : "")"></span>
            </button>
        </div>
        <div class="@(_mobileOpen ? "dong-mobile open" : "dong-mobile")">
            <button type="button" class="mobile-menu-link" @onclick='async () => { await SmoothScrollTo("#stats"); _mobileOpen = false; }'>Chỉ số nền tảng</button>
            <button type="button" class="mobile-menu-link" @onclick='async () => { await SmoothScrollTo("#values"); _mobileOpen = false; }'>Giá trị cốt lõi</button>
            <button type="button" class="mobile-menu-link" @onclick='async () => { await SmoothScrollTo("#steps"); _mobileOpen = false; }'>Quy trình 3 bước</button>
            <button type="button" class="mobile-menu-link" @onclick='async () => { await SmoothScrollTo("#products"); _mobileOpen = false; }'>Danh mục hàng sỉ</button>
            <button type="button" class="mobile-menu-link" @onclick='async () => { await SmoothScrollTo("#credit"); _mobileOpen = false; }'>Hạn mức công nợ</button>
            <button type="button" class="mobile-login-link text-start" @onclick='() => { _mobileOpen = false; OpenRoleModal(); }'>
                <i class="bi bi-box-arrow-in-right me-1"></i>Chọn vai trò Demo
            </button>
            @if (_isAuthenticated)
            {
                <a href="@_dashboardUrl" class="mobile-login-link text-center fw-bold text-white bg-blue-600 rounded py-2">
                    <i class="bi bi-speedometer2 me-1"></i>Vào Bàn Làm Việc
                </a>
            }
            else
            {
                <button type="button" class="mobile-btn" @onclick='async () => { await SmoothScrollTo("#cta"); _mobileOpen = false; }'>Đăng ký bán sỉ</button>
            }
        </div>
    </nav>

    <!-- 1. Hero với 3D Interactive Three.js Holographic Supply Chain Globe & Floating FMCG Cubes -->
    <section id="hero" class="dong-hero">
        <div class="hero-container">
            <div class="hero-content hero-entrance">
                <div class="hero-live-badge">
                    <span class="live-dot"></span> HUEGO B2B V4.0 • HỆ SINH THÁI PHÂN PHỐI SỈ & TÍN DỤNG TỰ ĐỘNG
                </div>
                <h1 class="hero-title">
                    Bán sỉ lớn,<br>
                    <span class="gradient-text">quản lý công nợ linh hoạt</span>
                </h1>
                <p class="hero-desc">
                    Kết nối trực tiếp nhà phân phối cấp 1 và chuỗi bán lẻ. Đặt hàng lô lớn theo kiện/pallet, phê duyệt hạn mức công nợ tự động, đối soát hóa đơn điện tử VAT tức thì.
                </p>
                <div class="hero-actions">
                    <button type="button" class="btn btn-primary btn-magnetic" @onclick='async () => await SmoothScrollTo("#cta")'>
                        <span>Đăng ký doanh nghiệp</span>
                        <svg class="btn-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                        </svg>
                    </button>
                    <button type="button" class="btn btn-outline btn-magnetic" @onclick='async () => await SmoothScrollTo("#credit")'>
                        <span>Xem giải pháp công nợ</span>
                    </button>
                </div>

                <!-- Hero Trust Strip chống trống trải -->
                <div class="hero-trust-strip">
                    <div class="trust-item"><i class="bi bi-patch-check-fill text-emerald"></i> <span>Phê duyệt hạn mức trong 4h</span></div>
                    <div class="trust-item"><i class="bi bi-bank2 text-amber"></i> <span>Bảo lãnh tín dụng BIDV & VCB</span></div>
                    <div class="trust-item"><i class="bi bi-truck text-blue"></i> <span>Phân phối Pallet & Container 24h</span></div>
                    <div class="trust-item"><i class="bi bi-shield-lock-fill text-purple"></i> <span>Hóa đơn VAT điện tử tức thì</span></div>
                </div>
            </div>

            <!-- Khung 3D Three.js Tương tác Thay thế ảnh tĩnh iStock -->
            <div class="hero-visual hero-entrance" id="hero-3d-container">
                <div class="hero-visual-frame" title="Kéo chuột để xoay mô hình 3D Mạng Lưới Cung Ứng HUEGO B2B">
                    <!-- Three.js Canvas -->
                    <canvas id="hero-3d-scene"></canvas>
                    <div class="hero-visual-overlay"></div>
                    
                    <!-- 3 Floating HUD Badges với Parallax 3D theo chuột -->
                    <div class="hero-float-pill pill-1">
                        <div class="pill-value"><i class="bi bi-box-seam text-amber"></i> 10,000+</div>
                        <div class="pill-label">Đơn hàng lô hoàn tất</div>
                    </div>
                    <div class="hero-float-pill pill-2">
                        <div class="pill-value"><i class="bi bi-shield-check text-emerald"></i> 500+</div>
                        <div class="pill-label">Doanh nghiệp đối tác B2B</div>
                    </div>
                    <div class="hero-float-pill pill-3">
                        <div class="pill-value"><i class="bi bi-credit-card text-blue"></i> 50 Tỷ+</div>
                        <div class="pill-label">Hạn mức tín dụng linh hoạt</div>
                        <div class="pill-sub-badge"><i class="bi bi-shield-fill-check text-cyan"></i> B2B Cloud Verified</div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- 2. Ticker đối tác - Chuẩn hóa Ngành FMCG & Kế toán B2B -->
    <section class="dong-ticker" aria-label="Ticker đối tác">
        <div class="ticker-track">
            <span class="ticker-badge"><i class="bi bi-shop text-amber"></i> 🏪 Tạp hóa & Siêu thị mini</span>
            <span class="ticker-badge"><i class="bi bi-buildings text-blue"></i> 🏭 Tổng kho phân phối FMCG</span>
            <span class="ticker-badge"><i class="bi bi-cup-straw text-emerald"></i> 🍺 Bia & Nước giải khát theo Pallet</span>
            <span class="ticker-badge"><i class="bi bi-cpu text-purple"></i> 💳 Cấp hạn mức tín dụng AI</span>
            <span class="ticker-badge"><i class="bi bi-lightning-charge-fill text-amber"></i> ⚡ Gạch nợ tự động chuẩn FIFO</span>
            <span class="ticker-badge"><i class="bi bi-qr-code-scan text-cyan"></i> 📲 Đối soát công nợ VietQR 24/7</span>
            <span class="ticker-badge"><i class="bi bi-receipt text-emerald"></i> 🧾 Biên bản đối soát điện tử</span>
            <span class="ticker-badge"><i class="bi bi-box-seam text-blue"></i> 🍜 Thực phẩm & Hàng tiêu dùng nhanh</span>
            <!-- Lặp lại để chạy vô tận -->
            <span class="ticker-badge"><i class="bi bi-shop text-amber"></i> 🏪 Tạp hóa & Siêu thị mini</span>
            <span class="ticker-badge"><i class="bi bi-buildings text-blue"></i> 🏭 Tổng kho phân phối FMCG</span>
            <span class="ticker-badge"><i class="bi bi-cup-straw text-emerald"></i> 🍺 Bia & Nước giải khát theo Pallet</span>
            <span class="ticker-badge"><i class="bi bi-cpu text-purple"></i> 💳 Cấp hạn mức tín dụng AI</span>
            <span class="ticker-badge"><i class="bi bi-lightning-charge-fill text-amber"></i> ⚡ Gạch nợ tự động chuẩn FIFO</span>
            <span class="ticker-badge"><i class="bi bi-qr-code-scan text-cyan"></i> 📲 Đối soát công nợ VietQR 24/7</span>
            <span class="ticker-badge"><i class="bi bi-receipt text-emerald"></i> 🧾 Biên bản đối soát điện tử</span>
            <span class="ticker-badge"><i class="bi bi-box-seam text-blue"></i> 🍜 Thực phẩm & Hàng tiêu dùng nhanh</span>
        </div>
    </section>

    <!-- 3. Stats / Chỉ số tăng trưởng với Micro-Charts -->
    <section id="stats" class="dong-stats">
        <div class="section-head reveal">
            <div class="section-tag">Dữ liệu thực tế</div>
            <h2 class="section-title">Chỉ số tăng trưởng nói lên tất cả</h2>
            <p class="section-desc">Hệ sinh thái phân phối sỉ và chuỗi cung ứng mở rộng liên tục mỗi ngày.</p>
        </div>
        <div class="stats-grid">
            <div class="stat-item reveal">
                <span class="stat-growth-tag"><i class="bi bi-graph-up-arrow"></i> +145% YoY</span>
                <div class="stat-counter" data-target="10000">10,000+</div>
                <div class="stat-text">Đơn hàng sỉ / tháng</div>
                <div class="stat-sparkline">
                    <div class="spark-bar h-1"></div>
                    <div class="spark-bar h-2"></div>
                    <div class="spark-bar h-3"></div>
                    <div class="spark-bar h-4"></div>
                    <div class="spark-bar h-5"></div>
                    <div class="spark-bar h-6"></div>
                </div>
                <div class="stat-sub-info"><i class="bi bi-graph-up text-emerald"></i> Tăng trưởng quy mô đơn hàng</div>
            </div>
            <div class="stat-item reveal">
                <span class="stat-growth-tag"><i class="bi bi-patch-check"></i> Toàn quốc</span>
                <div class="stat-counter" data-target="500">500+</div>
                <div class="stat-text">Doanh nghiệp đối tác</div>
                <div class="stat-sub-info mt-4"><i class="bi bi-shop text-blue"></i> 350 chuỗi bán lẻ • 150 tổng kho</div>
            </div>
            <div class="stat-item reveal">
                <span class="stat-growth-tag"><i class="bi bi-shield-check"></i> SLA 99.8%</span>
                <div class="stat-counter" data-target="99">99%</div>
                <div class="stat-text">Đơn hàng giao đúng hẹn</div>
                <div class="stat-sub-info mt-4"><i class="bi bi-geo-alt-fill text-amber"></i> Cam kết SLA trên 63 tỉnh thành</div>
            </div>
            <div class="stat-item reveal">
                <span class="stat-growth-tag"><i class="bi bi-lightning-charge"></i> Phê duyệt 4h</span>
                <div class="stat-counter" data-target="24">24/7</div>
                <div class="stat-text">Hỗ trợ đối soát & Cấp hạn mức</div>
                <div class="stat-sub-info mt-4"><i class="bi bi-broadcast text-cyan"></i> Thời gian giải ngân tự động 1.2s</div>
            </div>
        </div>
    </section>

    <!-- 4. Values / Giá trị cốt lõi (4 thẻ 3D + Bullet Checklists) -->
    <section id="values" class="dong-values">
        <div class="section-head reveal">
            <div class="section-tag">Giá trị cốt lõi</div>
            <h2 class="section-title">Tại sao chọn HUEGO B2B</h2>
            <p class="section-desc">Giải pháp tối ưu hóa dòng tiền và năng lực cung ứng cho nhà bán sỉ & đại lý.</p>
        </div>
        <div class="values-grid">
            <div class="value-card reveal">
                <div class="value-badge">01</div>
                <div class="value-icon-box">
                    <i class="bi bi-rocket-takeoff-fill fs-3 text-amber"></i>
                </div>
                <h3>Đặt hàng lô & Giao hỏa tốc</h3>
                <p>Tra cứu bảng giá sỉ theo cấp bậc (Tier pricing), tạo đơn PO theo kiện chỉ trong vài phút.</p>
                <ul class="value-checklist">
                    <li class="value-check-item"><i class="bi bi-check-circle-fill"></i> Chiết khấu bậc thang theo số lượng (MOQ)</li>
                    <li class="value-check-item"><i class="bi bi-check-circle-fill"></i> Tự động tính giá sỉ theo kiện/pallet</li>
                    <li class="value-check-item"><i class="bi bi-check-circle-fill"></i> Giao hỏa tốc liên tỉnh 24-48 giờ</li>
                </ul>
            </div>

            <div class="value-card reveal">
                <div class="value-badge">02</div>
                <div class="value-icon-box">
                    <i class="bi bi-shield-check fs-3 text-emerald"></i>
                </div>
                <h3>Công nợ linh hoạt T+30 / T+60</h3>
                <p>Hạn mức tín dụng trả chậm linh hoạt với bảng đối soát tự động theo chu kỳ chuẩn B2B.</p>
                <ul class="value-checklist">
                    <li class="value-check-item"><i class="bi bi-check-circle-fill"></i> Hạn mức trả chậm T+30, T+45, T+60 ngày</li>
                    <li class="value-check-item"><i class="bi bi-check-circle-fill"></i> 0% lãi suất trong thời hạn cam kết</li>
                    <li class="value-check-item"><i class="bi bi-check-circle-fill"></i> Bảng đối soát tự động theo chu kỳ</li>
                </ul>
            </div>

            <div class="value-card reveal">
                <div class="value-badge">03</div>
                <div class="value-icon-box">
                    <i class="bi bi-truck fs-3 text-blue"></i>
                </div>
                <h3>Giao vận Pallet & Container</h3>
                <p>Điều phối mạng lưới vận tải toàn quốc, biên bản giao nhận điện tử kèm theo dõi hành trình thực tế.</p>
                <ul class="value-checklist">
                    <li class="value-check-item"><i class="bi bi-check-circle-fill"></i> Đội xe tải & container chuyên trách</li>
                    <li class="value-check-item"><i class="bi bi-check-circle-fill"></i> Biên bản bàn giao số (e-POD) chuẩn xác</li>
                    <li class="value-check-item"><i class="bi bi-check-circle-fill"></i> Bảo hiểm hàng hóa 100% khi vận chuyển</li>
                </ul>
            </div>

            <div class="value-card reveal">
                <div class="value-badge">04</div>
                <div class="value-icon-box">
                    <i class="bi bi-receipt-cutoff fs-3 text-purple"></i>
                </div>
                <h3>Bảo mật & Ký số hóa đơn VAT</h3>
                <p>Ký số hợp đồng nguyên tắc điện tử, tích hợp tự động xuất hóa đơn điện tử hợp lệ ngay khi giao hàng.</p>
                <ul class="value-checklist">
                    <li class="value-check-item"><i class="bi bi-check-circle-fill"></i> Ký số hợp đồng nguyên tắc điện tử CA</li>
                    <li class="value-check-item"><i class="bi bi-check-circle-fill"></i> Tự động xuất hóa đơn VAT điện tử hợp lệ</li>
                    <li class="value-check-item"><i class="bi bi-check-circle-fill"></i> Đối soát tự động ngân hàng qua VietQR</li>
                </ul>
            </div>
        </div>
    </section>

    <!-- 5. Steps / Quy trình 3 bước với SLA & Meta Badges -->
    <section id="steps" class="dong-steps">
        <div class="section-head reveal">
            <div class="section-tag">Quy trình số hóa</div>
            <h2 class="section-title">Cách hoạt động trong 3 bước</h2>
            <p class="section-desc">Từ thẩm định doanh nghiệp đến nhận hàng và thanh toán công nợ theo kỳ.</p>
        </div>
        <div class="steps-wrap">
            <div class="step-panel reveal">
                <div class="step-circle">1</div>
                <h3>Đăng ký doanh nghiệp</h3>
                <p>Nộp hồ sơ mã số thuế và giấy phép kinh doanh. Hệ thống thẩm định và kích hoạt hạn mức công nợ nhanh chóng.</p>
                <span class="step-meta-badge">SLA: 4 giờ • Hạn mức đến 2 Tỷ</span>
            </div>
            <div class="step-panel reveal">
                <div class="step-circle">2</div>
                <h3>Chọn sản phẩm & đặt đơn PO</h3>
                <p>Tra cứu bảng giá sỉ chiết khấu theo số lượng (MOQ). Tạo đơn đặt hàng lô lớn với hợp đồng điện tử tự động.</p>
                <span class="step-meta-badge">10,000+ SKU sỉ • Hợp đồng số tức thì</span>
            </div>
            <div class="step-panel reveal">
                <div class="step-circle">3</div>
                <h3>Nhận hàng & Thanh toán kỳ hạn</h3>
                <p>Giao hàng tận kho doanh nghiệp. Đối soát hóa đơn và thanh toán theo chu kỳ thỏa thuận (T+30 đến T+60 ngày).</p>
                <span class="step-meta-badge">Giao tận kho • Chu kỳ T+30 / T+60</span>
            </div>
        </div>
    </section>

    <!-- 6. Products / Danh mục sản phẩm sỉ với 3D Perspective Card Tilt & Antigravity Levitation -->
    <section id="products" class="dong-products">
        <div class="section-head reveal">
            <div class="section-tag">
                <i class="bi bi-stars me-1 text-amber"></i>Kho Hàng Sỉ Trọng Điểm
            </div>
            <h2 class="section-title">Danh mục sản phẩm bán sỉ nổi bật</h2>
            <p class="section-desc">Hàng chính hãng 100%, bảo hành date mới, bảng giá đại lý chiết khấu sâu theo kiện và pallet.</p>
        </div>

        <div class="products-grid">
            @foreach (var p in _products)
            {
                <div class="product-card reveal" title="Di chuột để xem hiệu ứng 3D Card Tilt">
                    <!-- Top Meta Bar: Category và MOQ -->
                    <div class="product-card-top">
                        <span class="product-cat-pill">
                            <i class="bi bi-tag-fill me-1"></i>@p.Category
                        </span>
                        <span class="product-moq-pill">
                            <i class="bi bi-box-seam me-1"></i>MOQ: <strong>@p.Moq @p.Unit</strong>
                        </span>
                    </div>

                    <!-- Visual Stage: Hiển thị sản phẩm 3D với hiệu ứng Antigravity Levitation -->
                    <div class="product-stage">
                        <div class="product-ambient-halo" style="background: radial-gradient(circle, @p.GlowColor 0%, rgba(15, 28, 63, 0) 70%);"></div>
                        <img src="@p.ImgUrl" alt="@p.Name" class="product-showcase-img" loading="lazy" />
                        <div class="product-ambient-shadow"></div>
                        <span class="product-spec-chip">@p.PackSpec</span>
                    </div>

                    <!-- Product Body Content -->
                    <div class="product-body">
                        <h3 class="product-name">@p.Name</h3>
                        <p class="product-desc">@p.Desc</p>

                        <!-- Micro Perks / B2B Advantages -->
                        <div class="product-micro-perks">
                            <span class="perk-item"><i class="bi bi-patch-check-fill text-emerald me-1"></i>Date &gt; 12T</span>
                            <span class="perk-item"><i class="bi bi-receipt text-cyan me-1"></i>VAT 100%</span>
                            <span class="perk-item margin-pill"><i class="bi bi-graph-up-arrow me-1"></i>@p.Margin</span>
                        </div>

                        <!-- Footer: Pricing & Action -->
                        <div class="product-footer">
                            <div class="product-pricing-col">
                                <div class="product-retail-ref">Giá lẻ ĐX: <s>@p.RetailPrice.ToString("#,##") ₫</s></div>
                                <div class="product-price-label">Giá sỉ đại lý</div>
                                <div class="product-price">
                                    @p.Price.ToString("#,##") <span class="price-currency">₫ / @p.Unit</span>
                                </div>
                            </div>
                            <button type="button" class="btn-product-order" @onclick='() => SelectProduct(p.Id)' title="Xem chiết khấu bậc thang và đặt hàng">
                                <span>Báo giá sỉ</span>
                                <i class="bi bi-arrow-right"></i>
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Banner Mạng lưới cung ứng thông minh 3D Three.js Isometric Nodes & Automated FIFO Data Flow -->
        <div class="supply-network-banner reveal">
            <div class="supply-banner-content">
                <span class="hero-badge mb-2 d-inline-block">Mạng Lưới Vận Hành 4.0</span>
                <h3 class="fs-4 fw-bold text-white mb-2">Hệ sinh thái phân phối số kết nối đa kênh</h3>
                <p class="text-secondary small mb-3">
                    Đồng bộ kho hàng thời gian thực, quét VietQR thanh toán 24/7 và tự động cấn trừ công nợ theo chuẩn FIFO trên sổ cái kế toán doanh nghiệp.
                </p>
                <div class="d-flex gap-2.5 flex-wrap">
                    <button type="button" class="btn btn-sm btn-primary" @onclick='async () => await SmoothScrollTo("#cta")'>
                        Hợp tác phân phối ngay
                    </button>
                    <a href="/portal/store" class="btn btn-sm btn-outline">
                        <i class="bi bi-shop me-1"></i>Cổng Đặt Hàng Đại Lý
                    </a>
                </div>
            </div>
            
            <!-- Three.js 3D Isometric Nodes Canvas thay thế ảnh tĩnh 2D -->
            <div class="supply-banner-visual" id="supply-3d-container" title="Dòng dữ liệu tự động giữa 3 điểm nút: Kho Hàng Sỉ ➔ Cổng Đại Lý ➔ Sổ Cái FIFO">
                <canvas id="supply-3d-scene"></canvas>
                <div class="supply-3d-legend">
                    <span class="legend-node node-warehouse"><i class="bi bi-building"></i> Kho Hàng Sỉ</span>
                    <span class="legend-arrow">➔</span>
                    <span class="legend-node node-portal"><i class="bi bi-qr-code"></i> Cổng Đại Lý (VietQR)</span>
                    <span class="legend-arrow">➔</span>
                    <span class="legend-node node-fifo"><i class="bi bi-journal-check"></i> Sổ Cái FIFO</span>
                </div>
            </div>
        </div>
    </section>

    <!-- Modal Xem Chi Tiết Báo Giá Sản Phẩm & Điều Hướng Trực Tiếp -->
    @if (_selectedProduct != null)
    {
        <div class="modal-backdrop-custom" @onclick="CloseProductModal">
            <div class="modal-card-custom" @onclick:stopPropagation>
                <div class="modal-header-custom">
                    <div class="d-flex align-items-center gap-3">
                        <div class="modal-prod-preview" style="background: radial-gradient(circle, @_selectedProduct.GlowColor 0%, rgba(15, 28, 63, 0) 70%);">
                            <img src="@_selectedProduct.ImgUrl" alt="@_selectedProduct.Name" />
                        </div>
                        <div>
                            <h3 class="m-0 fs-5 fw-bold text-white">@_selectedProduct.Name</h3>
                            <div class="d-flex align-items-center gap-2 mt-1">
                                <span class="badge bg-emerald-950 text-emerald-300 border border-emerald-800">Hàng sỉ chính ngạch</span>
                                <span class="badge bg-blue-950 text-blue-300 border border-blue-800">@_selectedProduct.PackSpec</span>
                            </div>
                        </div>
                    </div>
                    <button type="button" class="btn-close-custom" @onclick="CloseProductModal" aria-label="Đóng">&times;</button>
                </div>
                <div class="modal-body-custom">
                    <p class="text-slate-300 small mb-3">@_selectedProduct.Desc</p>
                    <div class="tier-pricing-box">
                        <h4 class="tier-title"><i class="bi bi-tags-fill me-2 text-cyan"></i>Bảng giá chiết khấu theo số lượng (MOQ)</h4>
                        <div class="tier-row">
                            <span>Từ @_selectedProduct.Moq @_selectedProduct.Unit (Mức tiêu chuẩn):</span>
                            <span class="fw-bold text-white">@_selectedProduct.Price.ToString("#,##") ₫ / @_selectedProduct.Unit</span>
                        </div>
                        <div class="tier-row">
                            <span>Từ @(_selectedProduct.Moq * 2) @_selectedProduct.Unit (Chiết khấu 5%):</span>
                            <span class="fw-bold text-emerald">@((_selectedProduct.Price * 0.95m).ToString("#,##")) ₫ (Tiết kiệm @((_selectedProduct.Price * 0.05m).ToString("#,##")) ₫)</span>
                        </div>
                        <div class="tier-row">
                            <span>Từ @(_selectedProduct.Moq * 5) @_selectedProduct.Unit (Chiết khấu 10% - Cấp Pallet):</span>
                            <span class="fw-bold text-amber">@((_selectedProduct.Price * 0.90m).ToString("#,##")) ₫ (Tiết kiệm @((_selectedProduct.Price * 0.10m).ToString("#,##")) ₫)</span>
                        </div>
                    </div>
                </div>
                <div class="modal-footer-custom">
                    <button type="button" class="btn btn-outline" @onclick="CloseProductModal">Đóng</button>
                    <a href="/portal/store" class="btn btn-primary">
                        <i class="bi bi-cart3 me-1"></i>Đặt Hàng Tại Cổng Đại Lý
                    </a>
                </div>
            </div>
        </div>
    }

    <!-- 7. Credit / Giải pháp công nợ B2B với 3 Gói Tín Dụng Đồng Bộ Hệ Thống AI & FIFO -->
    <section id="credit" class="dong-credit">
        <div class="credit-glass reveal">
            <div class="credit-head">
                <span class="credit-tag">Tài chính chuỗi cung ứng</span>
                <h2 class="section-title">Giải pháp công nợ doanh nghiệp B2B</h2>
                <p class="section-desc">
                    Tối ưu vốn lưu động. Nhập hàng trước, bán hàng thu tiền, sau đó thanh toán nợ theo chu kỳ thỏa thuận với 0% lãi suất trong hạn và cấn trừ nợ chuẩn FIFO.
                </p>
            </div>

            <!-- 3 Hạng Hạn Mức Tín Dụng Khớp Nghiệp Vụ Thực Tế -->
            <div class="credit-tiers-grid">
                <!-- Gói 1: Hạng Tiêu Chuẩn (Hạng B) -->
                <div class="credit-tier-card">
                    <div class="tier-name text-blue"><i class="bi bi-shield-check me-1"></i>🛡️ HẠNG TIÊU CHUẨN (HẠNG B - ỔN ĐỊNH)</div>
                    <div class="tier-limit">25 - 50 Triệu</div>
                    <div class="tier-cycle">Chu kỳ trả chậm T+30 ngày</div>
                    <ul class="tier-points">
                        <li><i class="bi bi-check2 text-emerald"></i> Mở khóa đặt sỉ trực tuyến tại Cổng Đại Lý</li>
                        <li><i class="bi bi-check2 text-emerald"></i> Tự động cấn trừ nợ theo chuẩn FIFO</li>
                        <li><i class="bi bi-check2 text-emerald"></i> Thẩm định & kích hoạt hạn mức trong 4 giờ</li>
                        <li><i class="bi bi-check2 text-emerald"></i> Miễn phí duy trì & tra cứu công nợ 24/7</li>
                    </ul>
                </div>

                <!-- Gói 2: Hạng Ưu Tiên (Hạng A) - Phổ biến -->
                <div class="credit-tier-card featured">
                    <div class="tier-name text-amber"><i class="bi bi-trophy-fill me-1"></i>🏆 HẠNG ƯU TIÊN (HẠNG A - AN TOÀN - PHỔ BIẾN)</div>
                    <div class="tier-limit">80 - 500 Triệu</div>
                    <div class="tier-cycle">Chu kỳ trả chậm T+45 ngày</div>
                    <ul class="tier-points">
                        <li><i class="bi bi-check2 text-emerald"></i> AI thẩm định nâng hạn mức tự động</li>
                        <li><i class="bi bi-check2 text-emerald"></i> 0% lãi suất trong thời hạn cam kết</li>
                        <li><i class="bi bi-check2 text-emerald"></i> Hỗ trợ phê duyệt đơn vượt trần tạm thời</li>
                        <li><i class="bi bi-check2 text-emerald"></i> Chuyên viên kế toán đối soát riêng 1-1</li>
                    </ul>
                </div>

                <!-- Gói 3: Hạng Đại Lý Chiến Lược (VIP B2B) -->
                <div class="credit-tier-card">
                    <div class="tier-name text-purple"><i class="bi bi-gem me-1"></i>💎 HẠNG ĐẠI LÝ CHIẾN LƯỢC (VIP B2B)</div>
                    <div class="tier-limit">Trên 1.2 Tỷ VNĐ</div>
                    <div class="tier-cycle">Chu kỳ trả chậm T+60 ngày</div>
                    <ul class="tier-points">
                        <li><i class="bi bi-check2 text-emerald"></i> Chiết khấu bậc thang theo Pallet & Container</li>
                        <li><i class="bi bi-check2 text-emerald"></i> Ưu tiên xuất kho hỏa tốc trong 24 giờ</li>
                        <li><i class="bi bi-check2 text-emerald"></i> Kế toán viên đối soát riêng 1-1 qua VietQR</li>
                        <li><i class="bi bi-check2 text-emerald"></i> Hỗ trợ bảo lãnh tín dụng ngân hàng (BIDV/VCB)</li>
                    </ul>
                </div>
            </div>

            <!-- 4 Phân nhóm tuổi nợ (Aging Report - FIFO) -->
            <div class="aging-preview-wrap reveal">
                <div class="aging-preview-title">
                    <span><i class="bi bi-bar-chart-line text-emerald me-2"></i>Mô phỏng 4 nhóm tuổi nợ (Aging Report - FIFO)</span>
                    <span class="badge bg-emerald-950 text-emerald-300 border border-emerald-800">Chuẩn Doanh Nghiệp</span>
                </div>
                <div class="aging-preview-grid">
                    <div class="aging-box b-green">
                        <span class="aging-box-label">0 - 30 ngày (Trong hạn)</span>
                        <span class="aging-box-val">1.2 Tỷ VNĐ</span>
                    </div>
                    <div class="aging-box b-yellow">
                        <span class="aging-box-label">31 - 60 ngày (Nhắc nhẹ)</span>
                        <span class="aging-box-val">150 Triệu VNĐ</span>
                    </div>
                    <div class="aging-box b-orange">
                        <span class="aging-box-label">61 - 90 ngày (Cảnh báo)</span>
                        <span class="aging-box-val">20 Triệu VNĐ</span>
                    </div>
                    <div class="aging-box b-red">
                        <span class="aging-box-label">&gt; 90 ngày (Nợ xấu)</span>
                        <span class="aging-box-val">0 ₫ (0.00%)</span>
                    </div>
                </div>
            </div>

            <button type="button" class="btn btn-primary btn-lg btn-magnetic mt-2" @onclick='async () => await SmoothScrollTo("#cta")'>
                <span>Đăng ký xét duyệt hạn mức công nợ</span>
                <svg class="btn-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
            </button>
        </div>
    </section>

    <!-- 8. CTA / Đăng ký doanh nghiệp với Trải Nghiệm Điều Hướng Trực Tiếp -->
    <section id="cta" class="dong-cta">
        <div class="cta-card reveal">
            <h2>Sẵn sàng mở rộng kinh doanh sỉ?</h2>
            <p>Đăng ký tài khoản doanh nghiệp ngay hôm nay để nhận bảng giá sỉ độc quyền và hạn mức công nợ ban đầu.</p>
            
            @if (_formSubmitted)
            {
                <div class="cta-success-box text-center p-4">
                    <div class="success-icon-wrap mb-3">
                        <i class="bi bi-check-circle-fill text-emerald" style="font-size: 3rem;"></i>
                    </div>
                    <h3 class="fs-4 fw-bold text-white mb-2">Thẩm Định Hồ Sơ Thành Công Bằng AI (AVA Copilot)!</h3>
                    <p class="text-slate-300 small mb-4 mx-auto" style="max-width: 520px;">
                        Hệ thống vừa thẩm định sơ bộ: Doanh nghiệp đạt điều kiện cấp <strong>Hạn mức Tiêu Chuẩn 50.000.000 đ</strong> (Chu kỳ T+30 ngày, gạch nợ tự động FIFO).
                    </p>
                    <div class="d-flex justify-content-center gap-3 flex-wrap">
                        <a href="/portal/dashboard" class="btn btn-primary btn-magnetic px-4 py-2.5">
                            <i class="bi bi-speedometer2 me-1"></i> Trải Nghiệm Cổng Đại Lý Ngay
                        </a>
                        <button type="button" class="btn btn-outline px-4 py-2.5" @onclick="() => _formSubmitted = false">
                            Đăng ký hồ sơ khác
                        </button>
                    </div>
                </div>
            }
            else
            {
                <form class="cta-form" @onsubmit="HandleSubmit">
                    <div class="form-group">
                        <label for="fullName" class="form-label-sr">Họ tên người liên hệ</label>
                        <input id="fullName" type="text" placeholder="Họ và tên người đại diện" required @bind="_contactName" />
                    </div>
                    <div class="form-group">
                        <label for="companyEmail" class="form-label-sr">Email doanh nghiệp</label>
                        <input id="companyEmail" type="email" placeholder="Email doanh nghiệp (vd: contact@company.vn)" required @bind="_contactEmail" />
                    </div>
                    <div class="form-group">
                        <label for="companyPhone" class="form-label-sr">Số điện thoại</label>
                        <input id="companyPhone" type="tel" placeholder="Số điện thoại / Zalo" required @bind="_contactPhone" />
                    </div>
                    <div class="form-group">
                        <label for="taxCode" class="form-label-sr">Mã số thuế</label>
                        <input id="taxCode" type="text" placeholder="Mã số thuế doanh nghiệp (tùy chọn)" @bind="_taxCode" />
                    </div>
                    <button type="submit" class="btn btn-primary btn-lg btn-magnetic w-100">
                        <span>Gửi thông tin đăng ký</span>
                    </button>
                </form>
            }
            <p class="cta-note">Hỗ trợ miễn phí kiểm tra hạn mức tín dụng ban đầu • Không phát sinh phí duy trì</p>
        </div>
    </section>

    <!-- Footer -->
    <footer class="dong-footer">
        <div class="footer-inner">
            <div class="footer-brand">
                <div class="nav-brand">HUEGO<span class="brand-accent"> B2B</span></div>
                <p class="footer-desc">
                    Hệ thống phân phối sỉ và quản trị tín dụng thương mại B2B hiện đại, phục vụ hơn 500 chuỗi bán lẻ và đại lý toàn quốc.
                </p>
            </div>
            <div class="footer-cols">
                <div>
                    <strong>Sản phẩm sỉ</strong>
                    <button type="button" class="footer-link-btn" @onclick='async () => await SmoothScrollTo("#products")'>Danh mục hàng sỉ</button>
                    <button type="button" class="footer-link-btn" @onclick='async () => await SmoothScrollTo("#credit")'>Hạn mức công nợ</button>
                    <a href="/portal/store" class="footer-link-btn">Cổng đặt hàng đại lý</a>
                </div>
                <div>
                    <strong>Hỗ trợ đối tác</strong>
                    <button type="button" class="footer-link-btn" @onclick='async () => await SmoothScrollTo("#steps")'>Quy trình giao nhận</button>
                    <button type="button" class="footer-link-btn" @onclick='async () => await SmoothScrollTo("#values")'>Chính sách bảo hành</button>
                    <button type="button" class="footer-link-btn text-start p-0" @onclick="OpenRoleModal">Đăng nhập tài khoản</button>
                </div>
                <div>
                    <strong>Công ty</strong>
                    <button type="button" class="footer-link-btn" @onclick='async () => await SmoothScrollTo("#hero")'>Về HUEGO B2B</button>
                    <button type="button" class="footer-link-btn" @onclick='async () => await SmoothScrollTo("#stats")'>Chỉ số tăng trưởng</button>
                    <button type="button" class="footer-link-btn" @onclick='async () => await SmoothScrollTo("#cta")'>Hợp tác phân phối</button>
                </div>
            </div>
        </div>
        <div class="footer-bottom">
            &copy; 2026 HUEGO B2B. Nền tảng bán sỉ & quản trị công nợ doanh nghiệp chuẩn FIFO. Bảo mật &amp; bản quyền.
        </div>
    </footer>

    <!-- Back to top -->
    <button id="back-to-top" class="back-to-top" @onclick='async () => await SmoothScrollTo("#hero")' aria-label="Cuộn lên đầu trang">
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 15l7-7 7 7" />
        </svg>
    </button>

    <!-- Modal Chọn Vai Trò Demo Nhanh -->
    @if (_showRoleModal)
    {
        <div class="modal-backdrop-custom" @onclick="CloseRoleModal">
            <div class="modal-card-custom" @onclick:stopPropagation style="max-width: 580px;">
                <div class="modal-header-custom">
                    <div class="d-flex align-items-center gap-3">
                        <div class="modal-icon-badge" style="background: rgba(16, 185, 129, 0.15); color: #34d399;">
                            <i class="bi bi-person-badge-fill fs-4"></i>
                        </div>
                        <div>
                            <h3 class="m-0 fs-5 fw-bold text-white">Chọn Vai Trò Trải Nghiệm Demo</h3>
                            <div class="small text-slate-300">Hệ sinh thái HUEGO B2B • Phân hệ Bán Hàng & Quản Trị Công Nợ</div>
                        </div>
                    </div>
                    <button type="button" class="btn-close-custom" @onclick="CloseRoleModal" aria-label="Đóng">&times;</button>
                </div>
                <div class="modal-body-custom">
                    <p class="text-slate-300 small mb-3">
                        Bấm vào bất kỳ vai trò nào bên dưới để hệ thống đăng nhập tức thì vào đúng phân hệ chức năng tương ứng:
                    </p>
                    <div class="role-demo-list">
                        <!-- Role 1: Kế toán -->
                        <div class="role-demo-card" @onclick='() => LoginRole("accountant", "123456", "/dashboard")'>
                            <div class="d-flex align-items-center gap-3">
                                <div class="role-demo-icon icon-accountant">
                                    <i class="bi bi-calculator"></i>
                                </div>
                                <div>
                                    <div class="fw-bold text-white fs-6 d-flex align-items-center gap-2">
                                        Kế Toán Trưởng & Quản Trị Công Nợ
                                        <span class="role-demo-badge bg-emerald-950 text-emerald-300 border border-emerald-700">accountant</span>
                                    </div>
                                    <div class="small text-slate-300 mt-1">
                                        Theo dõi 4 xô tuổi nợ, cấn trừ công nợ chuẩn FIFO, duyệt hạn mức tín dụng
                                    </div>
                                </div>
                            </div>
                            <i class="bi bi-arrow-right-circle-fill text-emerald fs-4"></i>
                        </div>

                        <!-- Role 2: Bán hàng -->
                        <div class="role-demo-card" @onclick='() => LoginRole("sales", "123456", "/dashboard")'>
                            <div class="d-flex align-items-center gap-3">
                                <div class="role-demo-icon icon-sales">
                                    <i class="bi bi-bag-check"></i>
                                </div>
                                <div>
                                    <div class="fw-bold text-white fs-6 d-flex align-items-center gap-2">
                                        Nhân Viên Bán Hàng (Sales)
                                        <span class="role-demo-badge bg-blue-950 text-blue-300 border border-blue-700">sales</span>
                                    </div>
                                    <div class="small text-slate-300 mt-1">
                                        Lập hóa đơn xuất buôn, kiểm tra trần tín dụng khách hàng, giám sát kho
                                    </div>
                                </div>
                            </div>
                            <i class="bi bi-arrow-right-circle-fill text-blue fs-4"></i>
                        </div>

                        <!-- Role 3: Cổng đại lý -->
                        <div class="role-demo-card" @onclick='() => LoginRole("customer", "123456", "/portal/dashboard")'>
                            <div class="d-flex align-items-center gap-3">
                                <div class="role-demo-icon icon-customer">
                                    <i class="bi bi-shop"></i>
                                </div>
                                <div>
                                    <div class="fw-bold text-white fs-6 d-flex align-items-center gap-2">
                                        Cổng Đại Lý - Tạp Hóa Bà Ba
                                        <span class="role-demo-badge bg-amber-950 text-amber-300 border border-amber-700">customer</span>
                                    </div>
                                    <div class="small text-slate-300 mt-1">
                                        Đặt hàng sỉ trực tuyến, xem hạn mức 100Tr, đối soát & quét VietQR thanh toán
                                    </div>
                                </div>
                            </div>
                            <i class="bi bi-arrow-right-circle-fill text-amber fs-4"></i>
                        </div>
                    </div>
                </div>
                <div class="modal-footer-custom justify-content-between">
                    <a href="/login" class="text-slate-300 small text-decoration-none">
                        <i class="bi bi-shield-lock me-1"></i>Đăng nhập tài khoản tùy chỉnh
                    </a>
                    <button type="button" class="btn btn-outline" @onclick="CloseRoleModal">Đóng</button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private bool _mobileOpen = false;
    private bool _formSubmitted = false;
    private bool _showRoleModal = false;
    private string _contactName = "";
    private string _contactEmail = "";
    private string _contactPhone = "";
    private string _taxCode = "";
    private bool _isAuthenticated = false;
    private string _dashboardUrl = "/dashboard";

    private record B2bProduct(
        int Id, 
        string ImgUrl, 
        string Name, 
        string Desc, 
        decimal Price, 
        decimal RetailPrice, 
        int Moq, 
        string Unit, 
        string Category, 
        string PackSpec, 
        string Margin, 
        string GlowColor
    );

    private List<B2bProduct> _products = new()
    {
        new(
            1, 
            "images/products/sp001-coca-cola.svg", 
