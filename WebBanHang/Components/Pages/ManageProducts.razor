@page "/manage-products"
@attribute [Authorize(Roles = "Accountant,Sales")]
@rendermode InteractiveServer

@using WebBanHang.UseCases.Products
@using WebBanHang.UseCases.DTOs
@using WebBanHang.CoreBusiness.Entities
@inject IViewProductCatalogUseCase ViewProductCatalogUseCase
@inject IManageProductUseCase ManageProductUseCase

<PageTitle>Quản Lý Sản Phẩm & Tồn Kho</PageTitle>

<div class="app-page-container">
    <PageHeader Title="Danh Mục Sản Phẩm & Giá Sỉ"
                Subtitle="Quản lý tồn kho FMCG, giá vốn COGS và chính sách bán sỉ cho đại lý"
                Icon="bi-box-seam">
        <Actions>
            <button class="btn btn-primary" @onclick="ResetForm">
                <i class="bi bi-plus-circle me-1"></i> Thêm Sản Phẩm Mới
            </button>
        </Actions>
    </PageHeader>

@if (!string.IsNullOrEmpty(successMessage))
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@successMessage
        <button type="button" class="btn-close" @onclick="() => successMessage = null"></button>
    </div>
}
@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@errorMessage
        <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
    </div>
}

<!-- THỐNG KÊ TỔNG VỐN BỎ RA & ĐỐI CHIẾU DOANH THU KHO -->
@if (allProducts != null && allProducts.Any())
{
    var totalCostStock = allProducts.Sum(p => p.StockQuantity * p.CostPrice);
    var totalRevenueStock = allProducts.Sum(p => p.StockQuantity * p.UnitPrice);
    var totalProfitStock = totalRevenueStock - totalCostStock;
    var avgMargin = totalRevenueStock > 0 ? Math.Round((totalProfitStock / totalRevenueStock) * 100, 1) : 0;

    <div class="row g-3 mb-4">
        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-3 p-3 bg-white h-100 border-start border-4 border-danger">
                <div class="d-flex align-items-center justify-content-between mb-1">
                    <span class="text-muted small fw-semibold text-uppercase" style="font-size: 13px;">Tổng Vốn Bỏ Ra (Giá Nhập)</span>
                    <i class="bi bi-wallet2 text-danger fs-5"></i>
                </div>
                <div class="fs-4 fw-bold text-slate-navy">@totalCostStock.ToString("N0") <small class="fs-6 fw-normal text-muted">đ</small></div>
                <small class="text-muted" style="font-size: 13px;">Số tiền vốn đã thanh toán cho nhà cung cấp</small>
            </div>
        </div>

        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-3 p-3 bg-white h-100 border-start border-4 border-primary">
                <div class="d-flex align-items-center justify-content-between mb-1">
                    <span class="text-muted small fw-semibold text-uppercase" style="font-size: 13px;">Giá Trị Bán Sỉ Tiềm Năng</span>
                    <i class="bi bi-graph-up-arrow text-primary fs-5"></i>
                </div>
                <div class="fs-4 fw-bold text-primary">@totalRevenueStock.ToString("N0") <small class="fs-6 fw-normal text-muted">đ</small></div>
                <small class="text-muted" style="font-size: 13px;">Doanh số nếu phân phối hết hàng tồn kho</small>
            </div>
        </div>

        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-3 p-3 bg-white h-100 border-start border-4 border-success">
                <div class="d-flex align-items-center justify-content-between mb-1">
                    <span class="text-muted small fw-semibold text-uppercase" style="font-size: 13px;">Lợi Nhuận Gộp Kỳ Vọng</span>
                    <i class="bi bi-piggy-bank text-success fs-5"></i>
                </div>
                <div class="fs-4 fw-bold text-success">+@totalProfitStock.ToString("N0") <small class="fs-6 fw-normal text-muted">đ</small></div>
                <small class="text-muted" style="font-size: 13px;">Chênh lệch lãi = Bán sỉ - Giá vốn</small>
            </div>
        </div>

        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-3 p-3 bg-white h-100 border-start border-4 border-info">
                <div class="d-flex align-items-center justify-content-between mb-1">
                    <span class="text-muted small fw-semibold text-uppercase" style="font-size: 13px;">Biên Lợi Nhuận Bình Quân</span>
                    <i class="bi bi-percent text-info fs-5"></i>
                </div>
                <div class="fs-4 fw-bold text-dark">@avgMargin%</div>
                <small class="text-muted" style="font-size: 13px;">Tỷ suất sinh lời trên doanh thu phân phối</small>
            </div>
        </div>
    </div>
}

<div class="row g-4">
    <!-- CỘT 1: FORM THÊM / SỬA SẢN PHẨM -->
    <div class="col-lg-4">
        <div class="card border shadow-sm" style="border-radius: 16px; border-color: #e5eaf1 !important; background: #ffffff;">
            <div class="card-header bg-white border-bottom py-3 px-4 d-flex align-items-center justify-content-between" style="border-color: #e5eaf1 !important;">
                <h5 class="mb-0 fw-bold text-dark fs-6 d-flex align-items-center gap-2">
                    <i class="bi @(productModel.Id == 0 ? "bi-plus-circle" : "bi-pencil-square") text-primary"></i>
                    @(productModel.Id == 0 ? "Thêm Sản Phẩm Mới" : "Cập Nhật Sản Phẩm")
                </h5>
            </div>
            <div class="card-body p-4">
                <EditForm Model="@productModel" OnValidSubmit="HandleSaveProduct">
                    <DataAnnotationsValidator />

                    <div class="mb-3">
                        <label class="form-label fw-bold">Mã sản phẩm <span class="text-danger">*</span></label>
                        <InputText @bind-Value="productModel.ProductCode" class="form-control" placeholder="VD: SP009, COCA01..." />
                        <ValidationMessage For="() => productModel.ProductCode" class="text-danger small" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Tên sản phẩm <span class="text-danger">*</span></label>
                        <InputText @bind-Value="productModel.Name" class="form-control" placeholder="Tên hàng hóa chi tiết..." />
                        <ValidationMessage For="() => productModel.Name" class="text-danger small" />
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label fw-bold">Đơn vị tính <span class="text-danger">*</span></label>
                            <InputText @bind-Value="productModel.Unit" class="form-control" placeholder="Thùng, Két, Lon, Chai..." />
                            <ValidationMessage For="() => productModel.Unit" class="text-danger small" />
                        </div>
                        <div class="col-6">
                            <label class="form-label fw-bold">Số lượng tồn kho</label>
                            <InputNumber @bind-Value="productModel.StockQuantity" class="form-control" />
                            <ValidationMessage For="() => productModel.StockQuantity" class="text-danger small" />
                        </div>
                    </div>

                    <!-- KHỐI ĐỐI CHIẾU GIÁ NHẬP (VỐN) VÀ GIÁ BÁN SỈ -->
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label fw-bold text-danger">Giá Nhập (Giá Vốn) <span class="text-danger">*</span></label>
                            <InputNumber @bind-Value="productModel.CostPrice" class="form-control border-danger-subtle" placeholder="Tiền bỏ ra mua..." />
                            <ValidationMessage For="() => productModel.CostPrice" class="text-danger small" />
                            <small class="text-muted d-block" style="font-size: 13px;">Giá mua từ nhà máy</small>
                        </div>
                        <div class="col-6">
                            <label class="form-label fw-bold text-primary">Giá Bán Sỉ (VNĐ) <span class="text-danger">*</span></label>
                            <InputNumber @bind-Value="productModel.UnitPrice" class="form-control border-primary-subtle" placeholder="Bán cho đại lý..." />
                            <ValidationMessage For="() => productModel.UnitPrice" class="text-danger small" />
                            <small class="text-muted d-block" style="font-size: 13px;">Giá xuất kho đại lý</small>
                        </div>
                    </div>

                    <!-- THẺ PHÂN TÍCH LÃI GỘP THỜI GIAN THỰC -->
                    @{
                        decimal formProfit = productModel.UnitPrice - productModel.CostPrice;
                        decimal formMargin = productModel.UnitPrice > 0 ? Math.Round((formProfit / productModel.UnitPrice) * 100, 1) : 0;
                    }
                    <div class="p-2.5 rounded-3 mb-3 @(formProfit >= 0 ? "bg-success-subtle border border-success-subtle" : "bg-danger-subtle border border-danger-subtle")">
                        <div class="d-flex justify-content-between align-items-center small">
                            <span class="fw-semibold">Lãi gộp dự kiến:</span>
                            <span class="fw-bold @(formProfit >= 0 ? "text-success" : "text-danger")">
                                @(formProfit >= 0 ? $"+{formProfit:N0} đ" : $"{formProfit:N0} đ")
                            </span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center small mt-1">
                            <span class="fw-semibold">Biên lợi nhuận:</span>
                            <span class="fw-bold @(formProfit >= 0 ? "text-success" : "text-danger")">@formMargin%</span>
                        </div>
                        @if (productModel.CostPrice > 0 && productModel.UnitPrice > 0 && formProfit <= 0)
                        {
                            <div class="text-danger small mt-1 fw-bold">
                                <i class="bi bi-exclamation-triangle-fill"></i> Cảnh báo: Giá bán thấp hơn hoặc bằng giá vốn!
                            </div>
                        }
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Hình ảnh sản phẩm (URL hoặc đường dẫn ảnh)</label>
                        <InputText @bind-Value="productModel.ImageUrl" class="form-control" placeholder="VD: /images/products/sp001-coca-cola.svg" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Mô tả sản phẩm</label>
                        <InputTextArea @bind-Value="productModel.Description" class="form-control" rows="2" placeholder="Ghi chú chi tiết quy cách, tính năng..." />
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary fw-bold py-2">
                            <i class="bi bi-save me-1"></i> @(productModel.Id == 0 ? "Thêm Vào Kho" : "Lưu Thay Đổi")
                        </button>
                        @if (productModel.Id > 0)
                        {
                            <button type="button" class="btn btn-outline-secondary" @onclick="ResetForm">
                                <i class="bi bi-x-circle me-1"></i> Hủy chỉnh sửa
                            </button>
                        }
                    </div>
                </EditForm>
            </div>
        </div>
    </div>

    <!-- CỘT 2: BẢNG DANH MỤC HÀNG HÓA -->
    <div class="col-lg-8">
        <div class="card border shadow-sm" style="border-radius: 16px; border-color: #e5eaf1 !important; background: #ffffff;">
            <div class="card-header bg-white py-3 px-4 border-bottom d-flex justify-content-between align-items-center" style="border-color: #e5eaf1 !important;">
                <h5 class="mb-0 fw-bold text-dark">
                    <i class="bi bi-boxes text-primary me-2"></i>Danh Sách Hàng Hóa Trong Kho
                </h5>
                <div class="d-flex align-items-center gap-2">
                    <span class="badge bg-danger">Sắp hết: @lowStockCount</span>
                    <span class="badge bg-primary">Tổng: @(products?.Count() ?? 0) SP</span>
                </div>
            </div>
            <div class="p-3 bg-light border-top border-bottom">
                <div class="input-group">
                    <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                    <input type="text" class="form-control" placeholder="Tìm theo tên hoặc mã sản phẩm..."
                           @bind="searchKeyword" @bind:event="oninput" @onkeyup="HandleSearch" />
                    @if (!string.IsNullOrEmpty(searchKeyword))
                    {
                        <button class="btn btn-outline-secondary" @onclick="ClearSearch">Xóa</button>
                    }
                </div>
            </div>
            <div class="card-body p-0">
                @if (loading)
                {
                    <div class="text-center py-5">
                        <div class="spinner-border text-primary" role="status"></div>
                        <p class="mt-2 text-muted">Đang tải danh mục sản phẩm...</p>
                    </div>
                }
                else if (products == null || !products.Any())
                {
                    <div class="text-center py-5 text-muted">
                        <i class="bi bi-box-seam fs-1 d-block mb-2 text-secondary"></i>
                        Không có sản phẩm nào trong kho.
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light small">
                                <tr>
                                    <th style="width: 50px;" class="text-center">Ảnh</th>
                                    <th>Mã SP</th>
                                    <th>Tên Hàng Hóa</th>
                                    <th class="text-center">ĐVT</th>
                                    <th class="text-end text-danger">Giá Nhập (Vốn)</th>
                                    <th class="text-end text-primary">Giá Bán Sỉ</th>
                                    <th class="text-end text-success">Lãi Gộp / Biên Độ</th>
                                    <th class="text-center">Tồn Kho</th>
                                    <th class="text-end">Vốn Tồn Kho</th>
                                    <th class="text-center">Thao Tác</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var p in products)
                                {
                                    var itemTotalCost = p.StockQuantity * p.CostPrice;
                                    <tr>
                                        <td class="text-center">
                                            <img src="@(string.IsNullOrEmpty(p.ImageUrl) ? "/images/products/sp001-coca-cola.svg" : p.ImageUrl)" 
                                                 alt="@p.Name" 
                                                 style="width: 38px; height: 38px; object-fit: contain;" 
                                                 class="rounded border bg-white p-1 shadow-xs" />
                                        </td>
                                        <td><span class="badge bg-light text-secondary border font-monospace">@p.ProductCode</span></td>
                                        <td>
                                            <div class="fw-bold">@p.Name</div>
                                            @if (!string.IsNullOrEmpty(p.Description))
                                            {
                                                <small class="text-muted text-truncate d-inline-block" style="max-width: 180px;">@p.Description</small>
                                            }
                                        </td>
                                        <td class="text-center">@p.Unit</td>
                                        <td class="text-end text-muted fw-semibold">@p.CostPrice.ToString("N0") đ</td>
                                        <td class="text-end fw-bold text-primary">@p.UnitPrice.ToString("N0") đ</td>
                                        <td class="text-end">
                                            <span class="badge bg-success-subtle text-success border border-success-subtle">
                                                +@p.UnitProfit.ToString("N0") đ (@p.ProfitMargin%)
                                            </span>
                                        </td>
                                        <td class="text-center">
                                            @if (p.StockQuantity <= 5)
                                            {
                                                <span class="badge bg-danger" title="Cần nhập hàng ngay!">
                                                    <i class="bi bi-exclamation-circle-fill"></i> Còn @p.StockQuantity
                                                </span>
                                            }
                                            else if (p.StockQuantity <= 15)
                                            {
                                                <span class="badge bg-warning text-dark" title="Sắp hết hàng">
                                                    Còn @p.StockQuantity
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-success">
                                                    Còn @p.StockQuantity
                                                </span>
                                            }
                                        </td>
                                        <td class="text-end fw-bold text-slate-navy small">
                                            @itemTotalCost.ToString("N0") đ
                                        </td>
                                        <td class="text-center">
                                            <div class="btn-group btn-group-sm">
                                                <button class="btn btn-outline-primary" @onclick="() => EditProduct(p)" title="Chỉnh sửa sản phẩm & giá">
                                                    <i class="bi bi-pencil"></i> Sửa
                                                </button>
                                                <button class="btn btn-outline-danger" @onclick="() => DeleteProduct(p.Id, p.Name)" title="Xóa">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

</div><!-- /app-page-container -->

@code {
    private IEnumerable<Product>? allProducts;
    private IEnumerable<Product>? products;
    private ProductInputModel productModel = new();
    private bool loading = true;
    private string searchKeyword = "";
    private string? successMessage;
    private string? errorMessage;
    private int lowStockCount = 0;

    protected override async Task OnInitializedAsync()
    {
        await LoadProducts();
    }

    private async Task LoadProducts()
    {
        loading = true;
        try
        {
            allProducts = await ViewProductCatalogUseCase.ExecuteAsync();
            lowStockCount = allProducts.Count(p => p.StockQuantity <= 15);
            ApplyFilter();
        }
        finally
        {
            loading = false;
        }
    }

    private void HandleSearch()
    {
        ApplyFilter();
    }

    private void ClearSearch()
    {
        searchKeyword = "";
        ApplyFilter();
    }

    private void ApplyFilter()
    {
        if (allProducts == null) return;

        if (string.IsNullOrWhiteSpace(searchKeyword))
        {
            products = allProducts.ToList();
        }
        else
        {
            var kw = searchKeyword.Trim().ToLower();
            products = allProducts.Where(p => p.Name.ToLower().Contains(kw) || p.ProductCode.ToLower().Contains(kw)).ToList();
        }
    }

    private void EditProduct(Product p)
    {
        productModel = new ProductInputModel
        {
            Id = p.Id,
            ProductCode = p.ProductCode,
            Name = p.Name,
            Unit = p.Unit,
            UnitPrice = p.UnitPrice,
            CostPrice = p.CostPrice,
            StockQuantity = p.StockQuantity,
            ImageUrl = p.ImageUrl ?? "",
            Description = p.Description
        };
        successMessage = null;
        errorMessage = null;
    }

    private void ResetForm()
    {
        productModel = new ProductInputModel();
        successMessage = null;
        errorMessage = null;
    }

    private async Task HandleSaveProduct()
    {
        try
        {
            if (productModel.Id == 0)
            {
                await ManageProductUseCase.AddProductAsync(productModel);
                successMessage = $"Đã thêm sản phẩm \"{productModel.Name}\" vào danh mục thành công!";
            }
            else
            {
                await ManageProductUseCase.UpdateProductAsync(productModel);
                successMessage = $"Đã cập nhật sản phẩm \"{productModel.Name}\" thành công!";
            }

            ResetForm();
            await LoadProducts();
        }
        catch (Exception ex)
        {
            errorMessage = $"Lỗi khi lưu sản phẩm: {ex.Message}";
        }
    }

    private async Task DeleteProduct(int id, string name)
    {
        try
        {
            await ManageProductUseCase.DeleteProductAsync(id);
            successMessage = $"Đã xóa sản phẩm \"{name}\" khỏi danh mục.";
            await LoadProducts();
        }
        catch (Exception ex)
        {
            errorMessage = $"Không thể xóa sản phẩm do đã có trong hóa đơn bán hàng: {ex.Message}";
        }
    }
}
