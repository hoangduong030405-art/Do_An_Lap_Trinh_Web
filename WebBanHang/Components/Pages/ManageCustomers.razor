    private void ApproveAndSendReminder()
    {
        if (selectedRiskAssessment != null)
        {
            LedgerState.AddReminderSent(selectedRiskAssessment.CustomerId, selectedRiskAssessment.CustomerName, selectedTone, customReminderDraft);
        }
        emailSentMessage = $"Đã duyệt và gửi thông báo nhắc nợ thành công tới đại lý {selectedRiskAssessment?.CustomerName} qua Email & Zalo OA!";
    }

