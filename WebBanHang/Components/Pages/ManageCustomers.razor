@page "/manage-customers"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using WebBanHang.UseCases.Reports
@attribute [Authorize(Roles = "Accountant,Sales")]

@using WebBanHang.UseCases.Customers
@using WebBanHang.UseCases.DTOs
@using WebBanHang.CoreBusiness.Entities
@using WebBanHang.Services

@inject IViewCustomerListUseCase ViewCustomerListUseCase
@inject IManageCustomerUseCase ManageCustomerUseCase
@inject IAssessCreditRiskUseCase AssessCreditRiskUseCase
@inject IGetCustomerAgingReportUseCase GetCustomerAgingReportUseCase
@inject LedgerConfirmationStateService LedgerState
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Quản Lý Khách Hàng & AI Tín Dụng</PageTitle>

<div class="app-page-container">
    <PageHeader Title="Hồ Sơ Khách Hàng & Hạn Mức Tín Dụng"
                Subtitle="Thẩm định hạn mức, giám sát nợ tồn và xếp hạng tín dụng doanh nghiệp"
                Icon="bi-people-fill">
        <Actions>
            @if (!isSales)
            {
                <button class="btn btn-primary" @onclick="ResetForm">
                    <i class="bi bi-person-plus me-1"></i> Thêm Khách Hàng
                </button>
            }
        </Actions>
    </PageHeader>

@if (!string.IsNullOrEmpty(successMessage))
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@successMessage
        <button type="button" class="btn-close" @onclick="() => successMessage = string.Empty"></button>
    </div>
}

<div class="row g-4">
    @if (!isSales)
    {
        <!-- FORM BÊN TRÁI -->
        <div class="col-lg-4">
        <div class="card border shadow-sm" style="border-radius: 16px; border-color: #e5eaf1 !important; background: #ffffff;">
            <div class="card-header bg-white border-bottom py-3 px-4 d-flex align-items-center justify-content-between" style="border-color: #e5eaf1 !important;">
                <h5 class="mb-0 fw-bold text-dark fs-6 d-flex align-items-center gap-2">
                    <i class="bi @(customerModel.Id == 0 ? "bi-person-plus-fill" : "bi-pencil-square") text-primary"></i>
                    @(customerModel.Id == 0 ? "Thêm Khách Hàng Mới" : "Sửa Khách Hàng")
                </h5>
            </div>
            <div class="card-body p-4">
                <EditForm Model="@customerModel" OnValidSubmit="HandleSaveCustomer">
                    <DataAnnotationsValidator />
                    
                    <div class="mb-3">
                        <label class="form-label fw-bold">Mã khách hàng <span class="text-danger">*</span></label>
                        <InputText @bind-Value="customerModel.CustomerCode" class="form-control" disabled="@(customerModel.Id > 0)" placeholder="VD: KH006..." />
                        <ValidationMessage For="() => customerModel.CustomerCode" class="text-danger small" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Họ tên khách hàng <span class="text-danger">*</span></label>
                        <InputText @bind-Value="customerModel.FullName" class="form-control" placeholder="Tên công ty hoặc người mua..." />
                        <ValidationMessage For="() => customerModel.FullName" class="text-danger small" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Số điện thoại <span class="text-danger">*</span></label>
                        <InputText @bind-Value="customerModel.PhoneNumber" class="form-control" placeholder="0901234567..." />
                        <ValidationMessage For="() => customerModel.PhoneNumber" class="text-danger small" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Địa chỉ <span class="text-danger">*</span></label>
                        <InputText @bind-Value="customerModel.Address" class="form-control" placeholder="Địa chỉ giao hàng..." />
                        <ValidationMessage For="() => customerModel.Address" class="text-danger small" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Hạn mức tín dụng (VNĐ) <span class="text-danger">*</span></label>
                        <InputNumber @bind-Value="customerModel.CreditLimit" class="form-control" />
                        <ValidationMessage For="() => customerModel.CreditLimit" class="text-danger small" />
                        <small class="text-muted">Mức nợ tối đa khách hàng được phép mua nợ gối đầu.</small>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Hạn nợ tiêu chuẩn (Ngày) <span class="text-danger">*</span></label>
                        <InputNumber @bind-Value="customerModel.PaymentTermsDays" class="form-control" />
                        <ValidationMessage For="() => customerModel.PaymentTermsDays" class="text-danger small" />
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary fw-bold py-2">
                            <i class="bi bi-save me-1"></i> @(customerModel.Id == 0 ? "Thêm Mới" : "Lưu Thông Tin")
                        </button>
                        @if (customerModel.Id > 0)
                        {
                            <button type="button" class="btn btn-outline-secondary" @onclick="ResetForm">Hủy bỏ</button>
                        }
                    </div>
                </EditForm>
            </div>
        </div>
        </div>
    }

    <!-- BẢNG KHÁCH HÀNG & XẾP HẠNG AI -->
    <div class="@(isSales ? "col-12" : "col-lg-8")">
        <div class="card border shadow-sm" style="border-radius: 16px; border-color: #e5eaf1 !important; background: #ffffff;">
            <div class="card-header bg-white py-3 px-4 border-bottom d-flex justify-content-between align-items-center" style="border-color: #e5eaf1 !important;">
                <h5 class="mb-0 fw-bold text-dark">
                    <i class="bi bi-people-fill text-primary me-2"></i>Danh Sách Khách Hàng & Đánh Giá Tín Dụng AI
                </h5>
                <span class="badge bg-primary">@(customers?.Count() ?? 0) Khách hàng</span>
            </div>
            <div class="card-body p-0">
                @if (customers == null)
                {
                    <div class="text-center py-5">
                        <div class="spinner-border text-primary" role="status"></div>
                        <p class="mt-2 text-muted">Đang tải danh sách khách hàng...</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive bg-white" style="background-color: #ffffff !important;">
                        <table class="table table-hover align-middle mb-0 bg-white" style="background-color: #ffffff !important; --bs-table-bg: #ffffff !important;">
                            <thead style="background-color: #f1f5f9 !important;">
                                <tr style="background-color: #f1f5f9 !important;">
                                    <th style="font-size: 14.5px; font-weight: 700; color: #334155;">Khách Hàng</th>
                                    <th style="font-size: 14.5px; font-weight: 700; color: #334155;">Điện Thoại</th>
                                    <th class="text-end" style="font-size: 14.5px; font-weight: 700; color: #334155;">Hạn Mức</th>
                                    <th class="text-center" style="font-size: 14.5px; font-weight: 700; color: #334155;">Hạn Nợ</th>
                                    <th class="text-center" style="font-size: 14.5px; font-weight: 700; color: #334155;">Xếp Hạng AI</th>
                                    <th class="text-center" style="font-size: 14.5px; font-weight: 700; color: #334155;">Thao Tác</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var c in customers)
                                {
                                    var assessment = assessments?.GetValueOrDefault(c.Id);
                                    <tr>
                                        <td>
                                            <div class="fw-bold">@c.FullName</div>
                                            <small class="text-muted">@c.CustomerCode</small>
                                        </td>
                                        <td>@c.PhoneNumber</td>
                                        <td class="text-end fw-bold">@c.CreditLimit.ToString("N0") đ</td>
                                        <td class="text-center">@c.PaymentTermsDays ngày</td>
                                        <td class="text-center">
                                            @if (assessment != null)
                                            {
                                                @if (assessment.RatingGrade == "A")
                                                {
                                                    <span class="badge bg-success" title="Điểm: @assessment.CreditScore/100">
                                                        <i class="bi bi-shield-check"></i> Hạng A (An Toàn)
                                                    </span>
                                                }
                                                else if (assessment.RatingGrade == "B")
                                                {
                                                    <span class="badge bg-primary" title="Điểm: @assessment.CreditScore/100">
                                                        <i class="bi bi-shield"></i> Hạng B (Ổn Định)
                                                    </span>
                                                }
                                                else if (assessment.RatingGrade == "C")
                                                {
                                                    <span class="badge bg-warning text-dark" title="Điểm: @assessment.CreditScore/100">
                                                        <i class="bi bi-shield-exclamation"></i> Hạng C (Cảnh Báo)
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-danger" title="Điểm: @assessment.CreditScore/100">
                                                        <i class="bi bi-shield-x"></i> Hạng D (Rủi Ro Cao)
                                                    </span>
                                                }
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">Chưa đánh giá</span>
                                            }
                                        </td>
                                        <td class="text-center">
                                            <div class="btn-group btn-group-sm">
                                                @if (!isSales)
                                                {
                                                    <button class="btn btn-outline-primary" @onclick="() => EditCustomer(c)">
                                                        Sửa
                                                    </button>
                                                }
                                                <button class="btn btn-outline-warning text-dark fw-semibold" @onclick="() => OpenRiskModal(c.Id)">
                                                    🤖 AI Soi Nợ
                                                </button>
                                                @if (isSales)
                                                {
                                                    <a href="/create-invoice?customerId=@c.Id" class="btn btn-primary fw-semibold">
                                                        <i class="bi bi-cart-plus me-1"></i>Lập Đơn Hàng
                                                    </a>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- MODAL XEM PHÂN TÍCH RỦI RO TÍN DỤNG AI -->
@if (selectedRiskAssessment != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.6);" role="dialog">
        <div class="modal-dialog modal-lg modal-dialog-centered" role="document">
            <div class="modal-content border-0 shadow-lg">
                <div class="modal-header bg-white border-bottom text-dark">
                    <h5 class="modal-title fw-bold">
                        <i class="bi bi-cpu me-2 text-warning"></i>Báo Cáo Thẩm Định Tín Dụng AI: @selectedRiskAssessment.CustomerName
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => selectedRiskAssessment = null"></button>
                </div>
                <div class="modal-body p-4">
                    <!-- Điểm số & Xếp hạng -->
                    <div class="row align-items-center mb-4 p-3 bg-light rounded">
                        <div class="col-md-4 text-center border-end">
                            <div class="display-4 fw-bold @(selectedRiskAssessment.CreditScore >= 80 ? "text-success" : selectedRiskAssessment.CreditScore >= 60 ? "text-primary" : selectedRiskAssessment.CreditScore >= 40 ? "text-warning" : "text-danger")">
                                @selectedRiskAssessment.CreditScore
                            </div>
                            <div class="text-muted small">Điểm Tín Nhiệm (Thang 100)</div>
                        </div>
                        <div class="col-md-8 ps-md-4">
                            <div class="d-flex align-items-center gap-2 mb-2">
                                <span class="fs-4 fw-bold">Hạng @selectedRiskAssessment.RatingGrade</span>
                                <span class="badge @(selectedRiskAssessment.RatingGrade == "A" ? "bg-success" : selectedRiskAssessment.RatingGrade == "B" ? "bg-primary" : selectedRiskAssessment.RatingGrade == "C" ? "bg-warning text-dark" : "bg-danger")">
                                    Mức độ rủi ro: @selectedRiskAssessment.RiskLevel
                                </span>
                            </div>
                            <div class="progress mb-2" style="height: 10px;">
                                <div class="progress-bar @(selectedRiskAssessment.CreditScore >= 80 ? "bg-success" : selectedRiskAssessment.CreditScore >= 60 ? "bg-primary" : selectedRiskAssessment.CreditScore >= 40 ? "bg-warning" : "bg-danger")"
                                     style="width: @selectedRiskAssessment.CreditScore%"></div>
                            </div>
                            <div class="d-flex justify-content-between small text-muted">
                                <span>0 (Cực nguy hiểm)</span>
                                <span>50</span>
                                <span>100 (Tuyệt đối an toàn)</span>
                            </div>
                        </div>
                    </div>

                    <!-- Chỉ số thực tế -->
                    <div class="row g-3 mb-4 text-center">
                        <div class="col-4">
                            <div class="border rounded p-2">
                                <small class="text-muted d-block">Dư Nợ Hiện Tại</small>
                                <strong class="text-danger">@selectedRiskAssessment.CurrentDebt.ToString("N0") đ</strong>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="border rounded p-2">
                                <small class="text-muted d-block">Tỷ Lệ Chạm Hạn Mức</small>
                                <strong class="@(selectedRiskAssessment.DebtUtilizationRate >= 100 ? "text-danger" : selectedRiskAssessment.DebtUtilizationRate >= 80 ? "text-warning" : "text-success")">
                                    @selectedRiskAssessment.DebtUtilizationRate.ToString("N0")%
                                </strong>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="border rounded p-2">
                                <small class="text-muted d-block">Quá Hạn Lâu Nhất</small>
                                <strong class="@(selectedRiskAssessment.MaxOverdueDays > 0 ? "text-danger" : "text-success")">
                                    @(selectedRiskAssessment.MaxOverdueDays > 0 ? $"{selectedRiskAssessment.MaxOverdueDays} Ngày" : "Không")
                                </strong>
                            </div>
                        </div>
                    </div>

                    <!-- Khuyến nghị AI -->
                    <div class="card border-warning mb-3">
                        <div class="card-header bg-warning text-dark fw-bold">
                            <i class="bi bi-lightbulb-fill me-1"></i> Khuyến Nghị Của Trợ Lý AI:
                        </div>
                        <div class="card-body">
                            <p class="mb-0 fw-bold text-dark">@selectedRiskAssessment.Recommendation</p>
                        </div>
                    </div>

                    <!-- Các yếu tố rủi ro -->
                    @if (selectedRiskAssessment.RiskFactors.Any())
                    {
                        <div class="mb-3">
                            <h6 class="fw-bold text-danger"><i class="bi bi-exclamation-octagon-fill me-1"></i> Các Yếu Tố Báo Động:</h6>
                            <ul class="list-group">
                                @foreach (var factor in selectedRiskAssessment.RiskFactors)
                                {
                                    <li class="list-group-item list-group-item-danger small">
                                        <i class="bi bi-x-circle me-1"></i> @factor
                                    </li>
                                }
                            </ul>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-success small mb-0">
                            <i class="bi bi-check-circle me-1"></i> Khách hàng có lịch sử tín dụng hoàn hảo, không có bất kỳ yếu tố rủi ro nào.
                        </div>
                    }
                    <!-- BÁO CÁO PHÂN TÍCH 4 XÔ TUỔI NỢ -->
                    <div class="mb-4">
                        <h6 class="fw-bold text-dark mb-2">
                            <i class="bi bi-bar-chart-steps text-primary me-1"></i> Phân Tích Tuổi Nợ (4 Xô Công Nợ):
                        </h6>
                        <div class="row g-2 text-center">
                            <div class="col-3">
                                <div class="p-2 border rounded bg-light">
                                    <small class="text-muted d-block" style="font-size: 13px;">1-30 Ngày</small>
                                    <strong class="text-primary" style="font-size: 14.5px;">@((selectedAgingReport?.Bucket1To30 ?? 0).ToString("N0")) đ</strong>
                                </div>
                            </div>
                            <div class="col-3">
                                <div class="p-2 border rounded bg-light">
                                    <small class="text-muted d-block" style="font-size: 13px;">31-60 Ngày</small>
                                    <strong class="text-warning" style="font-size: 14.5px;">@((selectedAgingReport?.Bucket31To60 ?? 0).ToString("N0")) đ</strong>
                                </div>
                            </div>
                            <div class="col-3">
                                <div class="p-2 border rounded bg-light">
                                    <small class="text-muted d-block" style="font-size: 13px;">61-90 Ngày</small>
                                    <strong style="color: #ea580c; font-size: 14.5px;">@((selectedAgingReport?.Bucket61To90 ?? 0).ToString("N0")) đ</strong>
                                </div>
                            </div>
                            <div class="col-3">
                                <div class="p-2 border rounded bg-light">
                                    <small class="text-muted d-block" style="font-size: 13px;">&gt;90 Ngày</small>
                                    <strong class="text-danger" style="font-size: 14.5px;">@((selectedAgingReport?.BucketOver90 ?? 0).ToString("N0")) đ</strong>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- TRỢ LÝ AI SOẠN THƯ NHẮC NỢ CÁ NHÂN HÓA 3 TÔNG GIỌNG -->
                    <div class="card border mb-3">
                        <div class="card-header bg-light py-2 px-3 d-flex flex-wrap align-items-center justify-content-between gap-2">
                            <span class="fw-bold text-dark small">
                                <i class="bi bi-robot text-primary me-1"></i> Soạn Thư Nhắc Nợ Cá Nhân Hóa (AI Draft)
                            </span>
                            <div class="btn-group btn-group-sm" role="group">
                                <button type="button" class="btn @(selectedTone == "friendly" ? "btn-success" : "btn-outline-secondary")" @onclick='() => SelectReminderTone("friendly")'>
                                    Nhẹ nhàng (1-30 ngày)
                                </button>
                                <button type="button" class="btn @(selectedTone == "firm" ? "btn-warning text-dark fw-bold" : "btn-outline-secondary")" @onclick='() => SelectReminderTone("firm")'>
                                    Cương quyết (31-60 ngày)
                                </button>
                                <button type="button" class="btn @(selectedTone == "warning" ? "btn-danger" : "btn-outline-secondary")" @onclick='() => SelectReminderTone("warning")'>
                                    Cảnh báo ngừng bán (&gt;90 ngày)
                                </button>
                            </div>
                        </div>
                        <div class="card-body p-3">
                            <textarea class="form-control font-monospace" rows="6" style="font-size: 13.5px;" @bind="customReminderDraft"></textarea>
                            @if (!string.IsNullOrEmpty(emailSentMessage))
                            {
                                <div class="alert alert-success py-2 px-3 mt-2 mb-0 small">
                                    <i class="bi bi-check-circle-fill me-1"></i> @emailSentMessage
                                </div>
                            }
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light d-flex justify-content-between">
                    <button type="button" class="btn btn-secondary" @onclick="() => selectedRiskAssessment = null">Đóng</button>
                    <div class="d-flex gap-2">
                        <a href="/customer-ledger" class="btn btn-outline-primary">Xem Sổ Chi Tiết Công Nợ</a>
                        <button type="button" class="btn btn-success fw-bold" @onclick="ApproveAndSendReminder">
                            <i class="bi bi-send-check me-1"></i> ✔ Kế toán duyệt & Gửi Email/Zalo nhắc nợ
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

</div><!-- /app-page-container -->

@code {
    private bool isSales = false;
    private CustomerInputModel customerModel = new();
    private IEnumerable<Customer>? customers;
    private Dictionary<int, CreditRiskAssessmentDto>? assessments;
    private CreditRiskAssessmentDto? selectedRiskAssessment;
    private CustomerAgingReportDto? selectedAgingReport;
    private string selectedTone = "friendly";
    private string customReminderDraft = "";
    private string? emailSentMessage = null;
    private string successMessage = "";

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        isSales = authState.User.IsInRole("Sales");
        await LoadCustomers();
    }

    private async Task LoadCustomers()
    {
        customers = await ViewCustomerListUseCase.ExecuteAsync();
        var allAssessments = await AssessCreditRiskUseCase.ExecuteAllAsync();
        assessments = allAssessments.ToDictionary(a => a.CustomerId);
    }

    private async Task HandleSaveCustomer()
    {
        successMessage = "";
        
        var customer = new Customer
        {
            Id = customerModel.Id,
            CustomerCode = customerModel.CustomerCode,
            FullName = customerModel.FullName,
            PhoneNumber = customerModel.PhoneNumber,
            Address = customerModel.Address,
            CreditLimit = customerModel.CreditLimit,
            PaymentTermsDays = customerModel.PaymentTermsDays
        };

        if (customer.Id == 0)
        {
            await ManageCustomerUseCase.AddCustomerAsync(customer);
            successMessage = "Thêm khách hàng thành công!";
        }
        else
        {
            await ManageCustomerUseCase.UpdateCustomerAsync(customer);
            successMessage = "Cập nhật thông tin khách hàng thành công!";
        }

        ResetForm();
        await LoadCustomers();
    }

    private void EditCustomer(Customer customer)
    {
        customerModel = new CustomerInputModel
        {
            Id = customer.Id,
            CustomerCode = customer.CustomerCode,
            FullName = customer.FullName,
            PhoneNumber = customer.PhoneNumber,
            Address = customer.Address,
            CreditLimit = customer.CreditLimit,
            PaymentTermsDays = customer.PaymentTermsDays
        };
        successMessage = "";
    }

    private async Task OpenRiskModal(int customerId)
    {
        selectedRiskAssessment = await AssessCreditRiskUseCase.ExecuteAsync(customerId);
        emailSentMessage = null;
        try
        {
            var reports = await GetCustomerAgingReportUseCase.ExecuteAsync(DateTime.Now);
            selectedAgingReport = reports?.FirstOrDefault(r => r.CustomerId == customerId);
        }
        catch
        {
            selectedAgingReport = null;
        }

        SelectReminderTone("friendly");
    }

    private void SelectReminderTone(string tone)
    {
        selectedTone = tone;
        if (selectedRiskAssessment == null) return;

        var name = selectedRiskAssessment.CustomerName;
        var debt = selectedRiskAssessment.CurrentDebt.ToString("N0");

        if (tone == "friendly")
        {
            customReminderDraft = $"Kính gửi Quý đại lý {name},\n\n" +
                $"Phòng Kế toán HUEGO B2B xin gửi lời chào trân trọng và cảm ơn sự đồng hành của Quý khách trong thời gian qua.\n\n" +
                $"Hệ thống xin gửi thông tin đối soát công nợ định kỳ. Hiện tại Quý khách có khoản nợ đến hạn thanh toán là {debt} đ.\n" +
                $"Kính mong Quý đại lý kiểm tra, sắp xếp đối chiếu và thanh toán để tiếp tục duy trì hạn mức tín dụng xuất hàng tốt nhất.\n\n" +
                $"Thông tin chuyển khoản VietQR Napas 24/7:\n" +
                $"- Ngân hàng: TMCP Á Châu (ACB)\n" +
                $"- Số tài khoản: 35782747\n" +
                $"- Chủ tài khoản: CÔNG TY HUEGO B2B\n" +
                $"- Cú pháp: HUEGO {selectedAgingReport?.CustomerCode ?? "KH"} [Mã HĐ]\n\n" +
                $"Trân trọng cảm ơn sự hợp tác của Quý khách!";
        }
        else if (tone == "firm")
        {
            customReminderDraft = $"Kính gửi Ban Giám Đốc {name},\n\n" +
