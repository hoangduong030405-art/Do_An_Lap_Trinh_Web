@page "/portal/ledger"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@using WebBanHang.UseCases.Customers
@using WebBanHang.UseCases.DTOs
@using WebBanHang.Components.Controls
@using WebBanHang.Services

@attribute [Authorize(Roles = "Customer")]
@inject IGetCustomerPortalInfoUseCase GetCustomerPortalInfoUseCase
@inject IViewCustomerLedgerUseCase ViewCustomerLedgerUseCase
@inject AuthenticationStateProvider AuthStateProvider
@inject LedgerConfirmationStateService ConfirmationState
@inject IJSRuntime JSRuntime

<PageTitle>Sổ Đối Soát Công Nợ Đại Lý</PageTitle>

<div class="portal-container py-3">
    <!-- 1. HEADER & ACTIONS -->
    <div class="d-print-none mb-3">
        <PageHeader Title="Sổ Đối Soát Công Nợ Tự Phục Vụ"
                    Subtitle="Minh bạch toàn bộ dòng tiền mua hàng (Ghi Nợ), nộp tiền (Ghi Có) và số dư nợ lũy kế sau từng giao dịch"
                    Icon="bi-journal-text">
            <Actions>
                <button class="btn btn-outline-primary me-2" @onclick="LoadLedgerAsync">
                    <i class="bi bi-arrow-clockwise me-1"></i> Làm mới
                </button>
                <button class="btn btn-primary me-2" @onclick="PrintLedger">
                    <i class="bi bi-printer me-1"></i> In Biên Bản
                </button>
                @if (ledger != null)
                {
                    <button class="btn btn-success me-2 fw-semibold" @onclick="ConfirmBalance">
                        <i class="bi bi-check2-circle me-1"></i> ✔ Xác nhận Khớp số dư (@ledger.EndingBalance.ToString("N0") đ)
                    </button>
                    <button class="btn btn-outline-warning text-dark fw-semibold" @onclick="() => showDisputeModal = true">
                        <i class="bi bi-exclamation-triangle me-1"></i> ⚠ Báo lệch số liệu
                    </button>
                }
            </Actions>
        </PageHeader>
    </div>

    <!-- 2. CREDIT STATUS BAR -->
    <div class="d-print-none">
        <CreditStatusBar CustomerInfo="@customerInfo" />
    </div>

    @if (loading)
    {
        <div class="text-center py-5 d-print-none">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="mt-2 text-muted">Đang kết xuất sổ cái chi tiết công nợ đại lý...</p>
        </div>
    }
    else if (ledger != null)
    {
        <!-- 3. KHUNG BIÊN BẢN ĐỐI SOÁT CÔNG NỢ (HỖ TRỢ IN ẤN CHUẨN DOANH NGHIỆP) -->
        <div class="card border shadow-sm rounded-3 bg-white p-4 mb-4 printable-area" id="printableInvoiceArea" style="background-color: #ffffff !important; color: #0f172a !important;">
            <!-- HEADER TIÊU CHUẨN IN ẤN -->
            <div class="text-center mb-4 pb-3 border-bottom">
                <div class="fw-bold small text-uppercase">CỘNG HÒA XÃ HỘI CHỦ NGHĨA VIỆT NAM</div>
                <div class="small fst-italic">Độc lập - Tự do - Hạnh phúc</div>
                <div class="my-2">——————— ★ ———————</div>
                <h4 class="fw-bold text-slate-navy mt-3 mb-1 text-uppercase">
                    BIÊN BẢN ĐỐI SOÁT CÔNG NỢ THƯƠNG MẠI
                </h4>
                <div class="text-muted">
                    Thời điểm kết xuất: <strong>@DateTime.Now.ToString("HH:mm - dd/MM/yyyy")</strong> • Đơn vị tính: <strong>VNĐ</strong>
                </div>
            </div>

            <!-- THÔNG TIN HAI BÊN KÝ KẾT ĐỐI SOÁT -->
            <div class="row g-3 mb-4">
                <div class="col-6">
                    <div class="p-3 bg-light rounded-3 h-100 border">
                        <div class="fw-bold text-primary mb-2 text-uppercase small">
                            <i class="bi bi-building me-1"></i>BÊN BÁN (BÊN A): CÔNG TY ECO2415
                        </div>
                        <div class="text-muted mb-1"><strong>Tên doanh nghiệp:</strong> CÔNG TY CP CÔNG NGHỆ & THƯƠNG MẠI ECO2415</div>
                        <div class="text-muted mb-1"><strong>Địa chỉ:</strong> 123 Đường Công Nghệ, Quận Tân Bình, TP. Hồ Chí Minh</div>
                        <div class="text-muted mb-1"><strong>Mã số thuế:</strong> 0312345678</div>
                        <div class="text-muted"><strong>Hotline bán buôn:</strong> 1900 6868 | <strong>Email:</strong> ketoan.ar@eco2415.vn</div>
                    </div>
                </div>

                <div class="col-6">
                    <div class="p-3 bg-light rounded-3 h-100 border">
                        <div class="fw-bold text-success mb-2 text-uppercase small">
                            <i class="bi bi-shop me-1"></i>BÊN MUA (BÊN B): ĐẠI LÝ ĐỐI TÁC
                        </div>
                        <div class="text-muted mb-1"><strong>Tên đại lý:</strong> <span class="fw-bold text-dark">@ledger.CustomerName</span></div>
                        <div class="text-muted mb-1"><strong>Mã khách hàng:</strong> <span class="font-monospace fw-bold text-primary">@ledger.CustomerCode</span></div>
                        <div class="text-muted mb-1"><strong>Điện thoại:</strong> @ledger.CustomerPhone</div>
                        <div class="text-muted"><strong>Địa chỉ giao dịch:</strong> @ledger.CustomerAddress</div>
                    </div>
                </div>
            </div>

            <!-- TỔNG HỢP CÔNG NỢ -->
            <div class="row g-3 mb-4">
                <div class="col-12 col-md-3">
                    <div class="p-3 bg-white border rounded-3 text-center shadow-xs" style="border-color: #e5eaf1 !important; background-color: #ffffff !important;">
                        <span class="text-secondary d-block text-uppercase fw-semibold" style="font-size: 16px;">Hạn Mức Tín Dụng</span>
                        <div class="fs-5 fw-bold text-dark mt-1" style="font-variant-numeric: tabular-nums; font-size: 18px;">@ledger.CreditLimit.ToString("N0") đ</div>
                    </div>
                </div>
                <div class="col-12 col-md-3">
                    <div class="p-3 bg-white border rounded-3 text-center shadow-xs" style="border-color: #e5eaf1 !important; background-color: #ffffff !important;">
                        <span class="text-secondary d-block text-uppercase fw-semibold" style="font-size: 16px;">Tổng Mua Hàng (Nợ +)</span>
                        <div class="fs-5 fw-bold text-primary mt-1" style="font-variant-numeric: tabular-nums; font-size: 18px;">+@ledger.TotalDebit.ToString("N0") đ</div>
                    </div>
                </div>
                <div class="col-12 col-md-3">
                    <div class="p-3 bg-white border rounded-3 text-center shadow-xs" style="border-color: #e5eaf1 !important; background-color: #ffffff !important;">
                        <span class="text-secondary d-block text-uppercase fw-semibold" style="font-size: 16px;">Tổng Đã Trả (Có -)</span>
                        <div class="fs-5 fw-bold text-success mt-1" style="font-variant-numeric: tabular-nums; font-size: 18px;">-@ledger.TotalCredit.ToString("N0") đ</div>
                    </div>
                </div>
                <div class="col-12 col-md-3">
                    <div class="p-3 border rounded-3 text-center shadow-xs @(ledger.EndingBalance > 0 ? "bg-danger-subtle border-danger" : "bg-success-subtle border-success")">
                        <span class="fw-bold d-block text-uppercase @(ledger.EndingBalance > 0 ? "text-danger" : "text-success")" style="font-size: 16px;">DƯ NỢ CUỐI KỲ</span>
                        <div class="fs-5 fw-bold @(ledger.EndingBalance > 0 ? "text-danger" : "text-success") mt-1" style="font-variant-numeric: tabular-nums; font-size: 19px;">@ledger.EndingBalance.ToString("N0") đ</div>
                    </div>
                </div>
            </div>

            <!-- BẢNG KÊ CHI TIẾT SỔ CÁI GIAO DỊCH -->
            <h5 class="fw-bold text-dark mb-3" style="font-size: 18px;">
                <i class="bi bi-list-check text-primary me-2"></i>Bảng Kê Chi Tiết Các Giao Dịch Phát Sinh
            </h5>
            <div class="table-responsive border mb-4 bg-white shadow-xs" style="border-radius: 14px; border-color: #e5eaf1 !important; background-color: #ffffff !important;">
                <table class="table table-bordered table-hover align-middle mb-0 bg-white" style="background-color: #ffffff !important; --bs-table-bg: #ffffff !important;">
                    <thead class="text-center" style="background-color: #f1f5f9 !important;">
                        <tr style="background-color: #f1f5f9 !important;">
                            <th style="width: 50px; font-size: 14.5px; font-weight: 700; color: #334155; background-color: #f1f5f9 !important;">STT</th>
                            <th style="width: 120px; font-size: 14.5px; font-weight: 700; color: #334155; background-color: #f1f5f9 !important;">Ngày Chứng Từ</th>
                            <th style="width: 120px; font-size: 14.5px; font-weight: 700; color: #334155; background-color: #f1f5f9 !important;">Loại Chứng Từ</th>
                            <th style="width: 140px; font-size: 14.5px; font-weight: 700; color: #334155; background-color: #f1f5f9 !important;">Số Chứng Từ</th>
                            <th style="font-size: 14.5px; font-weight: 700; color: #334155; background-color: #f1f5f9 !important;">Diễn Giải Giao Dịch</th>
                            <th style="width: 150px; font-size: 14.5px; font-weight: 700; color: #334155; background-color: #f1f5f9 !important;" class="text-end">Phát Sinh Nợ (+)</th>
                            <th style="width: 150px; font-size: 14.5px; font-weight: 700; color: #334155; background-color: #f1f5f9 !important;" class="text-end">Phát Sinh Có (-)</th>
                            <th style="width: 160px; font-size: 14.5px; font-weight: 700; color: #334155; background-color: #f1f5f9 !important;" class="text-end">Số Dư Lũy Kế</th>
                        </tr>
                    </thead>
                    <tbody style="background-color: #ffffff !important; color: #0f172a !important;">
                        @if (!ledger.Entries.Any())
                        {
                            <tr style="background-color: #ffffff !important;">
                                <td colspan="8" class="text-center py-5 text-muted" style="background-color: #ffffff !important; font-size: 15px;">
                                    Không có giao dịch nợ/có nào phát sinh trong kỳ.
                                </td>
                            </tr>
                        }
                        else
                        {
                            int stt = 1;
                            foreach (var item in ledger.Entries)
                            {
                                <tr style="background-color: #ffffff !important;">
                                    <td class="text-center" style="font-size: 16px; color: #475569; background-color: #ffffff !important;">@(stt++)</td>
                                    <td class="text-center" style="font-size: 16px; color: #0f172a; background-color: #ffffff !important;">@item.TransactionDate.ToString("dd/MM/yyyy")</td>
                                    <td class="text-center" style="background-color: #ffffff !important;">
                                        @if (item.DocumentType == "Hóa Đơn")
                                        {
                                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2.5 py-1" style="font-size: 14px; font-weight: 600;">Hóa Đơn</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle px-2.5 py-1" style="font-size: 14px; font-weight: 600;">Phiếu Thu</span>
                                        }
                                    </td>
                                    <td class="font-monospace fw-bold text-center text-dark" style="font-size: 16px; background-color: #ffffff !important;">@item.DocumentNumber</td>
                                    <td style="font-size: 16px; color: #0f172a; background-color: #ffffff !important;">@item.Description</td>
                                    <td class="text-end fw-semibold text-primary" style="font-size: 16px; font-variant-numeric: tabular-nums; background-color: #ffffff !important;">
                                        @(item.Debit > 0 ? item.Debit.ToString("N0") + " đ" : "-")
                                    </td>
                                    <td class="text-end fw-semibold text-success" style="font-size: 16px; font-variant-numeric: tabular-nums; background-color: #ffffff !important;">
                                        @(item.Credit > 0 ? item.Credit.ToString("N0") + " đ" : "-")
                                    </td>
                                    <td class="text-end fw-bold @(item.RunningBalance > 0 ? "text-danger" : "text-dark")" style="font-size: 16px; font-variant-numeric: tabular-nums; background-color: #ffffff !important;">
                                        @item.RunningBalance.ToString("N0") đ
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                    <tfoot style="background-color: #f8fafc !important; font-weight: 700;">
                        <tr style="background-color: #f8fafc !important;">
                            <td colspan="5" class="text-end text-dark" style="font-size: 16px; font-weight: 700; background-color: #f8fafc !important;">TỔNG CỘNG PHÁT SINH TRONG KỲ:</td>
                            <td class="text-end text-primary" style="font-size: 16px; font-weight: 700; font-variant-numeric: tabular-nums; background-color: #f8fafc !important;">@ledger.TotalDebit.ToString("N0") đ</td>
                            <td class="text-end text-success" style="font-size: 16px; font-weight: 700; font-variant-numeric: tabular-nums; background-color: #f8fafc !important;">@ledger.TotalCredit.ToString("N0") đ</td>
                            <td class="text-end text-danger" style="font-size: 17px; font-weight: 700; font-variant-numeric: tabular-nums; background-color: #f8fafc !important;">@ledger.EndingBalance.ToString("N0") đ</td>
                        </tr>
                    </tfoot>
                </table>
            </div>

            <!-- CAM KẾT & CHỮ KÝ XÁC NHẬN HAI BÊN -->
            <div class="mb-4 text-muted">
                <strong>Cam kết xác nhận:</strong> Hai bên cùng đối soát và thống nhất xác nhận toàn bộ số liệu công nợ tính đến ngày hôm nay là hoàn toàn chính xác. Bên B cam kết thực hiện nghĩa vụ thanh toán đối với số dư nợ đến hạn theo đúng các điều khoản trong Hợp đồng mua bán phân phối sỉ đã ký kết.
            </div>

            <div class="row text-center mt-5 pt-3">
                <div class="col-6">
                    <div class="fw-bold small text-uppercase">ĐẠI DIỆN BÊN MUA (BÊN B)</div>
                    <div class="text-muted fst-italic">(Ký, ghi rõ họ tên, đóng dấu nếu có)</div>
                    <div style="min-height: 80px;" class="d-flex align-items-center justify-content-center py-2">
                        @if (isConfirmed || confirmedInfo != null)
                        {
                            var conf = confirmedInfo ?? new CustomerLedgerConfirmation { ConfirmedAt = DateTime.Now, EndingBalance = ledger.EndingBalance };
                            <div class="border border-2 border-danger rounded-3 p-2 text-danger text-center shadow-xs" 
                                 style="border-style: double !important; transform: rotate(-3deg); background: rgba(239, 68, 68, 0.05); min-width: 220px;">
                                <div class="fw-bold text-uppercase" style="font-size: 13.5px; letter-spacing: 0.5px;">
                                    <i class="bi bi-patch-check-fill me-1"></i> ĐẠI LÝ ĐÃ XÁC NHẬN SỐ DƯ
                                </div>
                                <div class="small fw-semibold mt-0.5" style="font-size: 11.5px;">
                                    Khớp số dư: @ledger.EndingBalance.ToString("N0") đ
                                </div>
                                <div class="small text-muted" style="font-size: 11px;">
                                    Thời điểm: @conf.ConfirmedAt.ToString("HH:mm - dd/MM/yyyy")
                                </div>
                            </div>
                        }
                    </div>
                    <div class="fw-bold text-dark">@ledger.CustomerName</div>
                </div>
                <div class="col-6">
                    <div class="fw-bold small text-uppercase">ĐẠI DIỆN BÊN BÁN (BÊN A)</div>
                    <div class="text-muted fst-italic">(Kế toán trưởng / Giám đốc ký tên)</div>
                    <div style="height: 80px;"></div>
                    <div class="fw-bold text-primary">Kế Toán Phụ Trách Công Nợ AR</div>
                </div>
            </div>
        </div>
    }
</div>

<!-- MODAL BÁO LỆCH SỐ LIỆU -->
@if (showDisputeModal && ledger != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.6);" role="dialog">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="modal-header bg-white border-bottom py-3 px-4">
                    <h5 class="modal-title fw-bold text-dark">
                        <i class="bi bi-exclamation-triangle-fill text-warning me-2"></i> Báo Lệch Số Liệu Công Nợ
                    </h5>
                    <button type="button" class="btn-close" @onclick="() => showDisputeModal = false"></button>
                </div>
                <div class="modal-body p-4 bg-white">
                    <p class="text-muted small mb-3">
                        Quý khách vui lòng chọn chứng từ có chênh lệch và nhập chi tiết phản ánh để bộ phận Kế toán công nợ kiểm tra, đối chiếu lại.
                    </p>
                    <div class="mb-3">
                        <label class="form-label fw-bold small text-dark">Hóa đơn / Giao dịch cần thắc mắc <span class="text-danger">*</span></label>
                        <select class="form-select" @bind="disputeInvoiceNumber">
                            <option value="">-- Chọn hóa đơn hoặc chứng từ phát sinh --</option>
                            @foreach (var entry in ledger.Entries.Where(e => !string.IsNullOrEmpty(e.DocumentNumber)))
                            {
                                <option value="@entry.DocumentNumber">@entry.DocumentNumber (@entry.TransactionDate.ToString("dd/MM/yyyy")) - @entry.Description</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold small text-dark">Nội dung giải trình / Số tiền sai lệch <span class="text-danger">*</span></label>
                        <textarea class="form-control" rows="3" placeholder="VD: Hóa đơn này đại lý đã chuyển khoản 5.000.000đ ngày 15/10 nhưng chưa thấy cấn trừ..." @bind="disputeNote"></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold small text-dark">Đính kèm ảnh biên lai / sao kê chuyển khoản</label>
                        <input type="file" class="form-control form-control-sm" />
                        <small class="text-muted">Hỗ trợ file JPG, PNG, PDF (tối đa 5MB)</small>
                    </div>
                    @if (!string.IsNullOrEmpty(disputeMessage))
                    {
                        <div class="alert alert-success py-2 px-3 small">
                            <i class="bi bi-check-circle-fill me-1"></i> @disputeMessage
                        </div>
                    }
                </div>
                <div class="modal-footer bg-light py-2 px-4 justify-content-between">
                    <button type="button" class="btn btn-outline-secondary rounded-pill btn-sm px-3" @onclick="() => showDisputeModal = false">
                        Đóng
                    </button>
                    <button type="button" class="btn btn-warning rounded-pill btn-sm px-4 fw-bold" @onclick="SubmitDispute">
                        <i class="bi bi-send me-1"></i> Gửi Phản Ánh Tới Kế Toán
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private bool loading = true;
    private CustomerPortalInfoDto? customerInfo;
    private CustomerLedgerDto? ledger;
    private int customerId = 1;
    private bool isConfirmed = false;
    private CustomerLedgerConfirmation? confirmedInfo;
    private bool showDisputeModal = false;
    private string disputeInvoiceNumber = "";
    private string disputeNote = "";
    private string? disputeMessage;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        var claim = user.FindFirst("CustomerId")?.Value;
        if (int.TryParse(claim, out var id))
        {
            customerId = id;
        }

        confirmedInfo = ConfirmationState.GetConfirmation(customerId);
        isConfirmed = confirmedInfo != null;

        await LoadLedgerAsync();
    }

    private async Task LoadLedgerAsync()
    {
        loading = true;
        try
        {
            customerInfo = await GetCustomerPortalInfoUseCase.ExecuteAsync(customerId);
            ledger = await ViewCustomerLedgerUseCase.ExecuteAsync(customerId, "Customer", customerId);
            confirmedInfo = ConfirmationState.GetConfirmation(customerId);
            isConfirmed = confirmedInfo != null;
        }
        finally
        {
            loading = false;
        }
    }

    private void ConfirmBalance()
    {
        if (ledger != null)
        {
            ConfirmationState.ConfirmBalance(customerId, ledger.CustomerName, ledger.EndingBalance);
            confirmedInfo = ConfirmationState.GetConfirmation(customerId);
            isConfirmed = true;
        }
    }

    private void SubmitDispute()
    {
        if (string.IsNullOrWhiteSpace(disputeNote) && string.IsNullOrWhiteSpace(disputeInvoiceNumber))
        {
            return;
        }

        ConfirmationState.AddDispute(customerId, ledger?.CustomerName ?? "Đại lý", disputeInvoiceNumber, disputeNote);
        disputeMessage = "Đã gửi phản ánh tới bộ phận Kế toán thành công!";
    }

    private async Task PrintLedger()
    {
        await JSRuntime.InvokeVoidAsync("window.print");
    }
}
