@page "/portal/store"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@using WebBanHang.CoreBusiness.Entities
@using WebBanHang.CoreBusiness.Exceptions
@using WebBanHang.UseCases.Customers
@using WebBanHang.UseCases.Products
@using WebBanHang.UseCases.Invoices
@using WebBanHang.UseCases.DTOs
@using WebBanHang.Components.Controls

@attribute [Authorize(Roles = "Customer")]
@inject IGetCustomerPortalInfoUseCase GetCustomerPortalInfoUseCase
@inject IViewProductCatalogUseCase ViewProductCatalogUseCase
@inject ICreateCustomerPortalOrderUseCase CreateCustomerPortalOrderUseCase
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation

<PageTitle>Cửa Hàng B2B - Đặt Hàng Sỉ Trực Tuyến & Ghi Nợ Tín Dụng</PageTitle>

<div class="portal-container py-3">
    <div class="app-page-container">
    <PageHeader Title="Cửa Hàng B2B Đặt Hàng Sỉ Trực Tuyến"
                Subtitle="Đặt hàng nhanh theo kiện và pallet, tự động ghi nợ tín dụng theo hạn mức được phê duyệt"
                Icon="bi-cart3">
        <Actions>
            <a href="/portal/invoices" class="btn btn-secondary">
                <i class="bi bi-receipt me-1"></i> Hóa Đơn Của Tôi
            </a>
        </Actions>
    </PageHeader>

    <!-- 2. CREDIT STATUS BAR -->
    <CreditStatusBar CustomerInfo="@customerInfo" />

    @if (loading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="mt-2 text-muted">Đang nạp danh mục sản phẩm phân phối sỉ...</p>
        </div>
    }
    else
    {
        <div class="row g-4">
            <!-- 3. DANH MỤC SẢN PHẨM PHÂN PHỐI SỈ (COL 8) -->
            <div class="col-12 col-lg-8">
                <!-- Search & Filters -->
                <div class="card border shadow-sm p-3 mb-3 bg-white" style="border-radius: 14px; border-color: #e5eaf1 !important;">
                    <div class="row g-2 align-items-center">
                        <div class="col-md-7">
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0 text-muted">
                                    <i class="bi bi-search"></i>
                                </span>
                                <input type="text"
                                       class="form-control bg-light border-start-0"
                                       placeholder="Tìm kiếm mã hàng, tên sản phẩm..."
                                       @bind="searchTerm"
                                       @bind:event="oninput"
                                       @onkeyup="FilterProducts" />
                            </div>
                        </div>
                        <div class="col-md-5 text-md-end text-muted small">
                            Hiển thị <strong>@filteredProducts.Count</strong> sản phẩm phân phối sỉ
                        </div>
                    </div>
                </div>

                <!-- Products Grid -->
                @if (!filteredProducts.Any())
                {
                    <div class="alert alert-warning text-center py-5 rounded-3">
                        <i class="bi bi-box-seam fs-1 d-block mb-2 text-warning"></i>
                        Không tìm thấy sản phẩm nào phù hợp với từ khóa <strong>"@searchTerm"</strong>.
                    </div>
                }
                else
                {
                    <div class="row g-3">
                        @foreach (var prod in filteredProducts)
                        {
                            var qty = GetSelectedQty(prod.Id);
                            var isOutOfStock = prod.StockQuantity <= 0;
                            var isLowStock = prod.StockQuantity > 0 && prod.StockQuantity <= 15;

                            <div class="col-12 col-md-6">
                                <div class="card border shadow-sm h-100 b2b-product-card transition-all bg-white p-3 d-flex flex-column justify-content-between" style="border-radius: 16px; border-color: #e5eaf1 !important;">
                                    <div>
                                        <!-- Header card: Mã SP & Badge trạng thái -->
                                        <div class="d-flex justify-content-between align-items-start mb-2">
                                            <span class="badge bg-light text-primary border border-primary-subtle font-monospace fw-bold">
                                                @prod.ProductCode
                                            </span>
                                            @if (isOutOfStock)
                                            {
                                                <span class="badge bg-danger-subtle text-danger border border-danger-subtle">Hết hàng</span>
                                            }
                                            else if (isLowStock)
                                            {
                                                <span class="badge bg-warning-subtle text-warning border border-warning-subtle">Sắp hết (@prod.StockQuantity)</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-success-subtle text-success border border-success-subtle">Còn hàng (@prod.StockQuantity)</span>
                                            }
                                        </div>

                                        <!-- HÌNH ẢNH SẢN PHẨM CHUẨN XÁC B2B -->
                                        <div class="product-img-box bg-light rounded-3 p-2 mb-2 text-center position-relative d-flex align-items-center justify-content-center border" style="height: 150px;">
                                            <img src="@(string.IsNullOrEmpty(prod.ImageUrl) ? "/images/products/sp001-coca-cola.svg" : prod.ImageUrl)" 
                                                 alt="@prod.Name" 
                                                 class="img-fluid h-100 object-fit-contain" 
                                                 loading="lazy" />
                                        </div>

                                        <!-- Tên SP -->
                                        <h6 class="fw-bold text-slate-navy mb-1 line-clamp-2" title="@prod.Name">
                                            @prod.Name
                                        </h6>
                                        <p class="text-muted small mb-2">
                                            Quy cách: <strong>@prod.Unit</strong> @(string.IsNullOrWhiteSpace(prod.Description) ? "" : $"• {prod.Description}")
                                        </p>
                                    </div>

                                    <div>
                                        <!-- Giá sỉ -->
                                        <div class="p-2.5 rounded-2 bg-light mb-3 d-flex justify-content-between align-items-center">
                                            <span class="text-muted small">Giá sỉ đại lý:</span>
                                            <span class="fs-5 fw-bold text-primary">@prod.UnitPrice.ToString("N0") <small class="fs-6 fw-normal text-muted">đ/@prod.Unit</small></span>
                                        </div>

                                        <!-- Quantity & Thêm nút -->
                                        @if (isOutOfStock)
                                        {
                                            <button class="btn btn-secondary w-100 rounded-pill btn-sm" disabled>
                                                <i class="bi bi-slash-circle me-1"></i> Tạm hết hàng tại kho
                                            </button>
                                        }
                                        else
                                        {
                                            <div class="d-flex align-items-center gap-2">
                                                <div class="input-group input-group-sm quantity-spinner" style="max-width: 120px;">
                                                    <button class="btn btn-outline-secondary" type="button" @onclick="() => DecrementQty(prod.Id)">-</button>
                                                    <input type="number"
                                                           class="form-control text-center fw-bold"
                                                           value="@qty"
                                                           min="1"
                                                           max="@prod.StockQuantity"
                                                           @onchange="(e) => OnQtyChanged(prod.Id, e.Value, prod.StockQuantity)" />
                                                    <button class="btn btn-outline-secondary" type="button" @onclick="() => IncrementQty(prod.Id, prod.StockQuantity)">+</button>
                                                </div>
                                                <button class="btn btn-outline-primary btn-sm flex-grow-1 rounded-pill fw-semibold shadow-xs"
                                                        @onclick="() => AddToCart(prod)">
                                                    <i class="bi bi-cart-plus me-1"></i> Thêm vào đơn
                                                </button>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>

            <!-- 4. GIỎ HÀNG SỈ B2B & KIỂM TRA HẠN MỨC (COL 4) -->
            <div class="col-12 col-lg-4">
                <div class="card border shadow-sm sticky-top" style="top: 1rem; border-radius: 16px; border-color: #e5eaf1 !important; background: #ffffff;">
                    <div class="card-header bg-white border-bottom py-3 px-3 text-dark d-flex justify-content-between align-items-center">
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-bag-check-fill text-warning fs-5"></i>
                            <h6 class="fw-bold mb-0 text-dark">Đơn Hàng Sỉ Đang Chọn</h6>
                        </div>
                        <span class="badge bg-primary text-white rounded-pill px-2.5 py-1">@cart.Count dòng hàng</span>
                    </div>

                    <div class="card-body p-3">
                        @if (!cart.Any())
                        {
                            <div class="text-center py-4 text-muted">
                                <i class="bi bi-cart-x fs-1 d-block mb-2 text-slate-light"></i>
                                <div>Chưa có sản phẩm nào trong đơn hàng.</div>
                                <small>Vui lòng chọn số lượng và bấm "Thêm vào đơn".</small>
                            </div>
                        }
                        else
                        {
                            <!-- Danh sách giỏ hàng -->
                            <div class="cart-items-list mb-3" style="max-height: 280px; overflow-y: auto;">
                                @foreach (var item in cart)
                                {
                                    <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                                        <div class="pe-2 overflow-hidden flex-grow-1">
                                            <div class="fw-bold text-dark small text-truncate" title="@item.ProductName">@item.ProductName</div>
                                            <small class="text-muted">
                                                @item.Quantity @item.Unit × @item.UnitPrice.ToString("N0") đ
                                            </small>
                                        </div>
                                        <div class="text-end ps-2 d-flex align-items-center gap-2">
                                            <div class="fw-bold text-primary small">
                                                @((item.Quantity * item.UnitPrice).ToString("N0")) đ
                                            </div>
                                            <button class="btn btn-outline-danger btn-sm p-0 rounded-circle d-flex align-items-center justify-content-center"
                                                    style="width: 24px; height: 24px;"
                                                    @onclick="() => RemoveFromCart(item.ProductId)"
                                                    title="Xóa mặt hàng">
                                                <i class="bi bi-x"></i>
                                            </button>
                                        </div>
                                    </div>
                                }
                            </div>

                            <!-- Tổng tiền hàng -->
                            <div class="p-3 bg-light rounded-3 mb-3">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <span class="text-muted small">Tổng số lượng:</span>
                                    <span class="fw-bold">@cart.Sum(x => x.Quantity) mặt hàng</span>
                                </div>
                                <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                                    <span class="fw-bold text-dark">Tổng Tiền Đơn Hàng:</span>
                                    <span class="fs-5 fw-bold text-primary">@cartTotal.ToString("N0") đ</span>
                                </div>
                            </div>

                            <!-- KIỂM TRA HẠN MỨC REAL-TIME (REAL-TIME CREDIT LIMIT CHECK) -->
                            @if (isExceeded)
                            {
                                <div class="alert alert-danger p-3 rounded-3 mb-3 border-danger shadow-xs">
                                    <div class="d-flex gap-2">
                                        <i class="bi bi-exclamation-octagon-fill fs-4 text-danger flex-shrink-0"></i>
                                        <div class="small">
                                            <div class="fw-bold text-danger mb-1">VƯỢT HẠN MỨC TÍN DỤNG!</div>
                                            <div>Đơn hàng vượt hạn mức nợ còn lại (vượt <strong>@exceededAmount.ToString("N0") đ</strong>).</div>
                                            <div class="mt-1 text-muted">
                                                Hạn mức khả dụng hiện tại: <strong>@availableCredit.ToString("N0") đ</strong>. Vui lòng thanh toán bớt nợ cũ hoặc giảm bớt số lượng hàng.
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="alert alert-success p-3 rounded-3 mb-3 border-success shadow-xs">
                                    <div class="d-flex gap-2">
                                        <i class="bi bi-check-circle-fill fs-5 text-success flex-shrink-0"></i>
                                        <div class="small">
                                            <div class="fw-bold text-success mb-1">ĐỦ ĐIỀU KIỆN GHI NỢ TÍN DỤNG</div>
                                            <div>Hạn mức khả dụng sau đơn này: <strong>@remainingCreditAfterOrder.ToString("N0") đ</strong>.</div>
                                            <div class="text-muted">Thời hạn thanh toán: <strong>@(customerInfo?.PaymentTermsDays ?? 30) ngày</strong>.</div>
                                        </div>
                                    </div>
                                </div>
                            }

                            <!-- Nút Xác Nhận Đặt Hàng & Ghi Nợ -->
                            <button class="btn btn-primary w-100 py-2.5 rounded-pill fw-bold shadow-sm d-flex align-items-center justify-content-center gap-2"
                                    disabled="@(isExceeded || submitting)"
                                    @onclick="SubmitOrderAsync">
                                @if (submitting)
                                {
                                    <span class="spinner-border spinner-border-sm" role="status"></span>
                                    <span>Đang ghi nhận đơn hàng & trừ kho...</span>
                                }
                                else
                                {
                                    <i class="bi bi-shield-lock-fill"></i>
                                    <span>Xác Nhận Đặt Hàng & Ghi Nợ</span>
                                }
                            </button>
                            <small class="text-center d-block text-muted mt-2">
                                <i class="bi bi-info-circle me-1"></i>Hóa đơn sẽ được lập tự động với trạng thái Chưa Thanh Toán.
                            </small>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<!-- MODAL THÔNG BÁO ĐẶT HÀNG THÀNH CÔNG -->
@if (orderSuccessResult != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.6);" role="dialog">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="modal-header bg-white border-bottom py-3 px-4">
                    <h5 class="modal-title fw-bold text-dark">
                        <i class="bi bi-check-circle-fill me-2"></i>ĐẶT HÀNG B2B THÀNH CÔNG!
                    </h5>
                    <button type="button" class="btn-close" @onclick="CloseSuccessModal"></button>
                </div>
                <div class="modal-body p-4 text-center">
                    <div class="display-4 text-success mb-2">
                        <i class="bi bi-box2-heart"></i>
                    </div>
                    <h5 class="fw-bold text-slate-navy mb-1">Đơn Hàng Ghi Nợ Đã Được Xác Nhận</h5>
                    <p class="text-muted small mb-3">
                        Kho phân phối đang chuẩn bị hàng đóng gói và xuất giao cho Quý đại lý.
                    </p>

                    <div class="bg-light p-3 rounded-3 text-start small mb-3 border">
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Mã Hóa Đơn:</span>
                            <strong class="text-primary font-monospace fs-6">@orderSuccessResult.InvoiceNumber</strong>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Tổng Tiền Ghi Nợ:</span>
                            <strong class="text-danger fs-6">@orderSuccessResult.TotalAmount.ToString("N0") đ</strong>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Hạn Mức Khả Dụng Còn Lại:</span>
                            <strong class="text-success fs-6">@orderSuccessResult.RemainingAvailableCredit.ToString("N0") đ</strong>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span class="text-muted">Thời Hạn Thanh Toán:</span>
                            <strong>@(customerInfo?.PaymentTermsDays ?? 30) ngày kể từ hôm nay</strong>
                        </div>
                    </div>

                    <div class="alert alert-info py-2 px-3 small text-start border-info-subtle">
                        <i class="bi bi-qr-code me-1"></i> Quý đại lý có thể quét mã VietQR bất cứ lúc nào trong mục <strong>Hóa Đơn Của Tôi</strong> để cấn trừ nợ tức thì.
                    </div>
                </div>
                <div class="modal-footer bg-light py-2 px-4 justify-content-between">
                    <button type="button" class="btn btn-outline-secondary rounded-pill btn-sm px-3" @onclick="CloseSuccessModal">
                        Tiếp tục đặt hàng
                    </button>
                    <a href="/portal/invoices" class="btn btn-primary rounded-pill btn-sm px-4 fw-bold">
                        <i class="bi bi-receipt me-1"></i> Xem hóa đơn & VietQR
                    </a>
                </div>
            </div>
        </div>
    </div>
}

</div><!-- /app-page-container -->

@code {
    private bool loading = true;
    private bool submitting = false;
    private CustomerPortalInfoDto? customerInfo;
    private List<Product> allProducts = new();
    private List<Product> filteredProducts = new();
    private string searchTerm = "";
    private int customerId = 1;

    // Cart representation
    private class CartItem
    {
        public int ProductId { get; set; }
        public string ProductCode { get; set; } = "";
        public string ProductName { get; set; } = "";
        public string Unit { get; set; } = "";
        public decimal UnitPrice { get; set; }
        public int Quantity { get; set; }
    }

    private List<CartItem> cart = new();
    private Dictionary<int, int> selectedQtys = new();
    private CustomerPortalOrderResultDto? orderSuccessResult;

    private decimal cartTotal => cart.Sum(x => x.Quantity * x.UnitPrice);
    private decimal availableCredit => customerInfo?.AvailableCredit ?? 0;
    private bool isExceeded => cartTotal > availableCredit;
    private decimal exceededAmount => Math.Max(0, cartTotal - availableCredit);
    private decimal remainingCreditAfterOrder => Math.Max(0, availableCredit - cartTotal);

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        var claim = user.FindFirst("CustomerId")?.Value;
        if (int.TryParse(claim, out var id))
        {
            customerId = id;
        }

        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        loading = true;
        try
        {
            customerInfo = await GetCustomerPortalInfoUseCase.ExecuteAsync(customerId);
            var prods = await ViewProductCatalogUseCase.ExecuteAsync();
            allProducts = prods.ToList();
            filteredProducts = allProducts;

            foreach (var p in allProducts)
            {
                if (!selectedQtys.ContainsKey(p.Id))
                {
                    selectedQtys[p.Id] = 1;
                }
            }
        }
        finally
        {
            loading = false;
        }
    }

    private void FilterProducts()
    {
        if (string.IsNullOrWhiteSpace(searchTerm))
        {
            filteredProducts = allProducts;
        }
        else
        {
            var term = searchTerm.Trim().ToLower();
            filteredProducts = allProducts.Where(p =>
                p.Name.ToLower().Contains(term) ||
                p.ProductCode.ToLower().Contains(term) ||
                p.Unit.ToLower().Contains(term)
            ).ToList();
        }
    }

    private int GetSelectedQty(int productId)
    {
        return selectedQtys.TryGetValue(productId, out var q) ? q : 1;
    }

    private void DecrementQty(int productId)
    {
        var current = GetSelectedQty(productId);
        if (current > 1)
        {
            selectedQtys[productId] = current - 1;
        }
    }

    private void IncrementQty(int productId, int maxStock)
    {
        var current = GetSelectedQty(productId);
        if (current < maxStock)
        {
            selectedQtys[productId] = current + 1;
        }
    }

    private void OnQtyChanged(int productId, object? value, int maxStock)
    {
        if (int.TryParse(value?.ToString(), out var val))
        {
            if (val < 1) val = 1;
            if (val > maxStock) val = maxStock;
            selectedQtys[productId] = val;
        }
    }

    private void AddToCart(Product product)
    {
        var qty = GetSelectedQty(productId: product.Id);
        var existing = cart.FirstOrDefault(x => x.ProductId == product.Id);
        if (existing != null)
        {
            var newQty = existing.Quantity + qty;
            if (newQty > product.StockQuantity)
            {
                newQty = product.StockQuantity;
            }
            existing.Quantity = newQty;
        }
        else
        {
            cart.Add(new CartItem
            {
                ProductId = product.Id,
                ProductCode = product.ProductCode,
                ProductName = product.Name,
                Unit = product.Unit,
                UnitPrice = product.UnitPrice,
                Quantity = qty
            });
        }
    }

    private void RemoveFromCart(int productId)
    {
        cart.RemoveAll(x => x.ProductId == productId);
    }

    private async Task SubmitOrderAsync()
    {
        if (!cart.Any() || isExceeded || submitting) return;

        submitting = true;
        try
        {
            var lines = cart.Select(c => new InvoiceLine
            {
                ProductId = c.ProductId,
                Quantity = c.Quantity,
                UnitPrice = c.UnitPrice
            }).ToList();

            var result = await CreateCustomerPortalOrderUseCase.ExecuteAsync(customerId, lines);
            if (result.Success)
            {
                orderSuccessResult = result;
                cart.Clear();
                // Tải lại thông tin hạn mức và kho hàng
                await LoadDataAsync();
            }
        }
        catch (BusinessRuleException)
        {
            await LoadDataAsync();
        }
        finally
        {
            submitting = false;
        }
    }

    private void CloseSuccessModal()
    {
        orderSuccessResult = null;
    }
}
