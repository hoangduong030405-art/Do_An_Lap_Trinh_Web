@page "/access-denied"
@using Microsoft.AspNetCore.Components.Authorization
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation

<PageTitle>Từ Chối Truy Cập - Phân Hệ Kế Toán</PageTitle>

<div class="d-flex align-items-center justify-content-center py-5 my-4">
    <div class="card border-0 shadow-sm p-4 text-center bg-white rounded-3" style="max-width: 520px;">
        <div class="mb-3">
            <div class="d-inline-flex align-items-center justify-content-center bg-danger-subtle text-danger rounded-circle p-3" style="width: 64px; height: 64px;">
                <i class="bi bi-shield-lock-fill fs-2"></i>
            </div>
        </div>

        <h5 class="fw-bold text-slate-navy mb-2">Chưa Được Phân Quyền Truy Cập</h5>
        <p class="text-muted small mb-4" style="line-height: 1.5;">
            Tài khoản hiện tại của bạn không có quyền hạn truy cập vào chức năng hoặc phân hệ này. 
            Vui lòng liên hệ Kế toán trưởng hoặc quản trị viên hệ thống để được cấp quyền.
        </p>

        <div class="d-flex justify-content-center gap-2">
            <a href="/dashboard" class="btn btn-brand btn-sm px-3">
                <i class="bi bi-arrow-left me-1"></i> Về Bàn Làm Việc
            </a>
            <a href="/login" class="btn btn-outline-secondary btn-sm px-3">
                <i class="bi bi-person-badge me-1"></i> Đổi Tài Khoản Khác
            </a>
        </div>
    </div>
</div>
