@page "/payments"
@attribute [Authorize(Roles = "Accountant")]
@rendermode InteractiveServer

@using WebBanHang.UseCases.Payments
@using WebBanHang.UseCases.Customers
@using WebBanHang.UseCases.Invoices
@using WebBanHang.CoreBusiness.Entities
@using WebBanHang.Components.Controls

@inject IViewCustomerListUseCase ViewCustomerListUseCase
@inject IGetCustomerDebtUseCase GetCustomerDebtUseCase
@inject IGetUnpaidInvoicesUseCase GetUnpaidInvoicesUseCase
@inject IRecordPaymentAndAllocateUseCase RecordPaymentUseCase

<div class="app-page-container">
    <PageHeader Title="Thu Tiền & Phân Bổ Nợ (FIFO)"
                Subtitle="Hệ thống tự động cấn trừ công nợ theo thứ tự hóa đơn phát sinh cũ nhất trước, mới nhất sau"
                Icon="bi-cash-coin">
        <Actions>
            <a href="/payment-history" class="btn btn-secondary d-flex align-items-center gap-1.5">
                <i class="bi bi-clock-history"></i>
                <span>Xem Lịch Sử Phiếu Thu</span>
            </a>
        </Actions>
    </PageHeader>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-xs border-danger mb-4" role="alert">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-exclamation-octagon-fill fs-5 flex-shrink-0"></i>
                <div class="fw-semibold">@errorMessage</div>
            </div>
            <button type="button" class="btn-close" @onclick="() => errorMessage = string.Empty"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="alert alert-success alert-dismissible fade show shadow-xs border-success mb-4" role="alert">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-check-circle-fill fs-5 flex-shrink-0"></i>
                <div class="fw-semibold">@successMessage</div>
            </div>
            <button type="button" class="btn-close" @onclick="() => successMessage = string.Empty"></button>
        </div>
    }

    <div class="row g-4">
        <!-- CỘT 1: FORM GHI NHẬN PHIẾU THU TIỀN -->
        <div class="col-12 col-lg-5">
            <div class="card shadow-sm border h-100" style="border-radius: 16px; border-color: #e5eaf1 !important; background: #ffffff;">
                <div class="card-header bg-white border-bottom py-3 px-4 d-flex align-items-center justify-content-between" style="border-color: #e5eaf1 !important;">
                    <h5 class="card-title mb-0 fw-bold text-dark fs-6 d-flex align-items-center gap-2">
                        <i class="bi bi-cash-stack text-primary"></i> Thông Tin Phiếu Thu Tiền
                    </h5>
                    @if (selectedCustomer != null && currentDebt > 0)
                    {
                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2.5 py-1" style="font-size: 14.5px; font-weight: 600;">
                            Đang nợ: @currentDebt.ToString("N0") đ
                        </span>
                    }
                </div>
                <div class="card-body p-4">
                    <!-- 1. CHỌN KHÁCH HÀNG -->
                    <div class="mb-3.5">
                        <label class="form-label fw-bold text-dark mb-1" style="font-size: 16px;">
                            1. Chọn Khách Hàng Nộp Tiền <span class="text-danger">*</span>
                        </label>
                        <select class="form-select" @onchange="OnCustomerSelected" style="min-height: 48px; font-size: 16px;">
                            <option value="0">-- Bấm để chọn đại lý nộp tiền --</option>
                            @if (customers != null)
                            {
                                @foreach (var c in customers)
                                {
                                    <option value="@c.Id" selected="@(c.Id == selectedCustomerId)">
                                        @c.FullName (@c.CustomerCode) - ĐT: @c.PhoneNumber
                                    </option>
                                }
                            }
                        </select>
                    </div>

                    <!-- THẺ THÔNG TIN TÍN DỤNG CỦA KHÁCH -->
                    @if (selectedCustomer != null)
                    {
                        <div class="p-3.5 rounded-3 border mb-3.5" style="background: #ffffff; border-color: #cbd5e1 !important; box-shadow: 0 2px 6px rgba(0,0,0,0.04);">
                            <div class="row g-2.5 text-center">
                                <div class="col-4">
                                    <div class="p-2.5 rounded-3 border" style="background: linear-gradient(180deg, #eff6ff 0%, #ffffff 70%); border-color: #bfdbfe !important; border-top: 4px solid #2563eb !important;">
                                        <div style="color: #1e40af; font-size: 15px; font-weight: 700;">Hạn Mức Cấp</div>
                                        <div class="fw-bold" style="color: #1d4ed8; font-size: 18px; font-variant-numeric: tabular-nums;">
                                            @selectedCustomer.CreditLimit.ToString("N0") đ
                                        </div>
                                    </div>
                                </div>
                                <div class="col-4">
                                    <div class="p-2.5 rounded-3 border" style="background: linear-gradient(180deg, #f8fafc 0%, #ffffff 70%); border-color: #cbd5e1 !important; border-top: 4px solid #64748b !important;">
                                        <div style="color: #475569; font-size: 15px; font-weight: 700;">Hạn Nợ Chuẩn</div>
                                        <div class="fw-bold text-dark" style="font-size: 18px;">
                                            @selectedCustomer.PaymentTermsDays ngày
                                        </div>
                                    </div>
                                </div>
                                <div class="col-4">
                                    <div class="p-2.5 rounded-3 border" style="background: @(currentDebt > 0 ? "linear-gradient(180deg, #fef2f2 0%, #ffffff 70%)" : "linear-gradient(180deg, #ecfdf5 0%, #ffffff 70%)"); border-color: @(currentDebt > 0 ? "#fecaca" : "#a7f3d0") !important; border-top: 4px solid @(currentDebt > 0 ? "#dc2626" : "#059669") !important;">
                                        <div style="color: @(currentDebt > 0 ? "#991b1b" : "#065f46"); font-size: 15px; font-weight: 700;">Tổng Nợ Còn Lại</div>
                                        <div class="fw-bold" style="color: @(currentDebt > 0 ? "#dc2626" : "#047857"); font-size: 18px; font-variant-numeric: tabular-nums;">
                                            @currentDebt.ToString("N0") đ
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }

                    <!-- 2. SỐ TIỀN THU -->
                    <div class="mb-3.5">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <label class="form-label fw-bold text-dark mb-0" style="font-size: 16px;">
                                2. Số Tiền Thu (VNĐ) <span class="text-danger">*</span>
                            </label>
                            @if (currentDebt > 0)
                            {
                                <div class="d-flex gap-2">
                                    <button type="button" class="btn btn-sm btn-outline-primary py-1 px-2.5 fw-bold" style="font-size: 14.5px; border-radius: 8px;" @onclick="FillHalfDebt">
                                        50% Nợ
                                    </button>
                                    <button type="button" class="btn btn-sm py-1 px-2.5 fw-bold text-white shadow-xs" style="font-size: 14.5px; border-radius: 8px; background: linear-gradient(135deg, #059669 0%, #047857 100%); border: none;" @onclick="FillFullDebt">
                                        Tất Toán Nợ
                                    </button>
                                </div>
                            }
                        </div>
                        <div class="input-group">
                            <input type="number" 
                                   class="form-control text-end fw-bold text-primary" 
                                   style="min-height: 52px; font-size: 22px; font-weight: 800; font-variant-numeric: tabular-nums;"
                                   step="1000" 
                                   min="1" 
                                   @bind="paymentAmount" 
                                   @bind:event="oninput"
                                   placeholder="0" />
                            <span class="input-group-text bg-light fw-bold text-muted px-3">VNĐ</span>
                        </div>
                        @if (paymentAmount > 0)
                        {
                            <div class="d-flex justify-content-between align-items-center mt-1 text-muted" style="font-size: 14.5px;">
                                <span>Bằng chữ số:</span>
                                <span class="fw-bold text-dark">@paymentAmount.ToString("N0") đ</span>
                            </div>
                        }
                    </div>

                    <!-- 3. NGÀY THU TIỀN -->
                    <div class="mb-3.5">
                        <label class="form-label fw-bold text-dark mb-1" style="font-size: 16px;">
                            3. Ngày Thu Tiền <span class="text-danger">*</span>
                        </label>
                        <input type="date" class="form-control" @bind="paymentDate" style="min-height: 44px;" />
                    </div>

                    <!-- 4. GHI CHÚ -->
                    <div class="mb-4">
                        <label class="form-label fw-bold text-dark mb-1" style="font-size: 16px;">
                            4. Ghi Chú / Nội Dung Nộp Tiền
                        </label>
                        <input type="text" class="form-control" placeholder="VD: Khách trả nợ đợt 1 chuyển khoản qua VietQR / ACB..." @bind="note" style="min-height: 44px;" />
                    </div>

                    <!-- NÚT XÁC NHẬN -->
                    <button class="btn btn-primary btn-lg w-100 shadow-sm fw-bold d-flex align-items-center justify-content-center gap-2" 
                            @onclick="RecordPayment" 
                            disabled="@(selectedCustomerId <= 0 || paymentAmount <= 0)"
                            style="min-height: 52px; font-size: 17.5px; border-radius: 12px; background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%) !important; color: #ffffff !important; border: none !important; box-shadow: 0 4px 14px rgba(37, 99, 235, 0.4) !important;">
                        <i class="bi bi-check2-circle fs-5"></i> 
                        <span>Xác Nhận Thu Tiền & Gạch Nợ FIFO</span>
                    </button>
                </div>
            </div>
        </div>

        <!-- CỘT 2: DANH SÁCH HÓA ĐƠN SẼ ĐƯỢC GẠCH NỢ (MÔ PHỎNG FIFO) -->
        <div class="col-12 col-lg-7">
            <div class="card shadow-sm border h-100" style="border-radius: 16px; border-color: #e5eaf1 !important; background: #ffffff;">
                <div class="card-header bg-white border-bottom py-3 px-4 d-flex flex-wrap justify-content-between align-items-center gap-2" style="border-color: #e5eaf1 !important;">
                    <h5 class="card-title mb-0 fw-bold text-dark fs-6 d-flex align-items-center gap-2">
                        <i class="bi bi-list-check text-primary"></i> Hóa Đơn Cần Gạch Nợ (Thứ Tự Ưu Tiên FIFO)
                    </h5>
                    @if (unpaidInvoices != null && unpaidInvoices.Any())
                    {
                        <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle px-2.5 py-1.5" style="font-size: 14.5px; font-weight: 600;">
                            @unpaidInvoices.Count hóa đơn chưa tất toán
                        </span>
                    }
                </div>
                <div class="card-body p-0">
                    @if (selectedCustomerId <= 0)
                    {
                        <div class="p-5 text-center text-muted">
                            <i class="bi bi-person-bounding-box fs-1 text-secondary opacity-50 mb-2 d-block"></i>
                            <h6 class="fw-bold text-dark">Chưa chọn khách hàng</h6>
                            <p class="small text-muted mb-0">Vui lòng chọn khách hàng ở form bên trái để xem mô phỏng gạch nợ FIFO.</p>
                        </div>
                    }
                    else if (unpaidInvoices == null || !unpaidInvoices.Any())
                    {
                        <div class="p-5 text-center text-success">
                            <i class="bi bi-patch-check-fill fs-1 mb-2 d-block text-success"></i>
                            <h5 class="fw-bold text-dark">Khách hàng này hiện không còn nợ!</h5>
                            <p class="text-muted small mb-0">Toàn bộ các hóa đơn đã được thanh toán đầy đủ.</p>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-primary rounded-0 border-start-0 border-end-0 mb-0 py-3 px-4" style="background: linear-gradient(135deg, #eff6ff 0%, #f0fdf4 100%); border-color: #bfdbfe; color: #1e3a8a; font-size: 15.5px;">
                            <i class="bi bi-info-circle-fill me-1 text-primary"></i> 
                            <strong>Luật FIFO:</strong> Tiền thu được ưu tiên trừ dứt điểm từ hóa đơn <strong>cũ nhất (#1)</strong> trước, phần tiền dư tiếp tục gạch cho các hóa đơn tiếp theo.
                        </div>
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th class="text-center" style="width: 100px;">Ưu Tiên</th>
                                        <th style="min-width: 120px;">Số Hóa Đơn</th>
                                        <th style="min-width: 130px;">Ngày HĐ / Hạn</th>
                                        <th class="text-end" style="min-width: 120px;">Tổng HĐ</th>
                                        <th class="text-end" style="min-width: 120px;">Đang Nợ</th>
                                        <th class="text-end" style="min-width: 130px;">Dự Kiến Gạch</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @{
                                        int priority = 1;
                                        decimal remainingSimulatedPayment = paymentAmount;
                                    }
                                    @foreach (var inv in unpaidInvoices)
                                    {
                                        decimal willPay = 0;
                                        if (remainingSimulatedPayment > 0)
                                        {
                                            willPay = Math.Min(remainingSimulatedPayment, inv.Balance);
                                            remainingSimulatedPayment -= willPay;
                                        }
                                        decimal remainingAfterPay = inv.Balance - willPay;

                                        <tr class="@(willPay > 0 ? (remainingAfterPay == 0 ? "table-success bg-opacity-25" : "table-warning bg-opacity-25") : "")">
                                            <td class="text-center">
                                                @if (priority == 1)
                                                {
                                                    <span class="badge bg-danger px-2 py-1" style="font-size: 14.5px;">#1 Cũ Nhất</span>
                                                }
                                                else if (priority == 2)
                                                {
                                                    <span class="badge bg-warning text-dark px-2 py-1" style="font-size: 14.5px;">#2 Tiếp Theo</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-light text-secondary border px-2 py-1" style="font-size: 14.5px;">#@priority</span>
                                                }
                                            </td>
                                            <td>
                                                <span class="fw-bold text-dark">@inv.InvoiceNumber</span>
                                            </td>
                                            <td>
                                                <div class="fw-semibold text-dark" style="font-size: 16px;">@inv.InvoiceDate.ToString("dd/MM/yyyy")</div>
                                                <small class="text-muted" style="font-size: 14.5px;">Hạn: @inv.DueDate.ToString("dd/MM/yyyy")</small>
                                            </td>
                                            <td class="text-end text-muted" style="font-size: 15px; font-variant-numeric: tabular-nums;">
                                                @inv.TotalAmount.ToString("N0") đ
                                            </td>
                                            <td class="text-end text-danger fw-bold" style="font-size: 15px; font-variant-numeric: tabular-nums;">
                                                @inv.Balance.ToString("N0") đ
                                            </td>
                                            <td class="text-end">
                                                @if (willPay > 0)
                                                {
                                                    <span class="badge @(remainingAfterPay == 0 ? "bg-success" : "bg-warning text-dark") px-2.5 py-1" style="font-size: 14.5px;">
                                                        -@willPay.ToString("N0") đ
                                                    </span>
                                                    @if (remainingAfterPay == 0)
                                                    {
                                                        <div class="small text-success fw-bold mt-0.5" style="font-size: 14.5px; font-weight: 600;">(Tất toán)</div>
                                                    }
                                                    else
                                                    {
                                                        <div class="small text-muted mt-0.5" style="font-size: 14.5px; font-weight: 600;">(Còn: @remainingAfterPay.ToString("N0") đ)</div>
                                                    }
                                                }
                                                else
                                                {
                                                    <span class="text-muted" style="font-size: 14.5px;">-</span>
                                                }
                                            </td>
                                        </tr>
                                        priority++;
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
                @if (selectedCustomerId > 0 && unpaidInvoices != null && unpaidInvoices.Any())
                {
                    <div class="card-footer bg-light py-3 px-4 d-flex justify-content-between align-items-center" style="border-top: 1px solid #e5eaf1;">
                        <span class="text-muted fw-semibold" style="font-size: 16px;">Tổng công nợ cần thu tất cả hóa đơn:</span>
                        <span class="fw-bold text-danger fs-5" style="font-variant-numeric: tabular-nums;">@currentDebt.ToString("N0") đ</span>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@code {
    private IEnumerable<Customer>? customers;
    private Customer? selectedCustomer;
    private int selectedCustomerId;
    private decimal currentDebt;
    private List<Invoice>? unpaidInvoices;
    private decimal paymentAmount;
    private DateTime paymentDate = DateTime.Now;
    private string note = "";
    private string errorMessage = "";
    private string successMessage = "";

    protected override async Task OnInitializedAsync()
    {
        customers = await ViewCustomerListUseCase.ExecuteAsync();
    }

    private async Task OnCustomerSelected(ChangeEventArgs e)
    {
        errorMessage = "";
        successMessage = "";
        paymentAmount = 0;
        
        if (int.TryParse(e.Value?.ToString(), out int cId) && cId > 0)
        {
            selectedCustomerId = cId;
            selectedCustomer = customers?.FirstOrDefault(c => c.Id == cId);
            await LoadCustomerInvoicesAsync(cId);
        }
        else
        {
            selectedCustomerId = 0;
            selectedCustomer = null;
            unpaidInvoices = null;
            currentDebt = 0;
        }
    }

    private async Task LoadCustomerInvoicesAsync(int customerId)
    {
        currentDebt = await GetCustomerDebtUseCase.ExecuteAsync(customerId);
        var invoices = await GetUnpaidInvoicesUseCase.ExecuteAsync(customerId);
        unpaidInvoices = invoices.ToList();
    }

    private void FillFullDebt()
    {
        paymentAmount = currentDebt;
    }

    private void FillHalfDebt()
    {
        paymentAmount = Math.Round(currentDebt / 2, 0);
    }

    private async Task RecordPayment()
    {
        errorMessage = "";
        successMessage = "";

        if (selectedCustomerId <= 0)
        {
            errorMessage = "Vui lòng chọn khách hàng.";
            return;
        }

        if (paymentAmount <= 0)
        {
            errorMessage = "Số tiền thu phải lớn hơn 0.";
            return;
        }

        try
        {
            var paymentId = await RecordPaymentUseCase.ExecuteAsync(selectedCustomerId, paymentAmount, paymentDate, note);
            successMessage = $"Thu tiền thành công! Phiếu thu #{paymentId} đã hoàn tất phân bổ gạch nợ theo FIFO.";
            
            var savedCustomerId = selectedCustomerId;
            paymentAmount = 0;
            note = "";
            
            await LoadCustomerInvoicesAsync(savedCustomerId);
        }
        catch (Exception ex)
        {
            errorMessage = $"Lỗi khi ghi nhận phiếu thu: {ex.Message}";
        }
    }
}
