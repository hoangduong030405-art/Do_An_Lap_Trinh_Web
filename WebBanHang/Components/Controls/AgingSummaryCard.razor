@using WebBanHang.UseCases.DTOs

<div class="card mb-3 shadow-sm border-0">
    <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
        <h5 class="mb-0">@Report.CustomerName - @Report.CustomerCode</h5>
        <button class="btn btn-sm btn-light" @onclick="() => OnViewDetails.InvokeAsync(Report.CustomerId)">Chi tiết</button>
    </div>
    <div class="card-body">
        <div class="row text-center mb-2">
            <div class="col-3">
                <div class="p-2 bg-success text-white rounded">
                    <small>0-30 Ngày</small><br />
                    <strong>@Report.Bucket0To30.ToString("N0")</strong>
                </div>
            </div>
            <div class="col-3">
                <div class="p-2 bg-warning text-dark rounded">
                    <small>31-60 Ngày</small><br />
                    <strong>@Report.Bucket31To60.ToString("N0")</strong>
                </div>
            </div>
            <div class="col-3">
                <div class="p-2 text-white rounded" style="background-color: #fd7e14;">
                    <small>61-90 Ngày</small><br />
                    <strong>@Report.Bucket61To90.ToString("N0")</strong>
                </div>
            </div>
            <div class="col-3">
                <div class="p-2 bg-danger text-white rounded">
                    <small>>90 Ngày</small><br />
                    <strong>@Report.BucketOver90.ToString("N0")</strong>
                </div>
            </div>
        </div>
        <div class="d-flex justify-content-between align-items-center mt-3">
            <h6 class="mb-0">Tổng Nợ: <strong>@Report.TotalOutstandingDebt.ToString("N0") đ</strong></h6>
            @if (Report.IsIntegrityValid)
            {
                <span class="text-success small fw-bold"><i class="bi bi-check-circle-fill"></i> Đối soát toàn vẹn (Tổng 4 xô khớp 100% tổng nợ)</span>
            }
            else
            {
                <span class="text-danger small fw-bold"><i class="bi bi-x-circle-fill"></i> Lỗi đối soát dữ liệu!</span>
            }
        </div>
    </div>
</div>

@code {
    [Parameter]
    public CustomerAgingReportDto Report { get; set; } = default!;

    [Parameter]
    public EventCallback<int> OnViewDetails { get; set; }
}
