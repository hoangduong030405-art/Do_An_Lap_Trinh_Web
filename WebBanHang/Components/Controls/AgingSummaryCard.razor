@using WebBanHang.UseCases.DTOs

<div class="card mb-4 shadow-sm border" style="border-radius: 16px; border-color: #cbd5e1 !important; background-color: #ffffff !important; overflow: hidden; box-shadow: 0 4px 12px -2px rgba(15, 23, 42, 0.08), 0 2px 4px rgba(15, 23, 42, 0.04) !important;">
    <div class="card-header bg-white border-bottom py-3.5 px-4 d-flex justify-content-between align-items-center" style="border-color: #e2e8f0 !important;">
        <div class="d-flex align-items-center gap-2.5">
            <h5 class="mb-0 fw-bold text-dark" style="font-size: 22px; letter-spacing: -0.01em;">@Report.CustomerName</h5>
            <span class="badge border px-2.5 py-1" style="font-size: 15px; font-weight: 700; background-color: #dbeafe; color: #1e40af; border-color: #93c5fd !important;">@Report.CustomerCode</span>
        </div>
        <button class="btn btn-sm shadow-xs py-1.5 px-3.5 d-flex align-items-center gap-1.5" 
                style="font-size: 15px; font-weight: 700; min-height: 40px; background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%); color: #ffffff; border: none; border-radius: 10px; box-shadow: 0 2px 6px rgba(37, 99, 235, 0.3);" 
                @onclick="() => OnViewDetails.InvokeAsync(Report.CustomerId)">
            <i class="bi bi-eye"></i> Chi tiết
        </button>
    </div>
    <div class="card-body p-4" style="background-color: #ffffff !important;">
        <div class="row text-center mb-2 g-2.5">
            <!-- Xô 0: Chưa đến hạn -->
            <div class="col">
                <div class="p-3 rounded-3 border" style="background: linear-gradient(180deg, #f8fafc 0%, #ffffff 70%); border-color: #cbd5e1 !important; border-top: 4px solid #64748b !important;">
                    <div style="font-size: 15.5px; font-weight: 700; color: #475569; margin-bottom: 4px;">Chưa Đến Hạn</div>
                    <div style="font-size: 22px; font-weight: 800; color: #0f172a; font-feature-settings: 'tnum' 1; font-variant-numeric: tabular-nums;">
                        @Report.BucketNotDue.ToString("N0")
                    </div>
                </div>
            </div>

            <!-- Xô 1: 1-30 Ngày -->
            <div class="col">
                <div class="p-3 rounded-3 border" style="background: linear-gradient(180deg, #ecfdf5 0%, #ffffff 70%); border-color: #a7f3d0 !important; border-top: 4px solid #059669 !important;">
                    <div style="font-size: 15.5px; font-weight: 700; color: #047857; margin-bottom: 4px;">1-30 Ngày</div>
                    <div style="font-size: 22px; font-weight: 800; color: #047857; font-feature-settings: 'tnum' 1; font-variant-numeric: tabular-nums;">
                        @Report.Bucket1To30.ToString("N0")
                    </div>
                </div>
            </div>

            <!-- Xô 2: 31-60 Ngày -->
            <div class="col">
                <div class="p-3 rounded-3 border" style="background: linear-gradient(180deg, #fffbeb 0%, #ffffff 70%); border-color: #fde68a !important; border-top: 4px solid #d97706 !important;">
                    <div style="font-size: 15.5px; font-weight: 700; color: #b45309; margin-bottom: 4px;">31-60 Ngày</div>
                    <div style="font-size: 22px; font-weight: 800; color: #b45309; font-feature-settings: 'tnum' 1; font-variant-numeric: tabular-nums;">
                        @Report.Bucket31To60.ToString("N0")
                    </div>
                </div>
            </div>

            <!-- Xô 3: 61-90 Ngày -->
            <div class="col">
                <div class="p-3 rounded-3 border" style="background: linear-gradient(180deg, #fff7ed 0%, #ffffff 70%); border-color: #fed7aa !important; border-top: 4px solid #ea580c !important;">
                    <div style="font-size: 15.5px; font-weight: 700; color: #ea580c; margin-bottom: 4px;">61-90 Ngày</div>
                    <div style="font-size: 22px; font-weight: 800; color: #c2410c; font-feature-settings: 'tnum' 1; font-variant-numeric: tabular-nums;">
                        @Report.Bucket61To90.ToString("N0")
                    </div>
                </div>
            </div>

            <!-- Xô 4: >90 Ngày -->
            <div class="col">
                <div class="p-3 rounded-3 border" style="background: linear-gradient(180deg, #fef2f2 0%, #ffffff 70%); border-color: #fecaca !important; border-top: 4px solid #dc2626 !important;">
                    <div style="font-size: 15.5px; font-weight: 700; color: #dc2626; margin-bottom: 4px;">>90 Ngày</div>
                    <div style="font-size: 22px; font-weight: 800; color: #dc2626; font-feature-settings: 'tnum' 1; font-variant-numeric: tabular-nums;">
                        @Report.BucketOver90.ToString("N0")
                    </div>
                </div>
            </div>
        </div>

        <div class="d-flex justify-content-between align-items-center mt-3.5 pt-3 border-top" style="border-color: #e2e8f0 !important;">
            <div class="d-flex align-items-baseline gap-2">
                <span class="text-secondary" style="font-size: 17px; font-weight: 700;">Tổng Nợ:</span>
                <span class="fw-bold text-dark" style="font-size: 26px; font-feature-settings: 'tnum' 1; font-variant-numeric: tabular-nums;">
                    @Report.TotalOutstandingDebt.ToString("N0") đ
                </span>
            </div>
            @if (Report.IsIntegrityValid)
            {
                <span class="fw-bold d-inline-flex align-items-center gap-1.5 px-3.5 py-1.5 rounded-pill" 
                      style="font-size: 15.5px; background-color: #d1fae5; color: #065f46; border: 1.5px solid #6ee7b7; box-shadow: 0 1px 3px rgba(5, 150, 105, 0.15);">
                    <i class="bi bi-check-circle-fill fs-6"></i> Đối soát toàn vẹn (Tổng các nhóm khớp 100%)
                </span>
            }
            else
            {
                <span class="fw-bold d-inline-flex align-items-center gap-1.5 px-3.5 py-1.5 rounded-pill" 
                      style="font-size: 15.5px; background-color: #fee2e2; color: #991b1b; border: 1.5px solid #fca5a5; box-shadow: 0 1px 3px rgba(220, 38, 38, 0.15);">
                    <i class="bi bi-exclamation-triangle-fill fs-6"></i> CẢNH BÁO: Lệch đối soát dữ liệu!
                </span>
            }
        </div>
    </div>
</div>

@code {
    [Parameter]
    public CustomerAgingReportDto Report { get; set; } = default!;

    [Parameter]
    public EventCallback<int> OnViewDetails { get; set; }
}
