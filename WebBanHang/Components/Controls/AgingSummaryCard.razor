@using WebBanHang.UseCases.DTOs

<div class="card mb-3 shadow-sm border" style="border-radius: 16px; border-color: #e5eaf1 !important; background-color: #ffffff !important; overflow: hidden;">
    <div class="card-header bg-white border-bottom py-3 px-3.5 d-flex justify-content-between align-items-center" style="border-color: #e5eaf1 !important;">
        <div class="d-flex align-items-center gap-2">
            <h6 class="mb-0 fw-bold text-dark fs-5">@Report.CustomerName</h6>
            <span class="badge bg-light text-primary border px-2 py-1" style="font-size: 15px; font-weight: 700;">@Report.CustomerCode</span>
        </div>
        <button class="btn btn-sm btn-outline-primary" @onclick="() => OnViewDetails.InvokeAsync(Report.CustomerId)">
            <i class="bi bi-eye me-1"></i> Chi tiết
        </button>
    </div>
    <div class="card-body p-3.5" style="background-color: #ffffff !important;">
        <div class="row text-center mb-2 g-2">
            <!-- Xô 0: Chưa đến hạn -->
            <div class="col">
                <div class="p-2.5 rounded-3 border" style="background-color: #f8fafc; border-color: #e2e8f0 !important; color: #334155;">
                    <div style="font-size: 15px; font-weight: 700; color: #64748b; margin-bottom: 2px;">Chưa Đến Hạn</div>
                    <div style="font-size: 17px; font-weight: 800; color: #0f172a; font-feature-settings: 'tnum' 1; font-variant-numeric: tabular-nums;">
                        @Report.BucketNotDue.ToString("N0")
                    </div>
                </div>
            </div>

            <!-- Xô 1: 1-30 Ngày -->
            <div class="col">
                <div class="p-2.5 rounded-3 border" style="background-color: #ecfdf5; border-color: #a7f3d0 !important; color: #065f46;">
                    <div style="font-size: 15px; font-weight: 700; color: #047857; margin-bottom: 2px;">1-30 Ngày</div>
                    <div style="font-size: 17px; font-weight: 800; color: #065f46; font-feature-settings: 'tnum' 1; font-variant-numeric: tabular-nums;">
                        @Report.Bucket1To30.ToString("N0")
                    </div>
                </div>
            </div>

            <!-- Xô 2: 31-60 Ngày -->
            <div class="col">
                <div class="p-2.5 rounded-3 border" style="background-color: #fffbeb; border-color: #fde68a !important; color: #92400e;">
                    <div style="font-size: 15px; font-weight: 700; color: #b45309; margin-bottom: 2px;">31-60 Ngày</div>
                    <div style="font-size: 17px; font-weight: 800; color: #92400e; font-feature-settings: 'tnum' 1; font-variant-numeric: tabular-nums;">
                        @Report.Bucket31To60.ToString("N0")
                    </div>
                </div>
            </div>

            <!-- Xô 3: 61-90 Ngày -->
            <div class="col">
                <div class="p-2.5 rounded-3 border" style="background-color: #fff7ed; border-color: #fed7aa !important; color: #c2410c;">
                    <div style="font-size: 15px; font-weight: 700; color: #ea580c; margin-bottom: 2px;">61-90 Ngày</div>
                    <div style="font-size: 17px; font-weight: 800; color: #c2410c; font-feature-settings: 'tnum' 1; font-variant-numeric: tabular-nums;">
                        @Report.Bucket61To90.ToString("N0")
                    </div>
                </div>
            </div>

            <!-- Xô 4: >90 Ngày -->
            <div class="col">
                <div class="p-2.5 rounded-3 border" style="background-color: #fef2f2; border-color: #fecaca !important; color: #991b1b;">
                    <div style="font-size: 15px; font-weight: 700; color: #dc2626; margin-bottom: 2px;">>90 Ngày</div>
                    <div style="font-size: 17px; font-weight: 800; color: #991b1b; font-feature-settings: 'tnum' 1; font-variant-numeric: tabular-nums;">
                        @Report.BucketOver90.ToString("N0")
                    </div>
                </div>
            </div>
        </div>

        <div class="d-flex justify-content-between align-items-center mt-3 pt-2 border-top" style="border-color: #f1f5f9 !important;">
            <div class="d-flex align-items-baseline gap-1.5">
                <span class="text-secondary" style="font-size: 15px; font-weight: 500;">Tổng Nợ:</span>
                <span class="fw-bold text-dark fs-5" style="font-feature-settings: 'tnum' 1; font-variant-numeric: tabular-nums;">
                    @Report.TotalOutstandingDebt.ToString("N0") đ
                </span>
            </div>
            @if (Report.IsIntegrityValid)
            {
                <span class="text-success small fw-semibold d-inline-flex align-items-center gap-1" style="font-size: 15px;">
                    <i class="bi bi-check-circle-fill"></i> Đối soát toàn vẹn (Tổng các nhóm khớp 100%)
                </span>
            }
            else
            {
                <span class="text-danger small fw-bold d-inline-flex align-items-center gap-1" style="font-size: 15px;">
                    <i class="bi bi-exclamation-triangle-fill"></i> CẢNH BÁO: Lệch đối soát dữ liệu!
                </span>
            }
        </div>
    </div>
</div>

@code {
    [Parameter]
    public CustomerAgingReportDto Report { get; set; } = default!;

    [Parameter]
    public EventCallback<int> OnViewDetails { get; set; }
}
