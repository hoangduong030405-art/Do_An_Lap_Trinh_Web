@using WebBanHang.UseCases.DTOs

<div class="card border-0 shadow-sm rounded-3 mb-4 overflow-hidden credit-status-card">
    <div class="card-header bg-navy text-white py-3 px-4 d-flex flex-wrap justify-content-between align-items-center gap-2">
        <div class="d-flex align-items-center gap-3">
            <div class="portal-badge-icon bg-blue text-white rounded-circle d-flex align-items-center justify-content-center shadow-sm">
                <i class="bi bi-building-check fs-5"></i>
            </div>
            <div>
                <div class="d-flex align-items-center gap-2">
                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle fw-semibold px-2 py-1">ĐẠI LÝ B2B</span>
                    <h5 class="fw-bold mb-0 text-white">@(CustomerInfo?.FullName ?? "Đại Lý Đối Tác")</h5>
                </div>
                <small class="text-slate-light opacity-80">Mã ĐL: <strong>@(CustomerInfo?.CustomerCode ?? "KH001")</strong> • Hotline: @(CustomerInfo?.PhoneNumber ?? "0905 123 456") • @(CustomerInfo?.Address ?? "")</small>
            </div>
        </div>
        <div class="d-flex align-items-center gap-2">
            @if (CustomerInfo != null && CustomerInfo.IsCreditLimitReached)
            {
                <span class="badge bg-danger text-white px-3 py-2 rounded-pill shadow-sm d-flex align-items-center gap-1">
                    <i class="bi bi-exclamation-triangle-fill"></i> ĐÃ CHẠM TRẦN HẠN MỨC
                </span>
            }
            else
            {
                <span class="badge bg-success text-white px-3 py-2 rounded-pill shadow-sm d-flex align-items-center gap-1">
                    <i class="bi bi-shield-fill-check"></i> TÍN DỤNG KHẢ DỤNG TỐT
                </span>
            }
        </div>
    </div>
    <div class="card-body bg-white p-4">
        <div class="row g-3 align-items-center">
            <!-- 1. Hạn mức tín dụng -->
            <div class="col-12 col-sm-6 col-lg-3">
                <div class="p-3 rounded-3 bg-light border stat-box h-100">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="text-muted small text-uppercase fw-semibold">Hạn Mức Được Cấp</span>
                        <i class="bi bi-bank text-primary fs-5"></i>
                    </div>
                    <div class="fs-4 fw-bold text-dark">
                        @(CustomerInfo != null ? CustomerInfo.CreditLimit.ToString("N0") : "0") <span class="fs-6 fw-normal text-muted">đ</span>
                    </div>
                    <small class="text-muted">Chính sách bảo lãnh mua sỉ</small>
                </div>
            </div>

            <!-- 2. Dư nợ hiện hành -->
            <div class="col-12 col-sm-6 col-lg-3">
                <div class="p-3 rounded-3 bg-light border stat-box h-100">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="text-muted small text-uppercase fw-semibold">Dư Nợ Hiện Hành</span>
                        <i class="bi bi-receipt text-warning fs-5"></i>
                    </div>
                    <div class="fs-4 fw-bold @(CustomerInfo != null && CustomerInfo.CurrentDebt > 0 ? "text-danger" : "text-dark")">
                        @(CustomerInfo != null ? CustomerInfo.CurrentDebt.ToString("N0") : "0") <span class="fs-6 fw-normal text-muted">đ</span>
                    </div>
                    <small class="text-muted">Gồm @(CustomerInfo?.UnpaidInvoicesCount ?? 0) hóa đơn chưa thu</small>
                </div>
            </div>

            <!-- 3. Hạn mức khả dụng để mua tiếp (HIGHLIGHT) -->
            <div class="col-12 col-sm-6 col-lg-3">
                <div class="p-3 rounded-3 border stat-box h-100 @(CustomerInfo != null && CustomerInfo.IsCreditLimitReached ? "bg-danger-subtle border-danger" : "bg-success-subtle border-success")">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="small text-uppercase fw-bold @(CustomerInfo != null && CustomerInfo.IsCreditLimitReached ? "text-danger" : "text-success")">
                            HẠN MỨC KHẢ DỤNG MUA TIẾP
                        </span>
                        <i class="bi @(CustomerInfo != null && CustomerInfo.IsCreditLimitReached ? "bi-x-circle-fill text-danger" : "bi-check-circle-fill text-success") fs-5"></i>
                    </div>
                    <div class="fs-4 fw-bold @(CustomerInfo != null && CustomerInfo.IsCreditLimitReached ? "text-danger" : "text-success")">
                        @(CustomerInfo != null ? CustomerInfo.AvailableCredit.ToString("N0") : "0") <span class="fs-6 fw-normal text-muted">đ</span>
                    </div>
                    <small class="fw-semibold @(CustomerInfo != null && CustomerInfo.IsCreditLimitReached ? "text-danger" : "text-success")">
                        @(CustomerInfo != null && CustomerInfo.IsCreditLimitReached ? "Không thể ghi nợ thêm" : "Đủ điều kiện xuất hàng ngay")
                    </small>
                </div>
            </div>

            <!-- 4. Thời hạn thanh toán -->
            <div class="col-12 col-sm-6 col-lg-3">
                <div class="p-3 rounded-3 bg-light border stat-box h-100">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="text-muted small text-uppercase fw-semibold">Thời Hạn Thanh Toán</span>
                        <i class="bi bi-clock-history text-info fs-5"></i>
                    </div>
                    <div class="fs-4 fw-bold text-dark">
                        @(CustomerInfo != null ? CustomerInfo.PaymentTermsDays : 30) <span class="fs-6 fw-normal text-muted">ngày</span>
                    </div>
                    <small class="text-muted">Kể từ ngày ký nhận xuất kho</small>
                </div>
            </div>
        </div>

        @if (CustomerInfo != null)
        {
            <!-- Progress Bar Tỷ Lệ Sử Dụng Hạn Mức -->
            <div class="mt-3 pt-2 border-top">
                <div class="d-flex justify-content-between align-items-center mb-1 small">
                    <span class="text-muted">Tỷ lệ tín dụng đã sử dụng: <strong class="text-dark">@CustomerInfo.CreditUtilizationPercent%</strong></span>
                    <span class="text-muted">Hạn mức còn lại: <strong class="text-success">@CustomerInfo.AvailableCredit.ToString("N0") đ</strong></span>
                </div>
                <div class="progress" style="height: 8px;">
                    <div class="progress-bar @(CustomerInfo.CreditUtilizationPercent >= 90 ? "bg-danger" : CustomerInfo.CreditUtilizationPercent >= 70 ? "bg-warning" : "bg-primary")"
                         role="progressbar"
                         style="width: @CustomerInfo.CreditUtilizationPercent%;"
                         aria-valuenow="@CustomerInfo.CreditUtilizationPercent"
                         aria-valuemin="0"
                         aria-valuemax="100">
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@code {
    [Parameter]
    public CustomerPortalInfoDto? CustomerInfo { get; set; }
}
