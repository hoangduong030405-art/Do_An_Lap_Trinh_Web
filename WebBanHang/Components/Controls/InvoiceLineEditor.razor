@using WebBanHang.Services
@using WebBanHang.Components.Controls

@if (Items != null && Items.Any())
{
    <div class="table-responsive rounded-3 border" style="border-color: #e5eaf1 !important; background: #ffffff;">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th style="min-width: 90px;">Mã SP</th>
                    <th style="min-width: 200px;">Tên Hàng Hóa</th>
                    <th class="text-center" style="min-width: 70px;">ĐVT</th>
                    <th class="text-end" style="min-width: 120px;">Giá Nhập (Vốn)</th>
                    <th class="text-end" style="min-width: 130px;">Giá Bán Sỉ</th>
                    <th class="text-center" style="min-width: 130px;">Số Lượng</th>
                    <th class="text-end" style="min-width: 140px;">Thành Tiền Bán</th>
                    <th class="text-end" style="min-width: 140px;">Lãi Gộp Dòng</th>
                    <th class="text-center" style="width: 60px;">Xóa</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Items)
                {
                    <tr>
                        <td>
                            <span class="badge bg-light text-secondary border font-monospace px-2 py-1" style="font-size: 13px;">@item.ProductCode</span>
                        </td>
                        <td>
                            <div class="fw-bold text-dark">@item.ProductName</div>
                        </td>
                        <td class="text-center text-secondary" style="font-size: 14px;">@item.Unit</td>
                        <td class="text-end text-muted" style="font-size: 14px; font-variant-numeric: tabular-nums;">
                            @item.CostPrice.ToString("N0") đ
                        </td>
                        <td class="text-end fw-bold text-primary" style="font-size: 14px; font-variant-numeric: tabular-nums;">
                            @item.UnitPrice.ToString("N0") đ
                        </td>
                        <td class="text-center">
                            <div class="btn-group btn-group-sm border rounded-pill overflow-hidden shadow-xs" style="background: #f8fafc;">
                                <button type="button" class="btn btn-light px-2.5 fw-bold" @onclick="() => OnDecrement.InvokeAsync(item.ProductId)" title="Giảm 1">-</button>
                                <span class="btn btn-white disabled px-3 fw-bold text-dark border-start border-end" style="min-width: 44px; opacity: 1;">@item.Quantity</span>
                                <button type="button" class="btn btn-light px-2.5 fw-bold" @onclick="() => OnIncrement.InvokeAsync(item.ProductId)" title="Tăng 1">+</button>
                            </div>
                        </td>
                        <td class="text-end fw-bold text-dark" style="font-size: 15px; font-variant-numeric: tabular-nums;">
                            @item.LineTotal.ToString("N0") đ
                        </td>
                        <td class="text-end">
                            <span class="badge @(item.LineProfit >= 0 ? "bg-success-subtle text-success border border-success-subtle" : "bg-danger-subtle text-danger border border-danger-subtle") px-2 py-1" style="font-size: 13px;">
                                +@item.LineProfit.ToString("N0") đ (@item.ProfitMargin%)
                            </span>
                        </td>
                        <td class="text-center">
                            <button type="button" class="btn btn-sm btn-outline-danger border-0 rounded-circle" @onclick="() => OnRemove.InvokeAsync(item.ProductId)" title="Xóa dòng mặt hàng">
                                <i class="bi bi-trash fs-6"></i>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="card p-4 text-center border shadow-xs bg-white" style="border-radius: 14px; border-color: #e5eaf1 !important; border-style: dashed !important;">
        <div class="py-3">
            <i class="bi bi-cart-x text-muted" style="font-size: 2.5rem;"></i>
            <h6 class="fw-bold text-dark mt-2 mb-1">Chưa có sản phẩm nào trong hóa đơn nháp</h6>
            <p class="text-muted small mb-0">Vui lòng chọn khách hàng và bấm "+ Thêm" sản phẩm từ danh mục khả dụng bên dưới.</p>
        </div>
    </div>
}

@code {
    [Parameter]
    public List<DraftInvoiceItem> Items { get; set; } = new();

    [Parameter]
    public EventCallback<int> OnIncrement { get; set; }

    [Parameter]
    public EventCallback<int> OnDecrement { get; set; }

    [Parameter]
    public EventCallback<int> OnRemove { get; set; }
}
