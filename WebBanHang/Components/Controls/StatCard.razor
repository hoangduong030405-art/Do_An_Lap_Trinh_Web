@namespace WebBanHang.Components.Controls

<div class="app-stat-card @(Tone != null ? $"tone-{Tone}" : "") @(OnClick.HasDelegate ? "card-interactive" : "")" 
     @onclick="HandleClick">
    @if (IsLoading)
    {
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div class="skeleton" style="width: 100px; height: 16px;"></div>
            <div class="skeleton" style="width: 40px; height: 40px; border-radius: 12px;"></div>
        </div>
        <div class="skeleton mb-2" style="width: 140px; height: 36px;"></div>
        <div class="skeleton" style="width: 90px; height: 14px;"></div>
    }
    else
    {
        <div class="d-flex align-items-center justify-content-between mb-2">
            <span class="app-stat-label">@Label</span>
            @if (!string.IsNullOrEmpty(Icon))
            {
                <div class="app-stat-icon" aria-hidden="true">
                    <i class="bi @Icon"></i>
                </div>
            }
        </div>
        <div class="app-stat-value">
            @Value
            @if (!string.IsNullOrEmpty(Unit))
            {
                <span class="app-stat-unit">@Unit</span>
            }
        </div>
        @if (!string.IsNullOrEmpty(Trend) || !string.IsNullOrEmpty(Hint) || Footer != null)
        {
            <div class="app-stat-footer d-flex align-items-center justify-content-between pt-2 mt-2">
                @if (!string.IsNullOrEmpty(Trend))
                {
                    <span class="app-stat-trend @GetTrendClass()">
                        <i class="bi @GetTrendIcon() me-1"></i>
                        @Trend
                    </span>
                }
                @if (!string.IsNullOrEmpty(Hint))
                {
                    <span class="app-stat-hint text-truncate" title="@Hint">@Hint</span>
                }
                @if (Footer != null)
                {
                    @Footer
                }
            </div>
        }
    }
</div>

@code {
    [Parameter] public string Label { get; set; } = "";
    [Parameter] public string Value { get; set; } = "";
    [Parameter] public string? Unit { get; set; }
    [Parameter] public string? Hint { get; set; }
    [Parameter] public string? Trend { get; set; }
    [Parameter] public string? Tone { get; set; } // "primary", "success", "warning", "danger", "info", "neutral"
    [Parameter] public string? Icon { get; set; }
    [Parameter] public bool IsLoading { get; set; } = false;
    [Parameter] public EventCallback OnClick { get; set; }
    [Parameter] public RenderFragment? Footer { get; set; }

    private string GetTrendClass()
    {
        if (string.IsNullOrEmpty(Trend)) return "trend-neutral";
        if (Trend.StartsWith("+") || Trend.Contains("↑") || Trend.ToLower().Contains("tốt")) return "trend-up";
        if (Trend.StartsWith("-") || Trend.Contains("↓") || Trend.ToLower().Contains("giảm")) return "trend-down";
        return "trend-neutral";
    }

    private string GetTrendIcon()
    {
        if (string.IsNullOrEmpty(Trend)) return "bi-dash";
        if (Trend.StartsWith("+") || Trend.Contains("↑") || Trend.ToLower().Contains("tốt")) return "bi-arrow-up-right";
        if (Trend.StartsWith("-") || Trend.Contains("↓") || Trend.ToLower().Contains("giảm")) return "bi-arrow-down-right";
        return "bi-dash";
    }

    private async Task HandleClick()
    {
        if (OnClick.HasDelegate)
        {
            await OnClick.InvokeAsync();
        }
    }
}
